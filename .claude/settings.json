{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check *)",
      "Bash(pnpm format *)",
      "Bash(shellcheck *)",
      "Bash(bash -n *)",
      "Bash(zsh -n *)",
      "Bash(bash vscode/test-vscode-settings.sh)",
      "Bash(.claude/hooks/test-lint-edited.sh *)",
      "Bash(.claude/hooks/test-lint-bash-edits.sh *)",
      "Bash(.claude/hooks/test-commit-gate.sh *)",
      "Bash(.claude/hooks/test-auditor-readonly.sh *)"
    ],
    "ask": [
      "Bash(./setup.sh *)",
      "Bash(./setup/*)",
      "Bash(setup.sh *)",
      "Bash(setup/*)",
      "Bash(bash ./setup*)",
      "Bash(bash setup*)",
      "Bash(sh ./setup*)",
      "Bash(sh setup*)",
      "Bash(*/dotfiles/setup.sh*)",
      "Bash(*/dotfiles/setup/*)",
      "Bash(set-defaults *)",
      "Bash(upup *)",
      "Bash(bin/set-defaults*)",
      "Bash(bin/upup*)",
      "Bash(./bin/set-defaults*)",
      "Bash(./bin/upup*)",
      "Bash(*/bin/set-defaults*)",
      "Bash(*/bin/upup*)"
    ],
    "deny": [
      "Edit(/obsidian/.obsidian/plugins/**)",
      "Edit(/tilde/.config/gh/hosts.yml)",
      "Read(/vscode/User/History/**)",
      "Read(/vscode/User/workspaceStorage/**)",
      "Read(/vscode/User/globalStorage/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/commit-gate.sh",
            "args": [],
            "timeout": 180,
            "onFailure": "block",
            "statusMessage": "Running pnpm check before the commit"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/auditor-readonly.sh",
            "args": [],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking the auditor's command is read-only"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|mcp__serena__(replace_content|replace_in_files|replace_symbol_body|insert_after_symbol|insert_before_symbol|rename_symbol|safe_delete_symbol))$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-edited.sh",
            "args": [],
            "timeout": 60,
            "statusMessage": "Formatting and linting the edited file"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-bash-edits.sh",
            "args": [],
            "timeout": 60,
            "statusMessage": "Linting files the command wrote"
          }
        ]
      }
    ]
  }
}
