{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm check *)",
      "Bash(pnpm format *)",
      "Bash(shellcheck *)",
      "Bash(bash -n *)",
      "Bash(zsh -n *)",
      "Bash(bash vscode/test-vscode-settings.sh)",
      "Bash(.claude/hooks/test-lint-edited.sh *)",
      "Bash(.claude/hooks/test-lint-bash-edits.sh *)",
      "Bash(.claude/hooks/test-commit-gate.sh *)",
      "Bash(.claude/hooks/test-auditor-readonly.sh *)",
      "Bash(help *)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh run watch *)",
      "Bash(mise --version)",
      "Bash(mise ls *)",
      "Bash(mise where *)",
      "Bash(mise env *)",
      "Bash(mise doctor)",
      "Bash(mise dot status *)",
      "Bash(defaults read *)",
      "Bash(defaults read-type *)",
      "Bash(brew info *)",
      "Bash(brew list *)",
      "Bash(codex doctor)",
      "Bash(codex features list)",
      "Bash(actionlint .github/workflows/check.yml)",
      "Bash(actionlint .github/workflows/fresh-install.yml)",
      "Bash(uv run --quiet --locked --project settings python settings/tests/*)",
      "Bash(uv run --project settings python settings/tests/*)",
      "Bash(uv run --project settings dotfiles-settings list *)",
      "Bash(bash bin/lib/test-bin)",
      "Bash(bash bin/lib/test-bootstrap)",
      "Bash(bash bin/lib/test-ca-roots)",
      "Bash(bash bin/lib/test-claude-config)",
      "Bash(bash bin/lib/test-conventions)",
      "Bash(bash bin/lib/test-dotfiles)",
      "Bash(bash bin/lib/test-hindsight-memory)",
      "Bash(bash bin/lib/test-migrate)",
      "Bash(bash bin/lib/test-override-env)",
      "Bash(bash bin/lib/test-packages)",
      "Bash(bash bin/lib/test-rea-mcp)",
      "Bash(bash bin/lib/test-shell)",
      "Bash(bash bin/lib/test-sysup)"
    ],
    "ask": [
      "Bash(./setup.sh *)",
      "Bash(./setup/*)",
      "Bash(setup.sh *)",
      "Bash(setup/*)",
      "Bash(bash ./setup*)",
      "Bash(bash setup*)",
      "Bash(sh ./setup*)",
      "Bash(sh setup*)",
      "Bash(*/dotfiles/setup.sh*)",
      "Bash(*/dotfiles/setup/*)",
      "Bash(set-defaults *)",
      "Bash(sysup *)",
      "Bash(bash bin/set-defaults*)",
      "Bash(sh bin/set-defaults*)",
      "Bash(bin/set-defaults*)",
      "Bash(bash bin/sysup*)",
      "Bash(sh bin/sysup*)",
      "Bash(bin/sysup*)",
      "Bash(./bin/set-defaults*)",
      "Bash(./bin/sysup*)",
      "Bash(*/bin/set-defaults*)",
      "Bash(*/bin/sysup*)",
      "Bash(mise bootstrap*)",
      "Bash(mise dot *apply*)",
      "Bash(mise dotfiles *apply*)",
      "Bash(mise install*)",
      "Bash(mise self-update*)",
      "Bash(mise plugins link*)",
      "Bash(dotfiles-settings set *)",
      "Bash(bin/dotfiles-settings set*)",
      "Bash(./bin/dotfiles-settings set*)",
      "Bash(*/bin/dotfiles-settings set*)",
      "Bash(bash bin/dotfiles-settings set*)",
      "Bash(sh bin/dotfiles-settings set*)",
      "Bash(dotfiles-settings reset *)",
      "Bash(bin/dotfiles-settings reset*)",
      "Bash(./bin/dotfiles-settings reset*)",
      "Bash(*/bin/dotfiles-settings reset*)",
      "Bash(bash bin/dotfiles-settings reset*)",
      "Bash(sh bin/dotfiles-settings reset*)",
      "Bash(dotfiles-settings apply *)",
      "Bash(bin/dotfiles-settings apply*)",
      "Bash(./bin/dotfiles-settings apply*)",
      "Bash(*/bin/dotfiles-settings apply*)",
      "Bash(bash bin/dotfiles-settings apply*)",
      "Bash(sh bin/dotfiles-settings apply*)",
      "Bash(migrate/legacy-to-mise*)",
      "Bash(./migrate/legacy-to-mise*)",
      "Bash(*/migrate/legacy-to-mise*)",
      "Bash(bash migrate/legacy-to-mise*)",
      "Bash(sh migrate/legacy-to-mise*)"
    ],
    "deny": [
      "Edit(/obsidian/.obsidian/plugins/**)",
      "Edit(/tilde/.config/gh/hosts.yml)",
      "Read(/vscode/User/History/**)",
      "Read(/vscode/User/workspaceStorage/**)",
      "Read(/vscode/User/globalStorage/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*commit*)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/commit-gate.sh",
            "args": [],
            "timeout": 180,
            "onFailure": "block",
            "statusMessage": "Running pnpm check before the commit"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/auditor-readonly.sh",
            "args": [],
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking the auditor's command is read-only"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(Edit|Write|mcp__serena__(replace_content|replace_in_files|replace_symbol_body|insert_after_symbol|insert_before_symbol|rename_symbol|safe_delete_symbol))$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-edited.sh",
            "args": [],
            "timeout": 60,
            "statusMessage": "Formatting and linting the edited file"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/lint-bash-edits.sh",
            "args": [],
            "timeout": 60,
            "statusMessage": "Linting files the command wrote"
          }
        ]
      }
    ]
  }
}
