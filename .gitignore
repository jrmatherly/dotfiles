node_modules/
# Per-machine Claude Code permission grants
.claude/settings.local.json
# Left behind when a bin/claude-config save write is interrupted
agents/*.tmp
.DS_Store
Thumbs.db
vscode/**/workspaceStorage/
vscode/**/syncLocalSettings.json
vscode/**/globalStorage/
vscode/**/History/
# Written by VS Code for the Claude Code extension's agent-sessions window (empty folder list, referenced from workspaceStorage)
vscode/User/*.code-workspace
# VS Code Settings Sync's local cache (snapshots of synced state, not config)
vscode/**/sync/
# VS Code profiles (per-machine; the Default profile is vscode/User itself)
vscode/**/profiles/
lazygit/state.yml
# Written by hunk itself (the last CLI version it saw), not config
tilde/.config/hunk/state.json
# mise's machine-local files (overrides from the settings UI, local config):
# ~/.config/mise links here, so mise writes them inside the clone
tilde/.config/mise/config.override.toml
tilde/.config/mise/config.*.override.toml
tilde/.config/mise/config.local.toml
tilde/.config/mise/config.*.local.toml
tilde/.config/mise/miserc.local.toml
# The modules this Mac switched off (bin/lib/rotm-modules): a tracked copy would switch them off for everyone
tilde/.config/mise/modules-off.local
tilde/.config/mise/modules-off.*.local
.tlrc/
private/
# sysup's per-run logs (bin/sysup); setup.sh logs under private/setup-logs/
logs/
# A Mac's own Mole whitelist, linked instead of the shared one (a config.local.toml entry, docs/mole.md)
mole/*.local
tilde/.ssh/*
!tilde/.ssh/config
tilde/.config/amp/settings.json.amp-write-meta
# Written by `gh auth login`; can contain an OAuth token
tilde/.config/gh/hosts.yml

# Obsidian
obsidian/**/workspace.json
obsidian/**/workspace-mobile.json

# CodeGraph index (per machine; `codegraph index` rebuilds it — codegraph.json is the shared config)
.codegraph/

# Claude Code auto-memory
.claude/auto-memory/dirty-files*

# claude-stack's per-machine selection: Prettier reads this file but not the global one
.claude/skill-stack.json
.claude/rules/skill-stack.md

# Claude Code worktrees: Prettier reads this file but not .git/info/exclude, so
# without this line a worktree's unformatted work fails the main checkout's gate
.claude/worktrees/

# Archify runs: a new timestamped folder per diagram, with a ~770 KB HTML and
# receipts holding absolute local paths. Commit exported images, not this.
.archify/

# Python bytecode (agents/catalog test runs)
__pycache__/
# Rendered from vscode/User/settings.json.j2 by bin/vscode-settings
vscode/User/settings.json
vscode/User/.settings.rendered
vscode/User/.render-check-*.json
# dotfiles-settings (settings/): uv's environment and build output. uv.lock is tracked.
settings/.venv/
settings/dist/
