{
  "name": "dotfiles",
  "version": "0.0.1",
  "packageManager": "pnpm@12.18.0",
  "type": "module",
  "description": "My personal dotfiles for configuring macOS with Zsh and mise.",
  "private": true,
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "check": "bin/lib/check",
    "format": "prettier --log-level warn --ignore-unknown --write \"**/*.{js,cjs,ts,md,json,sh}\" \"bin/*\" \".github/**/*.yml\"",
    "shots": "bin/lib/app-shots"
  },
  "author": "Jason Matherly",
  "license": "MIT",
  "dependencies": {
    "avif": "^0.6.0"
  },
  "devDependencies": {
    "@ampcode/plugin": "0.0.0-20261102001236-gf10f41a",
    "prettier": "^3.9.9",
    "prettier-plugin-sh": "^0.20.0"
  }
}
