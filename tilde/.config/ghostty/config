# https://ghostty.org/docs/config/reference

# Hack Nerd Font Mono is the font-hack-nerd-font cask (mise's
# conf.d/30-packages.toml). MonoLisa (paid, optional) is a manual install.
font-family = Hack Nerd Font Mono
font-size = 17

# Disable ligatures and configure font features
font-feature = calt
font-feature = -clig
font-feature = -liga
font-feature = zero

theme = dark:Squirrelsong Dark Deep Purple,light:Squirrelsong Light
window-theme = dark
minimum-contrast = 1.1
macos-icon = custom-style
macos-icon-frame = beige
macos-titlebar-style = tabs
# Generate extended 256 color palette based on theme base palette
palette-generate = true
palette-harmonious = true
faint-opacity = 0.75

window-padding-x = 8
window-padding-y = 12

# Bar non-blinking cursor
adjust-cursor-thickness = 2
cursor-style = bar
cursor-style-blink = false
shell-integration = zsh
shell-integration-features = no-cursor
mouse-hide-while-typing = true

window-save-state = always

clipboard-trim-trailing-spaces = true
copy-on-select = clipboard

# Secure Input blocks other apps from reading keyboard events, which breaks
# accessibility software (anything using the accessibility APIs)
macos-auto-secure-input = false

#
# Hot keys
#

# Toggle the "quick" terminal globally from the top
keybind = global:cmd+escape=toggle_quick_terminal

# Switch between panes
keybind = super+shift+left=goto_split:previous
keybind = super+shift+right=goto_split:next

# Make cmd+enter to submit the prompt. By default, Ghostty toggles full screen
keybind = cmd+enter=text:\n
