# Added by OrbStack: 'orb' SSH host for Linux machines
# This only works if it's at the top of ssh_config (before any Host blocks).
# This won't be added again if you remove it.
Include ~/.orbstack/ssh/config

# Personal GitHub — keys live in 1Password, so point ssh at the *public* key
# and the 1Password agent (below) supplies the matching private key. With
# several keys in the agent, this pins GitHub to the personal one.
# ~/.ssh/github_personal.pub is machine-local (not in the repo): export it from
# 1Password, or copy the matching line from `ssh-add -L` against the 1Password
# agent socket.
# https://www.1password.dev/ssh/agent/advanced ("Match key with host")
Host github.com
  IdentitiesOnly yes
  IdentityFile ~/.ssh/github_personal.pub

# Include machine-specific hosts if present. `Match all` ends the github.com
# block above — otherwise ssh would treat this Include as part of it and only
# read config.local when connecting to github.com.
Match all
Include ~/.ssh/config.local

Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
