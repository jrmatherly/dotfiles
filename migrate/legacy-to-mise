#!/bin/bash
#
# Move a Mac set up by the old bash and Brewfile method onto the mise-first setup.
#
# - Show what every step would change, changing nothing:
#
# `migrate/legacy-to-mise --dry-run`
#
# - Run one step (env, macos, packages, dotfiles or setup):
#
# `migrate/legacy-to-mise --step {{step}}`
#
# - Run every step whose phase is in this checkout:
#
# `migrate/legacy-to-mise`
#
# ---
# Temporary: delete migrate/ on or after 2027-02-28 (bin/lib/test-conventions fails after that date).
# The only file that knows the old layout, so it never sources or calls the old scripts.
# Every change asks first, and what it replaces goes to ~/.dotfiles-migration-backup/<timestamp>/.
#
# License: MIT

set -euo pipefail
# A4 removed the HOMEBREW_* exports from the shell, and brew reports analytics as enabled without one
export HOMEBREW_NO_ANALYTICS=1

REPO=$(cd "$(dirname "$0")/.." && pwd -P)
DRY_RUN=false
PREFIX="${HOMEBREW_PREFIX:-/opt/homebrew}"
BACKUP_DIR="$HOME/.dotfiles-migration-backup/$(date +%Y%m%d-%H%M%S)"
MIN_MISE=2026.11.5
CHANGED=0
# Read once: the packages step replaces the mise binary while it runs
MISE=$(command -v mise || true)
STEPS=(env macos packages dotfiles setup)

mise() { "$MISE" "$@"; }
# mise reads a tap cask that publishes no JSON by running its .rb, and that fails with
# "No such file or directory" when /usr/sbin is not on PATH (an agent or launchd shell)
export PATH="$PATH:/usr/sbin"
mise_version() { "$1" --version 2> /dev/null | awk '{ print $1; exit }' || true; }
version_ok() { [ -n "$1" ] && [ "$(printf '%s\n' "$MIN_MISE" "$1" | sort -V | head -1)" = "$MIN_MISE" ]; }

# tput fails with TERM unset (CI, a launchd job), which would abort this set -e script
tput() { command tput "$@" 2> /dev/null || true; }
bold=$(tput bold)
reset=$(tput sgr0)

header() { echo "${bold}==> $1${reset}"; }
info() { echo "$1"; }
warn() { echo "$(tput setaf 3)$1${reset}"; }
success() { echo "$(tput setaf 2)$1${reset}"; }
fail() {
  echo "$(tput setaf 1)$1${reset}" >&2
  exit 1
}
refuse() {
  echo "$1" >&2
  exit 3
}
usage_error() {
  echo "$1 (try --help)" >&2
  exit 2
}

# ask <question>: 0 only for y or Y; a closed stdin and --dry-run are "no"
ask() {
  local reply
  if [ "$DRY_RUN" = true ]; then
    echo "would ask: $1"
    return 1
  fi
  read -r -p "$1 [y/N] " reply || return 1
  [ "$reply" = y ] || [ "$reply" = Y ]
}

# ask_typed <phrase> <question>: 0 only when the reply is exactly <phrase>
ask_typed() {
  local reply
  if [ "$DRY_RUN" = true ]; then
    echo "would ask: $2"
    return 1
  fi
  read -r -p "$2 Type '$1' to go ahead: " reply || return 1
  [ "$reply" = "$1" ]
}

run() {
  if [ "$DRY_RUN" = true ]; then
    echo "would run: $*"
    return 0
  fi
  echo "→ $*"
  # Explicit: under `if ! run …` or `run … ||` set -e is off, and a failure would count as a change
  "$@" || return $?
  CHANGED=$((CHANGED + 1))
}

# shortcut: a path holding a single quote breaks its restore line; quote with printf %q if one ever needs backing up
backup_to() {
  local verb=$1 path=$2 dest real
  case $path in /*) ;; *) fail "backup needs an absolute path: $path" ;; esac
  real="$(cd "$(dirname "$path")" && pwd -P)/$(basename "$path")"
  if [ "$verb" = mv ]; then
    case $real in "$REPO" | "$REPO"/*) fail "refusing to move $path: it is inside the clone" ;; esac
  fi
  if [ "$DRY_RUN" = true ]; then
    echo "would back up: $path"
    return 0
  fi
  dest="$BACKUP_DIR/files/${path#/}"
  (umask 077 && mkdir -p "$(dirname "$dest")")
  if [ "$verb" = mv ]; then
    mv "$path" "$dest"
    echo "mv '$dest' '$path'" >> "$BACKUP_DIR/RESTORE.txt"
  else
    cp -p "$path" "$dest"
    echo "cp -p '$dest' '$path'" >> "$BACKUP_DIR/RESTORE.txt"
  fi
}
backup_move() { backup_to mv "$1"; }
backup_copy() { backup_to cp "$1"; }

# backup_note <file> <line>
backup_note() {
  [ "$DRY_RUN" = false ] || return 0
  (umask 077 && mkdir -p "$BACKUP_DIR" && echo "$2" >> "$BACKUP_DIR/$1")
}

phase_marker() {
  case $1 in
    env) echo zsh/override-env.zsh ;;
    macos) echo tilde/.config/mise/conf.d/20-macos.toml ;;
    packages) echo tilde/.config/mise/conf.d/30-packages.toml ;;
    dotfiles) echo tilde/.config/mise/conf.d/40-dotfiles.toml ;;
    setup) echo tilde/.config/mise/conf.d/50-bootstrap.toml ;;
  esac
}
phase_present() { [ -e "$REPO/$(phase_marker "$1")" ]; }

OVERRIDE="$HOME/.config/mise/config.override.toml"

# The key of each [[setting]] in the registry with kind = "env" that is not read-only
registered_env_keys() {
  awk '
    function flush() { if (kind == "env" && access != "ro" && key != "") print key; kind = ""; key = ""; access = "" }
    /^\[/ { flush() }
    /^[ \t]*(kind|key|access)[ \t]*=/ {
      name = $0; sub(/^[ \t]*/, "", name); sub(/[ \t]*=.*/, "", name)
      value = $0; sub(/^[^=]*=[ \t]*"/, "", value); sub(/".*/, "", value)
      if (name == "kind") kind = value; else if (name == "key") key = value; else access = value
    }
    END { flush() }
  ' "$REPO/settings/registry.toml"
}

# zsh_local_value <KEY>: the value of the last `export KEY=` line in ~/.zsh.local, read as
# text, never run. 1: no such line. 2: not '…', "…" or a plain word, or it holds a $ (mise expands it)
zsh_local_value() {
  local line rest tail='([[:space:]]+(#.*)?)?$' sq dq bare
  sq="^'([^']*)'$tail"
  dq='^"([^"$`\\]*)"'"$tail"
  bare="^([A-Za-z0-9_./:@%+,=-][A-Za-z0-9_./:@%+,=~-]*)?$tail"
  line=$(grep -E "^[[:space:]]*export[[:space:]]+$1=" "$HOME/.zsh.local" 2> /dev/null | tail -1 || true)
  [ -n "$line" ] || return 1
  rest=$(sed -E "s/^[[:space:]]*export[[:space:]]+$1=//" <<< "$line")
  if [[ $rest =~ $sq ]] || [[ $rest =~ $dq ]] || [[ $rest =~ $bare ]]; then
    [[ ${BASH_REMATCH[1]} != *'$'* ]] || return 2
    printf '%s\n' "${BASH_REMATCH[1]}"
    return 0
  fi
  return 2
}

# retired_hint <NAME>: what to do about an export the new setup no longer reads, once its phase is here
retired_hint() {
  case $1 in
    DOTFILES_MACOS_YES | DOTFILES_MACOS_NO) phase_present macos && echo "Delete its line from ~/.zsh.local yourself." ;;
    HOMEBREW_*) phase_present packages && echo "Delete its line from ~/.zsh.local yourself." ;;
    COMPUTERNAME) phase_present macos && echo "Set it with: dotfiles-settings set macos.computer_name <name>" ;;
    LOCALHOSTNAME) phase_present macos && echo "Set it with: dotfiles-settings set macos.local_hostname <host>" ;;
  esac
}

# The override of <KEY>, exit 1 when it has none. mise is not asked about a file that does not exist
read_override() { [ -f "$OVERRIDE" ] && mise set --file "$OVERRIDE" "$1" 2> /dev/null; }

step_env() {
  local names key value rc current hint found='' retired='' overrides=0 backed=false
  [ -f "$REPO/settings/registry.toml" ] || refuse "refusing env: settings/registry.toml is not in this checkout (phase A2)"
  names=$(sed -nE 's/^[[:space:]]*export[[:space:]]+([A-Za-z_][A-Za-z0-9_]*)=.*/\1/p' "$HOME/.zsh.local" 2> /dev/null | sort -u || true)
  while read -r key; do
    ! grep -qxF "$key" <<< "$names" || found+="$key"$'\n'
  done < <(registered_env_keys)
  while read -r key; do
    hint=$(retired_hint "$key" || true)
    [ -z "$hint" ] || retired+="$key: retired, no longer read. $hint"$'\n'
  done <<< "$names"
  if [ -z "$found" ] && [ -z "$retired" ]; then
    info "nothing to migrate"
    return 0
  fi
  while read -r key <&3; do
    [ -n "$key" ] || continue
    rc=0
    value=$(zsh_local_value "$key") || rc=$?
    if [ "$rc" != 0 ]; then
      info "$key: cannot read its value safely. Set it yourself: mise set --override $key=<value>"
      continue
    fi
    if current=$(read_override "$key"); then
      if [ "$current" = "$value" ]; then
        info "$key: already an override"
        overrides=$((overrides + 1))
        continue
      fi
      info "$key: the override is $current, ~/.zsh.local has $value"
      ask "Replace the override for $key?" || continue
    else
      ask "Make $key=$value from ~/.zsh.local an override?" || continue
    fi
    if [ "$backed" = false ] && [ -f "$OVERRIDE" ]; then backup_copy "$OVERRIDE"; fi
    backed=true
    # From $HOME: an untrusted mise.toml in the current directory would fail the write
    cd "$HOME"
    run mise set --override "$key=$value" || fail "mise could not set the override for $key."
    cd - > /dev/null
    overrides=$((overrides + 1))
  done 3<<< "$found"
  printf '%s' "$retired"
  [ "$overrides" = 0 ] || cat << 'EOF'
~/.zsh.local was not edited. Its export lines stay as seeds.
An override beats the seed: while KEY has an override, editing ~/.zsh.local does not change KEY.
Undo one with: mise unset --override KEY
EOF
}

# Set by the old script only on an opt-in; A3 documents them as config.local.toml opt-ins
MACOS_LEFTOVERS=(
  "com.apple.dock autohide-delay"
  "com.apple.dock autohide-time-modifier"
  "com.apple.LaunchServices LSQuarantine"
  "com.apple.frameworks.diskimages skip-verify"
  "com.apple.frameworks.diskimages skip-verify-locked"
  "com.apple.frameworks.diskimages skip-verify-remote"
)

# switch_at_default <VAR>: neither set in this environment nor an override. An empty value is "off"
switch_at_default() { [ -z "${!1+x}" ] && ! read_override "$1" > /dev/null; }

# Read without sudo, as setup/macos-extras.sh does. A read that fails is not "on"
time_machine_on() {
  local v
  v=$(defaults read /Library/Preferences/com.apple.TimeMachine AutoBackup 2> /dev/null || true)
  if [ -n "$v" ] && [ "$v" != 0 ]; then return 0; fi
  v=$(tmutil destinationinfo 2> /dev/null || true)
  [ -n "$v" ] && [[ $v != *"No destinations configured"* ]]
}

# Reports only: the old script already wrote these preferences, and set-defaults writes the declared ones
step_macos() {
  local status pair domain key fw
  status=$(mise bootstrap macos defaults status --json) \
    || fail 'mise could not report the macOS defaults ("mise bootstrap macos defaults status --json" failed).'
  /usr/bin/jq -r '[.macos_defaults.entries[]?.state] as $s | def n(x): [$s[] | select(. == x)] | length;
    "macOS defaults: \(n("set")) set, \(n("differs")) differ, \(n("unset")) unset."' <<< "$status"
  /usr/bin/jq -r '.macos_defaults.entries[]? | select(.state == "differs" or .state == "unset")
    | "\(.domain) \(.key)\(if .path then " " + (.path | join(".")) else "" end): wants \(.value | if type == "string" then . else tojson end), has \(if (.current // "") == "" then "nothing" else .current end)"' <<< "$status"
  for pair in "${MACOS_LEFTOVERS[@]}"; do
    read -r domain key <<< "$pair"
    defaults read "$domain" "$key" > /dev/null 2>&1 || continue
    # One the status lists is declared on purpose, so not a leftover
    if /usr/bin/jq -e --arg d "$domain" --arg k "$key" 'any(.macos_defaults.entries[]?; .domain == $d and .key == $k)' <<< "$status" > /dev/null; then continue; fi
    info "$domain $key: set by the old script, not declared now. To keep it, declare it in config.local.toml (the comment at the top of conf.d/20-macos.toml shows the table). To drop it: defaults delete $domain $key"
  done
  if switch_at_default DOTFILES_MACOS_DISABLE_TIME_MACHINE && time_machine_on; then
    cat << 'EOF'
Time Machine backups are on here. set-defaults now turns them off unless told not to (the old script asked first).
To keep your backups, run this before set-defaults: dotfiles-settings set macos.disable_time_machine off
EOF
  fi
  fw=$(command -v socketfilterfw || echo /usr/libexec/ApplicationFirewall/socketfilterfw)
  # State 2 (block all) is on too, as setup/macos-extras.sh reads it
  if switch_at_default DOTFILES_MACOS_FIREWALL && [[ "$("$fw" --getglobalstate 2> /dev/null || true)" != *"State = "[1-9]* ]]; then
    info "The firewall is off here. set-defaults now turns it on with stealth mode and asks for your password. To leave it off: dotfiles-settings set macos.firewall off"
  fi
  cat << 'EOF'
Nothing was changed. The old script already wrote these preferences.
To write the declared values, run: set-defaults
mise never deletes a preference. One the old script set that no config declares stays as it is.
Declare it in config.local.toml to keep it on purpose, or run its defaults delete command.
EOF
}
# The seven formulae A4 moved to [tools], as the prune dry-run names them (the Brewfile that listed them is gone)
MOVED_TO_TOOLS=(azd azure-functions-core-tools@4 flux hunk kubelogin lazydocker talosctl)
APPDIR="${MIGRATE_APPDIR:-/Applications}"
LOCAL_TOML="$REPO/tilde/.config/mise/config.local.toml"
STATUS=
ONLINE=
DECLARED=0

# A "no" line is noise under --dry-run, where nobody was asked
declined() { [ "$DRY_RUN" = true ] || info "$1"; }

# Sets STATUS. mise fetches a tap cask's metadata to answer, so this can fail offline
read_status() {
  STATUS=$(mise bootstrap packages status --json) \
    || fail 'mise could not report the package state ("mise bootstrap packages status --json" failed; it needs the network while a tap cask is declared).'
}

online() {
  if [ -z "$ONLINE" ]; then
    ONLINE=no
    ! curl -fsI --max-time 5 https://formulae.brew.sh/ > /dev/null 2>&1 || ONLINE=yes
  fi
  [ "$ONLINE" = yes ]
}

dangling_shims() {
  [ -d "$1" ] || return 0
  find "$1" -type l ! -exec test -e {} \; -print
}

reregister_mise_mcp() {
  local got old
  command -v claude > /dev/null || return 0
  got=$(claude mcp get mise 2> /dev/null) || return 0
  old=$(awk '/^  Command: / { sub(/^  Command: /, ""); print; exit }' <<< "$got")
  [ -n "$old" ] && [ "$old" != "$MISE" ] || return 0
  ask "Re-register the mise MCP server with $MISE?" || return 0
  backup_note mcp.txt "$old"
  backup_note RESTORE.txt "claude mcp remove mise -s user && claude mcp add --scope user mise -- '$old' mcp"
  run claude mcp remove mise -s user
  run claude mcp add --scope user mise -- "$MISE" mcp
}

# 0: moved, nothing to move, or declined. 1: a check failed
# mise links each shim to the first mise on PATH, not to the binary that runs, and
# rewrites an existing link only with --force (measured on 2026.11.5)
# PATH as a prefix, not through env, so run echoes the command without the whole PATH
reshim() { PATH="$(dirname "$MISE"):$PATH" run "$MISE" reshim --force; }

move_mise() {
  local new="$HOME/.local/bin/mise" shims="${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims" old n=0
  case $MISE in
    "$PREFIX"/*) ;;
    *)
      n=$(dangling_shims "$shims" | wc -l | tr -d ' ')
      if [ "$n" -gt 0 ]; then
        info "$n mise shim(s) point at a mise that is gone."
        ! ask "Rebuild the mise shims with $MISE?" || reshim
      else
        info "mise: $MISE, not Homebrew's. Nothing to move."
      fi
      return 0
      ;;
  esac
  [ ! -d "$shims" ] || n=$(find "$shims" -type l | wc -l | tr -d ' ')
  cat << EOF
mise is Homebrew's ($MISE). The new setup installs mise with mise's own installer, and
Homebrew's copy refuses "mise self-update", so nothing upgrades it any more.
Moving it runs:
  curl -fsSL https://mise.run | sh     installs ~/.local/bin/mise and checks its checksum
  ~/.local/bin/mise reshim --force     points the $n shims at the new binary
  brew uninstall mise
and checks that every shim still resolves. Way back: HOMEBREW_NO_ANALYTICS=1 brew install mise
EOF
  if ! command -v brew > /dev/null; then
    info "brew is not installed, so its mise cannot be uninstalled by this script."
    return 0
  fi
  if ! online; then
    info "No network: not moving mise."
    return 0
  fi
  if ! ask "Move mise from Homebrew to ~/.local/bin/mise?"; then
    declined "mise stays Homebrew's. sysup reports it until this step moves it."
    return 0
  fi
  # The pipeline's exit status proves nothing (a failed curl hands sh an empty script): the version check decides
  version_ok "$(mise_version "$new")" \
    || run env MISE_INSTALL_PATH="$new" MISE_INSTALL_HELP=0 sh -c 'curl -fsSL https://mise.run | sh' || true
  if ! version_ok "$(mise_version "$new")"; then
    info "The new mise did not install. Homebrew's mise is untouched."
    return 1
  fi
  backup_note mise.tsv "$MISE	$(mise_version "$MISE")"
  backup_note RESTORE.txt "HOMEBREW_NO_ANALYTICS=1 brew install mise && PATH=\"$PREFIX/bin:\$PATH\" mise reshim --force"
  # Reshim before the uninstall: every shim is a link to the mise binary, so uninstalling
  # first would leave node, python and jq dangling for agent and GUI shells
  old=$MISE
  MISE=$new
  hash -r
  reshim || true
  if [ -d "$shims" ] && find "$shims" -type l -lname "$old" | grep -q .; then
    MISE=$old
    info "The shims still point at Homebrew's mise. Nothing was uninstalled."
    return 1
  fi
  if ! run brew uninstall mise; then
    info "brew could not uninstall mise. Both are installed and the shims use the new one. Run this step again."
    return 1
  fi
  reshim || true
  if [ -n "$(dangling_shims "$shims")" ] || { [ -e "$shims/node" ] && ! "$shims/node" --version > /dev/null 2>&1; }; then
    info "A mise shim does not resolve. Put Homebrew's mise back with: HOMEBREW_NO_ANALYTICS=1 brew install mise && PATH=\"$PREFIX/bin:\$PATH\" mise reshim --force"
    return 1
  fi
  reregister_mise_mcp
  info "mise now runs from ~/.local/bin/mise. Open a new terminal: this one still remembers the old path."
  # type -P: `command -v` would name this script's own mise function
  # shellcheck disable=SC2088 # a message, not a path
  [ "$(type -P mise || true)" = "$new" ] \
    || warn "~/.local/bin is not on PATH in this shell. The new shell startup files put it there."
}

# name<TAB>version<TAB>kind for each formula the prune dry-run would remove
undeclared_formulae() {
  local spec name kind
  # grep exits 1 on zero matches, which would end the script under pipefail
  mise bootstrap packages prune --manager brew --dry-run | { grep '^remove brew:' || true; } \
    | while read -r _ spec; do
      spec=${spec#brew:}
      name=${spec%@*}
      kind=dependency
      if [ "$name" = mise ]; then
        kind=mise
      elif [[ " ${MOVED_TO_TOOLS[*]} " == *" $name "* ]]; then
        kind=tools
      elif cat "$PREFIX/Cellar/$name"/*/INSTALL_RECEIPT.json 2> /dev/null | /usr/bin/jq -es 'any(.installed_on_request == true)' > /dev/null; then
        kind=request
      fi
      printf '%s\t%s\t%s\n' "$name" "${spec##*@}" "$kind"
    done
}

undeclared_casks() {
  local d declared
  declared=$(/usr/bin/jq -r '."brew-cask".packages[]?.package | split("/") | last' <<< "$STATUS")
  for d in "$PREFIX"/Caskroom/*/; do
    [ -d "$d" ] || continue
    d=$(basename "$d")
    grep -qxF "$d" <<< "$declared" || echo "$d"
  done
}

# receipt_key <brew|brew-cask> <name> <receipt> <default tap>: the config key, tap-qualified outside the default tap
receipt_key() {
  local tap
  tap=$(/usr/bin/jq -r '.source.tap // empty' "$3" 2> /dev/null | head -1 || true)
  if [ -n "$tap" ] && [ "$tap" != "$4" ]; then echo "$1:$tap/$2"; else echo "$1:$2"; fi
}

# local_toml_add <table> <key> <value>
local_toml_add() {
  local tmp
  ! grep -qF "\"$2\" =" "$LOCAL_TOML" 2> /dev/null || return 0
  if [ "$DECLARED" = 0 ] && [ -e "$LOCAL_TOML" ]; then backup_copy "$LOCAL_TOML"; fi
  if grep -qxF "[$1]" "$LOCAL_TOML" 2> /dev/null; then
    # TOML does not allow the same table twice, so the entry goes under the existing header
    tmp=$(mktemp)
    awk -v h="[$1]" -v e="\"$2\" = $3" '{ print } $0 == h && !done { print e; done = 1 }' "$LOCAL_TOML" > "$tmp"
    cat "$tmp" > "$LOCAL_TOML"
    rm "$tmp"
  else
    [ ! -s "$LOCAL_TOML" ] || echo >> "$LOCAL_TOML"
    printf '[%s]\n"%s" = %s\n' "$1" "$2" "$3" >> "$LOCAL_TOML"
  fi
  DECLARED=$((DECLARED + 1))
  CHANGED=$((CHANGED + 1))
}

# token<TAB>version<TAB>self-updates<TAB>kind<TAB>apps joined by "|", for each cask Homebrew manages
homebrew_casks() {
  local token version self info apps kind
  while IFS=$'\t' read -r token version self; do
    [ -n "$token" ] || continue
    info=
    apps=
    kind=unknown
    if command -v brew > /dev/null && info=$(brew info --json=v2 --cask "$token" 2> /dev/null < /dev/null); then
      apps=$(/usr/bin/jq -r '[.casks[0].artifacts[] | .app? // empty | .[] | strings] | join("|")' <<< "$info")
      kind=other
      if [ -n "$apps" ]; then
        kind=app
      elif /usr/bin/jq -e '[.casks[0].artifacts[] | .pkg? // empty] | length > 0' <<< "$info" > /dev/null; then
        kind=pkg
      fi
    fi
    printf '%s\t%s\t%s\t%s\t%s\n' "$token" "$version" "$self" "$kind" "$apps"
  done < <(/usr/bin/jq -r '."brew-cask".packages[]? | select(.managed_by == "homebrew") | [.package, .installed_version // "-", (.auto_updates == true)] | @tsv' <<< "$STATUS")
}

app_running() { pgrep -f "$APPDIR/$1/Contents/MacOS/" > /dev/null; }

# reinstall_cask <token> <version> <apps joined by "|">: exits 1 when the cask is not mise's afterwards
reinstall_cask() {
  local token=$1 app ok=true rc=0
  backup_note casks.tsv "$token	$2"
  backup_note RESTORE.txt "HOMEBREW_NO_ANALYTICS=1 brew install --cask $token"
  run brew uninstall --cask "$token" || fail "brew could not uninstall $token. Nothing was replaced."
  run mise bootstrap packages apply --yes "brew-cask:$token" || rc=$?
  STATUS=$(mise bootstrap packages status --json) || ok=false
  /usr/bin/jq -e --arg t "$token" '."brew-cask".packages[] | select(.package == $t) | .state == "installed" and .managed_by == "mise"' <<< "$STATUS" > /dev/null || ok=false
  while IFS= read -r app; do
    [ -z "$app" ] || [ -e "$APPDIR/$app" ] || ok=false
  done < <(tr '|' '\n' <<< "$3")
  [ "$ok" = false ] || return 0
  [ "$rc" = 0 ] || info "mise's apply of $token failed (exit $rc). Homebrew has already uninstalled it."
  info "To try mise again: mise bootstrap packages apply brew-cask:$token"
  fail "$token is not installed. Put it back with: HOMEBREW_NO_ANALYTICS=1 brew install --cask $token"
}

clean_staging_leftovers() {
  local d left=()
  for d in "$PREFIX"/Cellar/*/; do
    [ -d "$d" ] && [ "$(ls -A "$d")" = .mise-staging.lock ] || continue
    left+=("${d%/}")
  done
  [ ${#left[@]} -gt 0 ] || return 0
  printf '  %s\n' "${left[@]}"
  ask "Remove ${#left[@]} empty Cellar folder(s) that hold only mise's staging lock?" || return 0
  for d in "${left[@]}"; do
    backup_move "$d"
    CHANGED=$((CHANGED + 1))
  done
}

step_packages() {
  local undeclared casks name version kind token self apps app reason n dir tracked running key

  move_mise || fail "mise was not moved, so nothing else in this step ran."
  read_status

  info "Formulae: nothing to migrate. mise reads $PREFIX, so a formula Homebrew installed counts as installed, and \"mise bootstrap packages upgrade\" replaces it with the current bottle."
  /usr/bin/jq -r '.brew.packages[]? | select(.state == "needs_repair") | "\(.package): needs repair (mise bootstrap packages apply restores the link, nothing is reinstalled)"' <<< "$STATUS"

  undeclared=$(undeclared_formulae)
  n=$(grep -c . <<< "$undeclared" || true)
  info "Not declared in the config: $n formulae (\"mise bootstrap packages prune --dry-run\" lists them; this script never prunes)"
  while IFS=$'\t' read -r name version kind <&3; do
    [ -n "$name" ] || continue
    case $kind in
      mise) reason="Homebrew's mise, moved at the start of this step" ;;
      tools) reason="moved to mise tools, this keg is no longer used" ;;
      request) reason="installed by hand" ;;
      *) reason="a dependency nothing declared needs" ;;
    esac
    info "  $name $version: $reason"
  done 3<<< "$undeclared"
  if [ "$n" -gt 0 ]; then
    dir="${MISE_STATE_DIR:-$HOME/.local/state/mise}/tracked-configs"
    tracked=0
    [ ! -d "$dir" ] || tracked=$(find "$dir" -mindepth 1 -maxdepth 1 | wc -l | tr -d ' ')
    cat << EOF
Any "mise bootstrap packages prune" removes every formula listed above.
mise keeps a formula that any config it has tracked still declares ($tracked tracked, in $dir),
so this list can be shorter than what is really undeclared.
EOF
  fi
  while IFS=$'\t' read -r name version kind <&3; do
    [ "$kind" = request ] || continue
    if ask "Keep $name by declaring it in config.local.toml?"; then
      key=$(receipt_key brew "$name" "$(ls "$PREFIX/Cellar/$name"/*/INSTALL_RECEIPT.json | head -1)" homebrew/core)
      local_toml_add bootstrap.packages "$key" '"latest"'
    else
      declined "$name: left undeclared. A prune removes it."
    fi
  done 3<<< "$undeclared"
  casks=$(undeclared_casks)
  if [ -n "$casks" ]; then
    info "Casks Homebrew installed that no config declares: $(tr '\n' ' ' <<< "$casks" | sed 's/ $//')"
    info "mise never upgrades or removes these. Once declared, one that does not update itself can be moved to mise by this step. To remove one instead, while brew exists: HOMEBREW_NO_ANALYTICS=1 brew uninstall --cask <token>"
    while read -r token <&3; do
      ask "Declare $token in config.local.toml?" || continue
      key=$(receipt_key brew-cask "$token" "$PREFIX/Caskroom/$token/.metadata/INSTALL_RECEIPT.json" homebrew/cask)
      local_toml_add bootstrap.packages "$key" '"latest"'
    done 3<<< "$casks"
  fi
  [ "$DECLARED" = 0 ] \
    || info "Declared $DECLARED package(s) in tilde/.config/mise/config.local.toml (gitignored, this Mac only). Run this step again to see them in the lists below."

  /usr/bin/jq -r '."brew-cask".packages[]? | select(.state == "missing") | "\(.package): declared but not installed. Install it: mise bootstrap packages apply brew-cask:\(.package)"' <<< "$STATUS"

  casks=$(homebrew_casks)
  if [ -z "$casks" ]; then
    info "Casks: none is Homebrew's. Nothing to migrate."
  else
    for self in false true; do
      if [ "$self" = false ]; then
        info "Homebrew casks that do not update themselves:"
      else
        info "Homebrew casks that update themselves:"
      fi
      awk -F'\t' -v s="$self" '$3 == s { printf "  %-34s %-16s %s\n", $1, $2, $4; n++ } END { if (!n) print "  (none)" }' <<< "$casks"
    done
    cat << 'EOF'
Nothing upgrades the first list any more: mise leaves a cask Homebrew installed alone.
The second list updates itself, so moving it gains no upgrades. It is offered because
Homebrew is removed only once no cask is still Homebrew's (the removal at the end of this step).
Reinstalling one through mise runs, for each cask you pick:
  brew uninstall --cask <token>
  mise bootstrap packages apply --yes brew-cask:<token>
and then checks that mise reports it installed and managed by mise.
The app bundle is replaced, not copied to the backup folder. macOS can drop the privacy
permissions (Accessibility, Full Disk Access, Screen Recording and the like) of a replaced app,
so check System Settings > Privacy & Security afterwards.
A cask you decline stays Homebrew's, and Homebrew stays installed while one does.
Way back: HOMEBREW_NO_ANALYTICS=1 brew install --cask <token>.
EOF
    if ! command -v brew > /dev/null; then
      info "brew is not installed, so these cannot be moved by this script. To move one by hand, delete the app and $PREFIX/Caskroom/<token>, then run the apply command."
    elif ! online; then
      info "No network: not reinstalling anything."
    else
      # sort -s: the casks that do not update themselves first, each table in status order
      while IFS=$'\t' read -r token version self kind apps <&3; do
        running=
        while IFS= read -r app; do
          [ -z "$app" ] || ! app_running "$app" || running=$app
        done < <(tr '|' '\n' <<< "$apps")
        if [ -n "$running" ]; then
          info "$token: $running is running. Quit it and run this step again."
        elif ask "Reinstall $token $version through mise?"; then
          reinstall_cask "$token" "$version" "$apps"
        else
          declined "$token: stays Homebrew's, so Homebrew cannot be removed yet."
        fi
      done 3< <(sort -s -t$'\t' -k3,3 <<< "$casks")
    fi
  fi
  clean_staging_leftovers
  offer_homebrew_removal
}

DROPPED="$HOME/.dotfiles-migration-backup/dropped.txt"
# The links Homebrew's uninstall.sh calls homebrew_prefix_markers
HOMEBREW_MARKERS=(etc/bash_completion.d/brew share/doc/homebrew share/man/man1/brew.1 share/zsh/site-functions/_brew share/fish/vendor_completions.d/brew.fish)

# brew:<name> or brew-cask:<token> for each line of the drop file, its tap removed. The script never writes the file
dropped_packages() {
  [ -f "$DROPPED" ] || return 0
  sed -E '/^[[:space:]]*(#|$)/d; s/[[:space:]]+$//; s#^(brew(-cask)?):(.*/)?#\1:#' "$DROPPED"
}

# "<manager> <package> <state> <managed_by>" per package, from a fresh status read
packages_fingerprint() {
  local s
  s=$(mise bootstrap packages status --json) || return
  /usr/bin/jq -r 'to_entries[] | select(.key == "brew" or .key == "brew-cask") | .key as $m
    | .value.packages[]? | "\($m) \(.package) \(.state) \(.managed_by // "-")"' <<< "$s" | sort
}

# One line per package Homebrew still owns. 0: none, 1: some, 2: mise cannot say who manages what
homebrew_leftovers() {
  local s d name casks formulae dropped lines
  s=$(mise bootstrap packages status --json 2> /dev/null) || return 2
  /usr/bin/jq -e '.brew.available != false and ."brew-cask".available != false' <<< "$s" > /dev/null || return 2
  casks=$(/usr/bin/jq -r '."brew-cask".packages[]?.package | split("/") | last' <<< "$s")
  formulae=$(/usr/bin/jq -r '.brew.packages[]?.package | split("/") | last' <<< "$s")
  dropped=$(dropped_packages)
  lines=$({
    /usr/bin/jq -r '."brew-cask".packages[]? | select(.managed_by == "homebrew") | .package
      | "  brew-cask:\(.): still Homebrew'\''s. Move it: HOMEBREW_NO_ANALYTICS=1 brew uninstall --cask \(.) && mise bootstrap packages apply --yes brew-cask:\(.)"' <<< "$s"
    for d in "$PREFIX"/Caskroom/*/; do
      [ -d "$d" ] || continue
      name=$(basename "$d")
      grep -qxF "$name" <<< "$casks" || grep -qxF "brew-cask:$name" <<< "$dropped" || echo "  brew-cask:$name: installed by Homebrew, declared nowhere"
    done
    # mise and the MOVED_TO_TOOLS are not counted, nor dependencies: mise installs those of a declared formula itself
    for d in "$PREFIX"/Cellar/*/; do
      [ -d "$d" ] || continue
      name=$(basename "$d")
      if [ "$name" = mise ] || [[ " ${MOVED_TO_TOOLS[*]} " == *" $name "* ]] \
        || grep -qxF "$name" <<< "$formulae" || grep -qxF "brew:$name" <<< "$dropped"; then continue; fi
      if cat "$d"*/INSTALL_RECEIPT.json 2> /dev/null | /usr/bin/jq -es 'any(.installed_on_request == true)' > /dev/null; then
        echo "  brew:$name: installed by hand, declared nowhere"
      fi
    done
  } | sort)
  [ -n "$lines" ] || return 0
  printf '%s\n' "$lines"
  return 1
}

# What moving the Homebrew program takes, each path that exists
homebrew_program() {
  local name
  {
    git -C "$PREFIX" ls-tree --name-only HEAD | while IFS= read -r name; do [ "$name" = bin ] || echo "$PREFIX/$name"; done
    printf '%s\n' "$PREFIX/bin/brew" "$PREFIX/.git" "${HOMEBREW_MARKERS[@]/#/$PREFIX/}" "$HOME/Library/Caches/Homebrew" "$HOME/Library/Logs/Homebrew"
  } | while IFS= read -r name; do
    if [ -e "$name" ] || [ -L "$name" ]; then echo "$name"; fi
  done
}

# Not Homebrew's uninstall.sh: it deletes Cellar and Caskroom, where mise's packages live. 1: had to put it back
offer_homebrew_removal() {
  local ok=true rc=0 before after leftovers unknown paths p f dropped shell_lines moved=() i
  passed() { [ "$DRY_RUN" = false ] || info "  ok: $1"; }
  info "Homebrew program:"
  if [ ! -e "$PREFIX/bin/brew" ] || [ ! -d "$PREFIX/.git" ]; then
    info "Homebrew is not installed here in the layout this script knows."
    return 0
  fi
  passed "Homebrew is installed at $PREFIX"
  case $MISE in
    "$PREFIX"/*)
      info "mise is still Homebrew's. Move it first: answer yes at the start of this step."
      ok=false
      ;;
    *) passed "mise is not Homebrew's ($MISE)" ;;
  esac
  [ "$ok" = true ] || [ "$DRY_RUN" = true ] || return 0
  # 5 and 6 read the same status, so a failed read stops the dry run too
  if ! before=$(packages_fingerprint); then
    info "mise cannot read the package status. Fix that first: mise bootstrap packages status"
    return 0
  fi
  passed "mise reads the package status"
  leftovers=$(homebrew_leftovers) || rc=$?
  if [ "$rc" = 2 ]; then
    info "mise cannot read the package status. Fix that first: mise bootstrap packages status"
    return 0
  elif [ "$rc" = 1 ]; then
    cat << EOF
Homebrew stays installed: it still owns these packages.
$leftovers
Declare one: run this step again and answer yes to "Keep" or "Declare", or add it to conf.d/30-packages.toml.
Remove one while brew exists: HOMEBREW_NO_ANALYTICS=1 brew uninstall [--cask] <name>
Drop one on purpose (it stays installed, and nothing updates or removes it once brew is gone):
  mkdir -p ~/.dotfiles-migration-backup && echo 'brew-cask:<token>' >> ~/.dotfiles-migration-backup/dropped.txt
EOF
    ok=false
  else
    passed "nothing Homebrew installed is left outside mise's package state"
  fi
  [ "$ok" = true ] || [ "$DRY_RUN" = true ] || return 0
  unknown=$(awk '$1 == "brew-cask" && $4 == "unknown" { printf "%s ", $2 }' <<< "$before")
  if [ -n "$unknown" ]; then
    info "mise cannot tell who manages these casks: ${unknown% }. Fix that first: mise bootstrap packages status"
    ok=false
  else
    passed "mise knows who manages every cask"
  fi
  [ "$ok" = true ] || [ "$DRY_RUN" = true ] || return 0
  # One volume, so each move is a rename
  if [ "$(df -P "$PREFIX" "$HOME" | awk 'NR > 1 { print $1 }' | sort -u | wc -l | tr -d ' ')" != 1 ]; then
    info "The backup folder is on another volume."
    ok=false
  else
    passed "the backup folder is on the same volume as $PREFIX"
  fi
  # Read before the first move: the list comes from the Git checkout that moves
  paths=$(homebrew_program)
  if [ "$DRY_RUN" = true ]; then
    info "Would move to the backup folder:"
    sed 's/^/  /' <<< "$paths"
    return 0
  fi
  [ "$ok" = true ] || return 0

  # if, not case: bash 3.2 cannot parse a case pattern inside $( )
  dropped=$(dropped_packages | while IFS= read -r p; do
    f="$PREFIX/Caskroom/${p#brew-cask:}"
    [[ $p != brew:* ]] || f="$PREFIX/Cellar/${p#brew:}"
    if [ -d "$f" ]; then echo "  $p"; fi
  done)
  shell_lines=$(for f in "$HOME/.zsh.local" "$HOME/.zprofile" "$HOME/.zshrc" "$HOME/.bash_profile" "$HOME/.profile"; do
    if [ -f "$f" ] && ! old_style "$f"; then
      { grep -nE 'brew shellenv|HOMEBREW_' "$f" || true; } | cut -d: -f1 | while read -r i; do echo "  $(tildify "$f"):$i"; done
    fi
  done)
  cat << EOF
Homebrew's own uninstaller is not used: it deletes Cellar and Caskroom, where mise's packages live.
This moves only the Homebrew program (brew, Library with its taps, the Git checkout) into the backup folder.
It leaves Cellar, Caskroom, opt, bin, sbin, etc, include, lib, share, Frameworks, var/homebrew and /etc/paths.d/homebrew.
Every formula and cask Homebrew installed is now declared in mise's config or dropped by you.
Dropped in ~/.dotfiles-migration-backup/dropped.txt (they stay installed; without brew, removing one means deleting it by hand):
${dropped:-  none}
"ca-roots trim" (the opt-in DOTFILES_TRIM_CA_ROOTS step in sysup) runs a script inside Library and stops working.
Lines in your own files that call "brew shellenv" or set HOMEBREW_ variables (not edited):
${shell_lines:-  none}
Type "remove homebrew" to continue. Anything else leaves Homebrew installed.
EOF
  if ! ask_typed "remove homebrew" "Move the Homebrew program aside?"; then
    info "Homebrew stays installed."
    return 0
  fi
  while IFS= read -r p; do
    backup_move "$p"
    moved+=("$p")
    CHANGED=$((CHANGED + 1))
  done <<< "$paths"
  hash -r
  rc=0
  after=$(packages_fingerprint) || rc=$?
  if [ "$rc" = 0 ] && [ "$after" = "$before" ]; then
    info "Homebrew program moved to $BACKUP_DIR. Put it back with the mv lines in RESTORE.txt."
    return 0
  fi
  for ((i = ${#moved[@]} - 1; i >= 0; i--)); do
    mv "$BACKUP_DIR/files${moved[i]}" "${moved[i]}"
  done
  info "mise reads the packages differently without Homebrew, so it was put back."
  diff <(echo "$before") <(echo "$after") | grep '^[<>]' || true
  return 1
}
DOT_STATUS=

# mise prints paths as ~/…, and these turn them into absolute ones and back
untilde() { case $1 in "~"/*) echo "$HOME/${1#"~"/}" ;; *) echo "$1" ;; esac }
# shellcheck disable=SC2088 # display text
tildify() { case $1 in "$HOME"/*) echo "~/${1#"$HOME"/}" ;; *) echo "$1" ;; esac }

# A link the old symlinks.sh made: its text starts with the clone's path
old_style() {
  [ -L "$1" ] || return 1
  case $(readlink "$1") in "$REPO"/* | "$HOME"/dotfiles/*) return 0 ;; esac
  return 1
}

# target<TAB>source, both absolute, for every link the status declares; a symlink-each entry gives one per source file
declared_links() {
  local mode target source f
  while IFS=$'\t' read -r mode target source; do
    target=$(untilde "$target")
    source=$(untilde "$source")
    if [ "$mode" = symlink ]; then
      printf '%s\t%s\n' "$target" "$source"
    elif [ -d "$source" ]; then
      find "$source" -type f | while IFS= read -r f; do printf '%s\t%s\n' "$target${f#"$source"}" "$f"; done
    fi
  done < <(/usr/bin/jq -r '.files[]? | select(.mode == "symlink" or .mode == "symlink-each") | [.mode, .target, .source] | @tsv' <<< "$DOT_STATUS")
}

# old<TAB>target for a declared link the old script made, foreign<TAB>target<TAB>link text for one that points elsewhere
dot_links() {
  local target source
  while IFS=$'\t' read -r target source; do
    [ -L "$target" ] || continue
    if old_style "$target"; then
      printf 'old\t%s\n' "$target"
    elif [ ! "$target" -ef "$source" ]; then
      printf 'foreign\t%s\t%s\n' "$target" "$(readlink "$target")"
    fi
  done < <(declared_links)
}

# dot_conflicts <dry run stderr>: the absolute path of each file the apply refuses to overwrite.
# Only the lines under the files header: an `edits:` error is never a conflict
dot_conflicts() {
  local p
  awk '/files: refusing to overwrite/ { on = 1; next } on && /^  / { sub(/^  /, ""); print; next } { on = 0 }' <<< "$1" \
    | while IFS= read -r p; do untilde "$p"; done
}

# shellcheck disable=SC2088 # every "~/…" here is display text
step_dotfiles() {
  local codex="$HOME/.codex/config.toml" name c p real out q links conflicts foreign
  local dry_err dry_rc=0 n_old n codex_line='' codex_old='' codex_bad=false blocked=false declared found ff file rc=0

  # Every source in conf.d/40-dotfiles.toml goes through ~/dotfiles, and without it mise links nothing
  if [ ! "$HOME/dotfiles" -ef "$REPO" ]; then
    if [ -e "$HOME/dotfiles" ] || [ -L "$HOME/dotfiles" ]; then
      info "~/dotfiles is not a link to this clone, and every declared source goes through it. Move it aside, link it with: ln -s '$REPO' ~/dotfiles, and run this step again."
    else
      info "~/dotfiles is missing, and every declared source goes through it. Link it with: ln -s '$REPO' ~/dotfiles, and run this step again."
    fi
    return 1
  fi
  # mise reads the dotfiles relative to $HOME, and an untrusted mise.toml in another directory would stop it
  cd "$HOME"

  if [ -L "$HOME/.claude/rules" ] && [ "$HOME/.claude/rules" -ef "$REPO/tilde/.claude/rules" ]; then
    info "~/.claude/rules is one link into the clone. mise replaces it with a real folder of links."
  fi
  # --force there would replace the tracked file with a link to itself, and the key files are not this script's to move
  if [ -L "$HOME/.ssh" ] && [ "$HOME/.ssh" -ef "$REPO/tilde/.ssh" ]; then
    cat << EOF
~/.ssh is one link into the clone. Fix it by hand, then run this step again:
  rm ~/.ssh && mkdir -m 700 ~/.ssh
  mv $REPO/tilde/.ssh/<every file except config> ~/.ssh/
EOF
    return 1
  fi

  # The old script linked a Mac's own mole/<name>.local, and a plain apply would repoint it to the shared list
  for name in whitelist whitelist_optimize; do
    [ -e "$REPO/mole/$name.local" ] || continue
    ! grep -qF "\"~/.config/mole/$name\" =" "$LOCAL_TOML" 2> /dev/null || continue
    if ask "Keep this Mac's Mole $name list by adding it to config.local.toml?"; then
      local_toml_add dotfiles "~/.config/mole/$name" "{ source = \"~/dotfiles/mole/$name.local\", mode = \"symlink\" }"
    else
      declined "~/.config/mole/$name will point at the shared list."
    fi
  done

  DOT_STATUS=$(mise dot status --json) || fail 'mise could not report the dotfiles ("mise dot status --json" failed).'
  out=$(mktemp)
  dry_err=$(mise dot apply --dry-run 2>&1 > "$out") || dry_rc=$?
  rm "$out"
  [ "$DRY_RUN" = false ] || printf '%s\n' "$dry_err"

  if [ -L "$codex" ]; then
    codex_old=$(readlink "$codex")
    if old_style "$codex"; then
      codex_line="~/.codex/config.toml: a link into the clone. Removed before the apply, which then creates the file at mode 600."
    else
      codex_line="~/.codex/config.toml: a link to $codex_old. Replaced before the apply by a copy of that file at mode 600, which mise then gives only the keys it lacks."
    fi
  elif [ -f "$codex" ] && grep -q 'failed to parse the TOML target' <<< "$dry_err"; then
    codex_bad=true
  fi

  conflicts=$(dot_conflicts "$dry_err")
  links=$(dot_links)
  foreign=$(awk -F'\t' '$1 == "foreign" { print $2 "\t" $3 }' <<< "$links")
  n_old=$(grep -c '^old' <<< "$links" || true)

  info "$n_old old-style link(s): already in place or repointed by mise, nothing is lost."
  while IFS= read -r c; do
    [ -n "$c" ] || continue
    real="$(cd -P "$(dirname "$c")" && pwd)/$(basename "$c")"
    case $real in
      "$REPO"/*)
        # A whole-directory link this script does not know: moving the path would move a tracked file
        info "$(tildify "$c"): resolves into the clone, not touched"
        blocked=true
        ;;
      *) info "$(tildify "$c"): a real file or folder is in the way" ;;
    esac
  done <<< "$conflicts"
  while IFS=$'\t' read -r c p; do
    [ -z "$c" ] || info "$(tildify "$c"): a link to $p will be repointed"
  done <<< "$foreign"
  [ -z "$codex_line" ] || info "$codex_line"

  if [ "$codex_bad" = true ]; then
    info "~/.codex/config.toml is not valid TOML, so mise cannot add the keys it lacks. Fix it by hand and run this step again. It was not changed."
    return 1
  fi
  [ "$blocked" = false ] || return 1
  if [ "$dry_rc" != 0 ] && [ -z "$conflicts" ] && [ -z "$codex_line" ]; then
    printf '%s\n' "$dry_err" >&2
    info "mise dot apply --dry-run failed for a reason this step does not know. Nothing was changed."
    return 1
  fi

  n=$(($(grep -c . <<< "$conflicts" || true) + $(grep -c . <<< "$foreign" || true)))
  [ -z "$codex_line" ] || n=$((n + 1))
  q=
  if [ "$n" -gt 0 ]; then
    q="Back up the $n item(s) above and let mise link them?"
  elif ! mise dot status --missing > /dev/null 2>&1; then
    q="Run mise dot apply to link what is missing?"
  fi
  if [ -n "$q" ] && ! ask "$q"; then
    declined "Left as they are. Finish with: mise dot apply"
  elif [ -n "$q" ]; then
    while IFS= read -r c; do
      [ -n "$c" ] || continue
      backup_move "$c"
      CHANGED=$((CHANGED + 1))
    done <<< "$conflicts"
    while IFS=$'\t' read -r c p; do
      [ -n "$c" ] || continue
      backup_note links.tsv "$c	$p"
      backup_note RESTORE.txt "ln -sfn '$p' '$c'"
    done <<< "$foreign"
    if [ -n "$codex_line" ]; then
      backup_note links.tsv "$codex	$codex_old"
      backup_note RESTORE.txt "ln -sfn '$codex_old' '$codex'"
      # Removed first: mise would turn a link into the clone into a regular file at 644, and stops at any other link
      if old_style "$codex"; then
        run rm "$codex"
      else
        real=$(realpath "$codex" 2> /dev/null || true)
        run rm "$codex"
        if [ -f "$real" ]; then
          run cp "$real" "$codex"
          run chmod 600 "$codex"
        fi
      fi
    fi
    # Never --force: it replaces a file with no copy
    run mise dot apply --yes \
      || fail "mise dot apply failed. What this step moved is in $BACKUP_DIR, and RESTORE.txt there puts each item back. Fix what mise names above, then run this step again."
  fi

  # Report only: links the old script made into places that no entry declares any more
  declared=$({
    /usr/bin/jq -r '.files[]?.target' <<< "$DOT_STATUS" | while IFS= read -r p; do untilde "$p"; done
    declared_links | cut -f1
  })
  found=$(
    for p in "$HOME" "$HOME/.claude/rules" "$HOME/.claude/skills" "$HOME/.codex" "$HOME/.gnupg" "$HOME/.ssh" "$HOME/.config/mole" "$HOME/.config"; do
      if [ -d "$p" ]; then find "$p" -maxdepth 1 -type l; fi
    done
    for p in "$HOME/Library/Application Support/Code/User" "$HOME/Library/Application Support/lazydocker/config.yml" "$HOME/Library/Application Support/rtk/config.toml"; do
      if [ -L "$p" ]; then echo "$p"; fi
    done
  )
  while IFS= read -r p; do
    [ -n "$p" ] && old_style "$p" && ! grep -qxF "$p" <<< "$declared" || continue
    if [ -e "$p" ]; then
      info "Old link nothing declares, left in place: $(tildify "$p") -> $(readlink "$p")"
    else
      info "Old link nothing declares, left in place: $(tildify "$p") -> $(readlink "$p") (dangling)"
    fi
  done <<< "$found"

  # Report only: the old script hard-linked these, and setup/dotfiles-extras.sh does now
  ff=$(find "$HOME/Library/Application Support/Firefox/Profiles" -maxdepth 1 -type d -name '*dev-edition*' 2> /dev/null | head -1 || true)
  if [ -z "$ff" ]; then
    info "Firefox: no Developer Edition profile here, so no hard links to check."
  else
    for file in user.js chrome/userContent.css chrome/userChrome.css; do
      if [ "$ff/$file" -ef "$REPO/firefox/$file" ]; then
        info "Firefox $file: hard link ok"
      else
        info "Firefox $file: not linked to the clone (setup/dotfiles-extras.sh links it)"
      fi
    done
  fi

  out=$(mise dot status --missing 2>&1) || rc=$?
  if [ "$rc" = 0 ]; then
    info "All dotfiles are in their declared state."
  else
    printf '%s\n' "$out"
  fi
  return "$rc"
}
# shellcheck disable=SC2088 # every "~/…" here is display text
step_setup() {
  local sudo_local="${MIGRATE_SUDO_LOCAL:-/etc/pam.d/sudo_local}" declared='auth       sufficient     pam_tid.so'
  local rust="${MISE_DATA_DIR:-$HOME/.local/share/mise}/installs/rust"

  # The old setup.sh wrote it only when missing, so a hand-edited one survived; the first mise bootstrap rewrites it
  if [ -f "$sudo_local" ]; then
    if [ "$(cat "$sudo_local")" = "$declared" ]; then
      info "sudo_local: as declared, kept"
    else
      diff <(echo "$declared") "$sudo_local" || true
      backup_copy "$sudo_local"
      info "sudo_local: differs from the declared line above. The first mise bootstrap rewrites it. To restore it afterwards: sudo cp '$BACKUP_DIR/files$sudo_local' /etc/pam.d/sudo_local"
    fi
  fi

  if [ -d "$rust" ]; then
    if ask "Forget mise's old rust install so its shims stop shadowing rustup?"; then
      backup_move "$rust"
      CHANGED=$((CHANGED + 1))
      run mise reshim
    else
      declined "$(tildify "$rust"): left in place. Its shims still shadow rustup."
    fi
  fi

  if [ -e "$HOME/.cargo/bin/rustup" ] && ! cmp -s "$HOME/.cargo/bin/rustup" "$PREFIX/opt/rustup/bin/rustup"; then
    info "~/.cargo/bin/rustup is not Homebrew's rustup. To use Homebrew's: rm -rf ~/.cargo/bin ~/.rustup && $PREFIX/opt/rustup/bin/rustup default stable"
  fi

  # Here for a Mac whose mise moved some other way than the packages step
  reregister_mise_mcp

  [ ! -d "$REPO/private/setup-logs" ] || info "setup logs: kept (the new setup.sh still writes them)"
  [ ! "$HOME/dotfiles" -ef "$REPO" ] || info "~/dotfiles: kept (every [dotfiles] source in the mise config resolves through it)"
}

summary() {
  echo "Changed $CHANGED thing(s)."
  if [ -d "$BACKUP_DIR" ]; then
    echo "Backup: $BACKUP_DIR"
    echo "Restore commands: $BACKUP_DIR/RESTORE.txt"
  fi
}

only=
while [ $# -gt 0 ]; do
  case $1 in
    --step)
      [ $# -ge 2 ] || usage_error "--step needs a name: ${STEPS[*]}"
      case " ${STEPS[*]} " in *" $2 "*) only=$2 ;; *) usage_error "unknown step: $2 (one of ${STEPS[*]})" ;; esac
      shift
      ;;
    --dry-run) DRY_RUN=true ;;
    -h | --help)
      # Print the header comment block (everything after the shebang)
      awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); if ($0 ~ /^License:/) next; print; next } NR > 1 { exit }' "$0"
      exit 0
      ;;
    *) usage_error "unknown option: $1" ;;
  esac
  shift
done

have=
[ -z "$MISE" ] || have=$(mise_version "$MISE")
version_ok "$have" \
  || refuse "refusing: this needs mise $MIN_MISE or newer (found: ${have:-no mise on PATH})"
[ "$HOME/.config/mise" -ef "$REPO/tilde/.config/mise" ] \
  || refuse "refusing: ~/.config/mise is not this clone's tilde/.config/mise, so mise would report on another config"

if [ -n "$only" ]; then
  phase_present "$only" || refuse "refusing $only: $(phase_marker "$only") is not in this checkout"
fi
# Steps run bare, not under `||`, which would turn set -e off inside them: a failed
# step exits 1 at once (a later step may build on it) and the trap still reports
trap summary EXIT
for s in "${STEPS[@]}"; do
  [ -z "$only" ] || [ "$s" = "$only" ] || continue
  if ! phase_present "$s"; then
    echo "skipped $s: its phase is not in this checkout"
    continue
  fi
  header "$s"
  "step_$s"
done
