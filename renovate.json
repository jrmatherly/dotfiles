{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "timezone": "America/New_York",
  "minimumReleaseAge": "7 days",
  "mise": {
    "managerFilePatterns": ["tilde/.config/mise/conf.d/60-rotm-*.toml"]
  },
  "packageRules": [
    {
      "matchPackageNames": ["@ampcode/plugin"],
      "schedule": ["* 0-3 * * 1"],
      "updateNotScheduled": false
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["npm:typescript"],
      "allowedVersions": "<7"
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["azure-functions-core-tools"],
      "allowedVersions": "<5"
    },
    {
      "matchManagers": ["mise"],
      "matchDepNames": ["node", "python"],
      "enabled": false
    }
  ]
}
