#!/bin/bash
#
# Kill the process running on the provided port.
#
# - Release the port:
#
# `clear-port {{port}}`
#
# ---
# License: MIT

set -euo pipefail

if [ "$#" -eq 0 ]; then
  echo "Usage: $(basename "$0") <port_number>"
  exit 1
fi

if ! port_num="$(lsof -ti4TCP:"$1")"; then
  echo "Nothing is listening on port $1" >&2
  exit 1
fi
# lsof prints one PID per line; kill each
xargs kill <<< "$port_num"
