#!/bin/bash
#
# Get macOS software updates, upgrade mise and the formulae and casks it installs, mise tools (pruning versions nothing uses) and uv tools, the Iosevka Code font, dotfiles, Raycast, Claude Code and Amp; update agent skills, regenerate the SnippetsLab skill, record Claude Code plugins/settings/skills and rebuild their catalog.
#
# > Reads like a report: one status line per step and a summary at the end. Full tool output goes to `logs/sysup-<timestamp>.log` in the dotfiles repo, and to the screen only when a step changed something or failed.
# > A macOS update asks for your login password. Run `dotfiles-settings set updates.mac_password_op 'op://vault/item/password'` (a 1Password secret reference) to supply it with a fingerprint instead.
#
# - Run updates:
#
# `sysup`
#
# ---
# License: MIT

set -euo pipefail

DOTFILES="${DOTFILES:-$(cd "$(dirname "$0")/.." && pwd -P)}"
# An installed copy (mise's checkout) is updated by rotm update, and nothing here may write tracked files into it
installed=false
[ "$("$(dirname "$0")/lib/rotm-mode" "$DOTFILES")" != installed ] || installed=true
# By path, as rotm-mode is, and resolved before the cd below
modules="$(cd "$(dirname "$0")/lib" && pwd -P)/rotm-modules"
user_layer="$(dirname "$modules")/rotm-user-layer"
mkdir -p "$DOTFILES/logs"
log="$DOTFILES/logs/sysup-$(date +%Y%m%d-%H%M%S).log"
changed=() notices=() failed=() actions=()
# Not wherever sysup was started: from a project, mise upgrade would also
# upgrade what that project's mise.toml lists
cd "$HOME"

# Colors only on a terminal tput knows (with TERM unset it prints an error per call)
# and only there a "… <step>" line shows while a step runs
c_ok="" c_changed="" c_notice="" c_fail="" c_prompt="" c_reset="" c_bold="" c_dim="" c_banner="" progress=""
if [ -t 1 ] && tput setaf 1 > /dev/null 2>&1; then
  c_ok=$(tput setaf 2) c_changed=$(tput setaf 6) c_notice=$(tput setaf 3)
  c_fail=$(tput setaf 1) c_prompt=$(tput setaf 5) c_reset=$(tput sgr0 2> /dev/null || true)
  c_bold=$(tput bold 2> /dev/null || true) c_dim=$(tput dim 2> /dev/null || true)
  c_banner="$c_bold$(tput setaf 0)$(tput setab 3 2> /dev/null || true)"
  progress=1
fi
step_started=0

# style <level>: sets $glyph and $color
style() {
  case $1 in
    ok) glyph=✔ color=$c_ok ;;
    changed) glyph=↻ color=$c_changed ;;
    notice) glyph=● color=$c_notice ;;
    fail) glyph=✖ color=$c_fail ;;
    prompt) glyph=› color=$c_prompt ;;
  esac
}

# working <text>: the "… <text>" line a terminal shows while a step runs;
# clear_line erases it before anything else prints
working() {
  [ -z "$progress" ] || printf '\r\033[2K  … %s' "$1"
}
clear_line() {
  [ -z "$progress" ] || printf '\r\033[2K'
}

# elapsed <seconds>: "45s", "3m 54s"
elapsed() {
  if [ "$1" -lt 60 ]; then echo "${1}s"; else echo "$(($1 / 60))m $(($1 % 60))s"; fi
}

# status <level> <step> <detail>: print the line, log it, collect it for the
# summary. A step's result line names its time when it took SYSUP_SLOW (10)
# seconds or more; the summary leaves the time out
status() {
  local took=""
  case $1 in
    ok | changed | fail)
      [ $((SECONDS - step_started)) -lt "${SYSUP_SLOW:-10}" ] || took=" ($(elapsed $((SECONDS - step_started))))"
      ;;
  esac
  clear_line
  # An ok line's detail is dimmed so the lines that changed something stand out
  local detail_color=""
  [ "$1" != ok ] || detail_color=$c_dim
  say "$(entry "" "$1" "$2" "$3$took" "$detail_color")"
  # step<TAB>detail, for the summary's rows
  case $1 in
    changed) changed+=("$2"$'\t'"$3") ;;
    notice) notices+=("$2"$'\t'"$3") ;;
    fail) failed+=("$2"$'\t'"$3") ;;
  esac
}

step() {
  printf '\n== %s ==\n' "$1" >> "$log"
  step_started=$SECONDS
  working "$1"
}

# capture <cmd…>: the output lands in $out and the log; returns the command's status
capture() {
  local rc
  out=$("$@" 2>&1) && rc=0 || rc=$?
  # A byte that isn't UTF-8 would abort the sed and awk parsers reading $out
  out=$(iconv -c -f UTF-8 -t UTF-8 <<< "$out" 2> /dev/null || true)
  [ -z "$out" ] || printf '%s\n' "$out" | log_clean >> "$log"
  return "$rc"
}

# The captured output, indented, for a step that changed something or failed
show() {
  clear_line
  [ -z "$out" ] || sed 's/^/    /' <<< "$out"
}

# log_clean: stdin as the log wants it, without color codes or cursor moves
# (tput's sgr0 is ESC ( B ESC [ m), a spinner redrawn in place (ESC [ 1G ESC [ J,
# the skills CLI's) reduced to its last frame
log_clean() {
  sed $'s/.*\033\\[1G\033\\[J//; s/\033\\[[0-9;?]*[A-Za-z]//g; s/\033(B//g'
}

# say <text>: a line to the screen, and to the log
say() {
  printf '%s\n' "$1"
  printf '%s\n' "$1" | log_clean >> "$log"
}

# tildify <path>: $HOME as ~
tildify() {
  case $1 in
    "$HOME"/*) printf '~%s' "${1#"$HOME"}" ;;
    *) printf '%s' "$1" ;;
  esac
}

# entry <lead> <level> <step> <detail> [<detail color>]: one status or summary
# row, the step padded to its column and a long detail wrapped under itself
entry() {
  style "$2"
  printf '%s%s\n' "$(printf '%s\n' "$4" | wrap "$1$color$glyph$c_reset $(printf '%-18s' "$3") ${5:-}" $((${#1} + 21)))" "$c_reset"
}

# rows: stdin "name<TAB>value" lines → a two-column table under the status
# line, names padded to the longest, dimmed on a terminal and plain in the log.
# A name loses its backend or tap (github:microsoft/aspire, user/tap/gh) unless
# another name would then read the same: "markdownlint-cli2 (npm)"
rows() {
  clear_line
  awk -F '\t' -v on="$c_dim" -v off="$c_reset" -v logfile="$log" '
    {
      key[NR] = $1; value[NR] = $2; short[NR] = $1; sub(/.*[:\/]/, "", short[NR])
      # distinct names only: one tool upgraded in two pinned versions is no clash
      if (!(($1) in counted)) { counted[$1]; names[short[NR]]++ }
    }
    END {
      for (i = 1; i <= NR; i++) {
        name[i] = short[i]
        prefix = substr(key[i], 1, length(key[i]) - length(short[i]) - 1)
        if (names[short[i]] > 1 && prefix != "") name[i] = short[i] " (" prefix ")"
        if (length(name[i]) > width) width = length(name[i])
      }
      for (i = 1; i <= NR; i++) {
        line = sprintf("    %-" width "s  %s", name[i], value[i])
        sub(/ +$/, "", line)
        print on line off
        print line >> logfile
      }
    }'
}

# wrap <first> <indent>: stdin text word-wrapped to the terminal, the first
# line after <first> (which shows <indent> columns wide) and the others after
# <indent> spaces; one line, as given, off a terminal or when it fits
wrap() {
  local width=0
  # Not tput cols: in $(…) with stderr discarded it reports terminfo's 80
  [ -z "$progress" ] || width=$(stty size < /dev/tty 2> /dev/null | cut -d' ' -f2)
  awk -v w="${width:-0}" -v first="$1" -v indent="$2" '
    w == 0 || indent + length($0) <= w { print first $0; next }
    {
      line = first; used = indent; n = 0
      for (i = 1; i <= NF; i++) {
        if (w > 0 && n && used + 1 + length($i) > w) { line = line "\n" sprintf("%" indent "s", ""); used = indent; n = 0 }
        line = line (n++ ? " " : "") $i; used += length($i) + (n > 1)
      }
      print line
    }'
}

# stdin lines → "a, b, c"
list() {
  awk 'NR > 1 { printf ", " } { printf "%s", $0 } END { print "" }'
}

# plural <n> <noun>: "1 plugin", "3 plugins"
plural() {
  printf '%s %s' "$1" "$2$([ "$1" = 1 ] || echo s)"
}

# module_off <module> <step>…: true when that module is switched off, after
# giving each of its steps its one line (bin/lib/rotm-modules)
module_off() {
  local module=$1 name
  ! "$modules" is-on "$module" || return 1
  shift
  for name in "$@"; do
    step "$name"
    status ok "$name" "the $module module is off"
  done
}

printf '%sLogging to %s%s\n' "$c_dim" "$(tildify "$log")" "$c_reset"

step sudo
status prompt sudo "Password for sudo, once for the whole run"
sudo -v

# Dotfiles (a failed pull, offline or on a branch with no upstream, shouldn't
# stop the other updates)
step dotfiles
before="$(git -C "$DOTFILES" rev-parse HEAD 2> /dev/null || true)"
if [ "$installed" = true ]; then
  status notice dotfiles "installed copy: run rotm update"
elif capture dotfiles; then
  after="$(git -C "$DOTFILES" rev-parse HEAD 2> /dev/null || true)"
  if [ "$before" = "$after" ]; then
    status ok dotfiles "up to date"
  else
    status changed dotfiles "pulled $(plural "$(git -C "$DOTFILES" rev-list --count "$before..$after")" commit)"
    git -C "$DOTFILES" log --oneline "$before..$after" | sed 's/^/    /' | tee -a "$log"
    actions+=("Open a new terminal: dotfiles changed" "Re-run setup.sh: dotfiles pulled new commits")
  fi
else
  status fail dotfiles "couldn't pull, carried on; run: dotfiles"
  show
fi

# The user's settings folder and its links, before the module list is written through them
if ! layer_out=$("$user_layer" ensure 2>&1); then
  status fail "settings folder" "$(tail -1 <<< "$layer_out")"
fi

# The list of modules mise skips, after the pull so the helper knows a module that arrived in it
if ! modules_out=$("$modules" sync 2>&1); then
  status fail modules "$(tail -1 <<< "$modules_out")"
fi
[ -z "$modules_out" ] || echo "$modules_out" >> "$log"

# macOS. List first: with nothing to install there's no second scan, and the
# list says whether an OS update (the one that restarts) is among them.
step macOS
capture softwareupdate -l || true
macos_updates="$out"
if grep -q 'Label:' <<< "$macos_updates"; then
  # Without --restart, an update whose Title line says "Action: restart" is
  # only downloaded, and a plain restart doesn't install it either (checked
  # 2026-10-27): Software Update's Restart Now or `softwareupdate -ia --restart`
  # does. Restarting here would cut off the steps below, so that's an action
  macos_installed=$(awk '/Label: /{ if (l != "") print l; sub(/.*Label: /, ""); l = $0 } /Action: restart/{ l = "" } END { if (l != "") print l }' <<< "$macos_updates" | list)
  pending=$(awk '/Label: /{ sub(/.*Label: /, ""); l = $0 } /Action: restart/{ print l }' <<< "$macos_updates" | list)
  # On Apple Silicon, softwareupdate itself asks for the account password
  # before an OS update (volume-owner authorization); sudo and Touch ID don't
  # count. Optional: set DOTFILES_MAC_PASSWORD_OP (dotfiles-settings set
  # updates.mac_password_op) to a 1Password secret reference
  # (op://vault/item/password) and the password is read with `op` (a
  # fingerprint) instead of typed — see README, Updating.
  mac_password=""
  if [ -n "$pending" ] && [ -n "${DOTFILES_MAC_PASSWORD_OP:-}" ] && command -v op > /dev/null; then
    # 1Password asks for its own fingerprint, separate from sudo's
    status prompt macOS "1Password: approve reading the Mac password for $pending"
    mac_password="$(op read "$DOTFILES_MAC_PASSWORD_OP")" \
      || status notice macOS "couldn't read the Mac password from 1Password; type it at the prompt"
  fi
  # Never let softwareupdate prompt itself: with its output piped to the log,
  # what was typed at its prompt showed on screen. Read it here, hidden
  if [ -n "$pending" ] && [ -z "$mac_password" ] && [ -t 0 ]; then
    status prompt macOS "Mac password for $pending (hidden; DOTFILES_MAC_PASSWORD_OP reads it from 1Password)"
    read -rs -p "    Password: " mac_password || true
    printf '\n'
  fi
  # printf is a shell builtin, so the password never shows up in `ps`
  # (the log is ours, so the shell writes it, not sudo)
  # shellcheck disable=SC2024
  if [ -n "$mac_password" ]; then
    printf '%s\n' "$mac_password" | sudo softwareupdate -ia --verbose --user "$USER" --stdinpass >> "$log" 2>&1
  else
    sudo softwareupdate -ia --verbose < /dev/null >> "$log" 2>&1
  fi && macos_rc=0 || macos_rc=$?
  unset mac_password
  if [ "$macos_rc" -eq 0 ]; then
    status changed macOS "${macos_installed:+$macos_installed installed}${macos_installed:+${pending:+; }}${pending:+$pending downloaded, not installed yet}"
    [ -z "$pending" ] || actions+=("Install $pending: System Settings → General → Software Update → Restart Now, or run: sudo softwareupdate -ia --restart (a plain restart doesn't install it)")
  else
    status fail macOS "install failed; run: sudo softwareupdate -ia --verbose"
  fi
else
  status ok macOS "no updates"
fi

step "mise self-update"
before=$(mise --version 2> /dev/null | awk '{print $1}' || true)
if capture mise self-update --yes; then
  after=$(mise --version 2> /dev/null | awk '{print $1}' || true)
  if [ "$after" != "$before" ]; then
    status changed "mise self-update" "$before → $after"
  else
    status ok "mise self-update" "up to date"
  fi
else
  status fail "mise self-update" "run: mise self-update"
  show
fi

# Formulae, casks and VS Code extensions (mise's bootstrap packages). Tap
# formulae resolve through api.github.com; mise gets gh's token itself
# ([settings.github] in tilde/.config/mise/config.toml)
# pkg_state: the status JSON, one object keyed by manager; fails when mise does
# (with code on PATH, a failing `code --list-extensions` fails every manager)
pkg_state() {
  local json
  json=$(mise bootstrap packages status --json 2>> "$log") && jq -e 'type == "object"' <<< "$json" > /dev/null 2>&1 && printf '%s\n' "$json"
}
step packages
pkg_after=""
if ! pkg_before=$(pkg_state); then
  status fail packages "couldn't read package state; run: mise bootstrap packages status"
else
  capture mise bootstrap packages upgrade --yes && pkg_rc=0 || pkg_rc=$?
  pkg_after=$(pkg_state) || pkg_after=""
  if [ "$pkg_rc" -ne 0 ]; then
    status fail packages "upgrade failed; run: mise bootstrap packages upgrade"
    show
  elif [ -z "$pkg_after" ]; then
    status fail packages "couldn't read package state; run: mise bootstrap packages status"
  else
    # manager:package<TAB>old → new for each installed_version that moved
    upgraded=$(printf '%s\n%s\n' "$pkg_before" "$pkg_after" | jq -rs '
      ([.[0] | to_entries[] | .key as $m | .value.packages[]? | {key: "\($m):\(.package)", value: .installed_version}] | from_entries) as $old
      | .[1] | to_entries[] | .key as $m | .value.packages[]? | "\($m):\(.package)" as $k
      | select($old[$k] != null and $old[$k] != .installed_version)
      | "\($k)\t\($old[$k]) → \(.installed_version)"')
    if [ -n "$upgraded" ]; then
      status changed packages "$(plural "$(wc -l <<< "$upgraded" | tr -d ' ')" package) upgraded"
      rows <<< "$upgraded"
    else
      status ok packages "up to date"
    fi
  fi
fi

# What the upgrade left not installed. A package config.local.toml declares
# absent is absent or unexpectedly_installed, and neither is a notice. A
# manager that isn't available (no code on PATH yet) reports every package
# skipped, so it is one line
if [ -n "$pkg_after" ]; then
  step "packages status"
  unavailable=$(jq -r 'to_entries[] | select(.value.available == false) | "\(.key)\t\(.value.packages | length)"' <<< "$pkg_after")
  not_installed=$(jq -r 'to_entries[] | select(.value.available != false) | .key as $m | .value.packages[]? | select(.state | IN("installed", "absent", "unexpectedly_installed") | not) | "\($m):\(.package) \(.state)"' <<< "$pkg_after")
  if [ -z "$unavailable$not_installed" ]; then
    status ok "packages status" "all installed"
  fi
  if [ -n "$unavailable" ]; then
    while IFS=$'\t' read -r manager count; do
      status notice "packages status" "$manager is not available ($(plural "$count" package) skipped)"
    done <<< "$unavailable"
  fi
  if [ -n "$not_installed" ]; then
    while read -r missing; do
      status notice "packages status" "$missing; run: mise bootstrap packages apply"
    done <<< "$not_installed"
  fi
fi

# Installed packages no config declares. Only ever a dry run: prune removes
# every one of them, and the owner decides which go. Casks need their own -m
step "packages prune"
if capture mise bootstrap packages prune --dry-run && undeclared=$out \
  && capture mise bootstrap packages prune --dry-run -m brew-cask; then
  undeclared=$(printf '%s\n%s\n' "$undeclared" "$out" | grep -c '^remove ' || true)
  if [ "$undeclared" -eq 0 ]; then
    status ok "packages prune" "nothing undeclared"
  else
    # A module switched off stops declaring its packages, so they are counted here
    modules_off=$("$modules" off | list)
    status notice "packages prune" "$(plural "$undeclared" package) no config declares; review: mise bootstrap packages prune --dry-run${modules_off:+ (modules off: $modules_off)}"
  fi
else
  status fail "packages prune" "run: mise bootstrap packages prune --dry-run"
  show
fi

# mise tools (Node/Python patch releases, npm: CLIs like CodeGraph, GitHub
# release binaries) — stays within the versions pinned in
# ~/.config/mise/config.toml (MISE_LOG_LEVEL=warn hides mise's hint about
# newer releases outside those pins); mise itself updates in the mise self-update step
# Prune before upgrading: it deletes the versions the previous run replaced
# and keeps the ones this run replaces, so each upgrade can be rolled back
# until the next sysup. mise keeps every version a tracked config (any project
# mise has loaded, worktrees too) or a running process still uses
mise_dir="${MISE_DATA_DIR:-$HOME/.local/share/mise}"
step "mise prune"
if [ -d "$mise_dir/installs/rust" ]; then
  # Uninstalling that toolchain runs its rustup, which loops through mise's shims and hangs
  status notice "mise prune" "skipped while a mise rust install shadows rustup; see the Rust step"
elif ! prunable=$(mise ls --prunable --json 2>> "$log") || ! jq -e 'type == "object"' <<< "$prunable" > /dev/null 2>&1; then
  status fail "mise prune" "couldn't list unused versions; run: mise ls --prunable"
else
  paths=$(jq -r '.[][]?.install_path' <<< "$prunable")
  if [ -z "$paths" ]; then
    status ok "mise prune" "nothing unused"
  else
    # An install dir already gone makes du fail; the rest still count
    kb=$(tr '\n' '\0' <<< "$paths" | { xargs -0 du -sk 2> /dev/null || true; } | awk '{ s += $1 } END { print s + 0 }')
    # timeout (coreutils) bounds a hang like the rust one above when it's installed
    # --yes: with no terminal to confirm on, mise prune refuses to delete
    prune=(mise prune --yes)
    ! command -v timeout > /dev/null || prune=(timeout 600 "${prune[@]}")
    if capture "${prune[@]}"; then
      status changed "mise prune" "$(plural "$(wc -l <<< "$paths" | tr -d ' ')" version) removed, $(awk -v k="$kb" 'BEGIN { if (k >= 1048576) printf "%.1fGB", k / 1048576; else if (k >= 1024) printf "%.0fMB", k / 1024; else printf "%dKB", k }') freed"
      jq -r 'to_entries[] | .key + "\t" + ([.value[].version] | join(", "))' <<< "$prunable" | rows
    else
      status fail "mise prune" "run: mise prune --yes"
      show
    fi
  fi
fi

step mise
if capture env MISE_LOG_LEVEL=warn mise upgrade; then
  # mise prints "Upgraded N tools:" then one "  <tool> <old> → <new>" line per
  # version, so a tool upgraded in several pinned versions (python 3.13, 3.14)
  # shows each pair
  upgraded=$(sed -nE $'s/^ +([^ ]+) ([^ ]+) → ([^ ]+)$/\\1\t\\2 → \\3/p' <<< "$out")
  if [ -n "$upgraded" ]; then
    status changed mise "$(plural "$(wc -l <<< "$upgraded" | tr -d ' ')" version) upgraded"
    rows <<< "$upgraded"
  else
    status ok mise "up to date"
  fi
else
  status fail mise "run: mise upgrade"
  show
fi
while read -r tool version until; do
  status notice mise "${tool##*[:/]} $version held until $until by minimum_release_age"
done < <(sed -nE 's/.*WARN +newer ([^ ]+) release ([^ ]+) \(released [^,]*, eligible ([^)]*)\) ignored by minimum_release_age.*/\1 \2 \3/p' <<< "$out")
# mise upgrade reports a tool it could not reinstall (a pipx tool no config
# pins, a backend bug) as a WARN and still exits 0
while read -r mise_warn; do
  status notice mise "$mise_warn; the next sysup's mise prune removes a version no config pins"
done < <(sed -nE 's/.*WARN +(failed to [^:]*):.*/\1/p' <<< "$out" | sort -u)
# Relink the global TypeScript for typescript-language-server (see
# setup/misc.sh): the link target names the exact version mise installed.
if ts_dir="$(mise where npm:typescript 2> /dev/null)"; then
  mkdir -p "$mise_dir/node_modules"
  ln -sfn "$ts_dir/node_modules/typescript" "$mise_dir/node_modules/typescript"
fi

# Rust toolchain (rustup itself is a brew: package mise upgrades above). Per
# toolchain: "<channel>-<triple> updated - rustc NEW (…) (from rustc OLD (…))" or "… unchanged - …"
# Homebrew's keg-only rustup is called by path: mise's shims sit earlier on
# an activated PATH, and a rust toolchain installed in mise but pinned by no
# config leaves a `rustup` shim that only errors
rustup_bin="${HOMEBREW_PREFIX:-/opt/homebrew}/opt/rustup/bin/rustup"
[ -x "$rustup_bin" ] || rustup_bin=$(command -v rustup || true)
if [ -n "$rustup_bin" ]; then
  step Rust
  rust_updated=""
  case $(command -v rustup || true) in
    */mise/shims/rustup) status notice Rust "mise's leftover rust install shadows Homebrew's rustup; run: rm -rf $mise_dir/installs/rust && mise reshim (setup.sh does this), not mise prune, which runs that rustup and hangs" ;;
  esac
  if ! capture "$rustup_bin" update --no-self-update; then
    status fail Rust "run: rustup update"
    show
  elif
    rust_updated=$(sed -nE 's/^ *([a-z]+)[^ ]* updated - rustc ([0-9.]+).*from rustc ([0-9.]+).*/\1 \3 → \2/p' <<< "$out")
    [ -n "$rust_updated" ]
  then
    status changed Rust "$(list <<< "$rust_updated")"
  elif grep -q ' unchanged - ' <<< "$out"; then
    status ok Rust "up to date"
  else
    # Quoted so the next occurrence names its cause: one in a VM run cleared before its log was read
    rust_line=$(grep -v -e '^info: ' -e '^ *$' <<< "$out" | head -1 | sed 's/^ *//' | cut -c1-100) || rust_line=""
    status notice Rust "unrecognized output: ${rust_line:-no toolchain line}; see the log"
  fi
  # The rustup formula is keg-only, so cargo and rustc are its proxies in
  # /opt/homebrew/opt/rustup/bin, which only shells started after that PATH
  # entry landed can see (zsh/path.zsh, tilde/.zprofile). Hindsight's daemon
  # preflight runs `cargo --version`, so a stale shell can't cold-start it
  cargo --version > /dev/null 2>&1 \
    || status notice Rust "cargo --version failed: rustup's proxies live in /opt/homebrew/opt/rustup/bin, so open a new terminal, or run: rustup default stable"
fi

# uv tools (Serena, Scrapling)
if command -v uv > /dev/null; then
  step uv
  if ! capture uv tool upgrade --all; then
    status fail uv "run: uv tool upgrade --all"
    show
  elif grep -q 'Nothing to upgrade' <<< "$out"; then
    status ok uv "up to date"
  # "Updated <tool> vA -> vB" when the tool moved, "Modified <tool> environment"
  # when only its dependencies did; both count as a change
  elif uv_updated=$(sed -n 's/^Updated //p; s/^Modified \(.*\) environment$/\1 dependencies/p' <<< "$out") && [ -n "$uv_updated" ]; then
    status changed uv "$(list <<< "$uv_updated")"
    # uv prints " - name==old" then " + name==new" under each tool's line
    awk '
      /^(Updated|Modified) / { tool = $2; delete old; next }
      /^ - / { split($2, dep, "=="); old[dep[1]] = dep[2]; next }
      /^ \+ / { split($2, dep, "=="); print tool "\t" dep[1] " " (dep[1] in old ? old[dep[1]] " → " : "") dep[2] }' <<< "$out" | rows
  else
    status notice uv "unrecognized output, see the log"
  fi
  # The timeout is 10 because uvx-launched MCP servers hold the cache lock for
  # as long as their session is open, and uv's default wait is 300 s
  step "uv cache"
  uv_cache=$(uv cache dir 2> /dev/null) || uv_cache=''
  if [ -z "$uv_cache" ]; then
    status fail "uv cache" "run: uv cache dir"
  else
    uv_before=$({ find "$uv_cache/archive-v0" -mindepth 1 -maxdepth 1 2> /dev/null || true; } | wc -l | tr -d ' ')
    if UV_LOCK_TIMEOUT=10 capture uv cache prune; then
      uv_after=$({ find "$uv_cache/archive-v0" -mindepth 1 -maxdepth 1 2> /dev/null || true; } | wc -l | tr -d ' ')
      if [ "$uv_after" -lt "$uv_before" ]; then
        status changed "uv cache" "pruned $((uv_before - uv_after)) entries"
      else
        status ok "uv cache" "nothing to prune"
      fi
    # uv prints "waiting for other uv processes" as soon as it waits, so only the timeout line means busy
    elif [[ $out == *"when waiting for lock"* ]]; then
      uv_envs=$({ find "$uv_cache/archive-v0" -mindepth 2 -maxdepth 2 -name pyvenv.cfg 2> /dev/null || true; } | wc -l | tr -d ' ')
      status ok "uv cache" "in use, not pruned ($uv_envs cached environments)"
    else
      status fail "uv cache" "run: uv cache prune"
      show
    fi
  fi
  # An upgrade replaces Scrapling's package dir, and with it the marker file
  # that makes `scrapling install` a no-op, so its Chromium is re-checked
  if ! module_off agents Scrapling && command -v scrapling > /dev/null; then
    step Scrapling
    if ! capture scrapling install; then
      status fail Scrapling "browser download failed; run: scrapling install"
    elif [[ $out != *"already installed"* ]]; then
      status changed Scrapling "browser reinstalled"
    else
      status ok Scrapling "browser up to date"
    fi
  fi
fi

# Iosevka Code Nerd Font (VS Code's font; no cask, so not covered by the
# packages step above) — reinstalls only when the upstream zip changed
if ! module_off fonts Iosevka; then
  step Iosevka
  if ! capture install-iosevka-code; then
    status fail Iosevka "font check failed; run: install-iosevka-code"
    show
  elif grep -q '^Installed Iosevka' <<< "$out"; then
    status changed Iosevka "new release installed"
    actions+=("Restart apps to pick up the new Iosevka Code font")
  else
    status ok Iosevka "up to date"
  fi
  if grep -q 'differs from the reviewed one' <<< "$out"; then
    status notice Iosevka "zip differs from the reviewed one; review it, then set REVIEWED_SHA256 in bin/install-iosevka-code"
  fi
fi

# Claude Code: reinstall the tracked user skills for their listed agents (the
# only thing that brings an installed skill up to date), record the current
# plugins, base settings and user skills in the repo (review with `git diff`),
# then rebuild the catalog of installed skills/agents/MCP servers
if command -v claude > /dev/null; then
  if ! module_off claude "Claude Code" "agent skills"; then
    # The native installer auto-updates on startup, but sysup is where versions
    # get read, and this catches a machine where auto-update stalled. First, so
    # the claude commands below run on the fresh binary
    step "Claude Code"
    before=$(claude --version 2> /dev/null | awk '{print $1}' || true)
    if ! capture claude update < /dev/null; then
      status fail "Claude Code" "run: claude update"
      show
    else
      after=$(claude --version 2> /dev/null | awk '{print $1}' || true)
      if [ "$after" != "$before" ]; then
        status changed "Claude Code" "$before → $after"
        actions+=("Restart Claude Code to run $after")
      else
        status ok "Claude Code" "$before up to date"
      fi
    fi
    # claude-config prints "skill same|changed|unknown <name>" per tracked skill
    # and reinstalls only the changed and unknown ones (another source type, or
    # gh or the site's index.json failed)
    step "agent skills"
    if capture claude-config restore skills --update; then
      skills_changed=$(sed -n 's/^skill changed //p' <<< "$out")
      skills_unknown=$(sed -n 's/^skill unknown //p' <<< "$out")
      skills_same=$(grep -c '^skill same ' <<< "$out" || true)
      skills_note="$skills_same unchanged${skills_unknown:+, reinstalled without a check: $(list <<< "$skills_unknown")}"
      if [ -n "$skills_changed" ]; then
        status changed "agent skills" "$(plural "$(wc -l <<< "$skills_changed" | tr -d ' ')" skill) updated: $(list <<< "$skills_changed"); $skills_note"
      else
        status ok "agent skills" "$skills_note"
      fi
    else
      status fail "agent skills" "run: claude-config restore skills --update"
      show
    fi
  fi
  # REA ships its own skill, paired with the installed server; a `setup --skill`
  # run after the mise upgrade above rewrites both copies when they differ
  if ! module_off agents "REA skill" && command -v rea > /dev/null; then
    step "REA skill"
    # rea setup refuses to replace the symlink the skills CLI used to leave here
    rea_link="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/skills/reverse-engineer-anything"
    [ -L "$rea_link" ] && rm "$rea_link"
    # stderr goes to the log, not into out: a warning line there breaks jq
    rea_rc=0
    out=$(rea setup --skill-client shared --skill-client claude_code --skill --yes --format json 2>> "$log") || rea_rc=$?
    [ -z "$out" ] || printf '%s\n' "$out" >> "$log"
    if [ "$rea_rc" -eq 0 ]; then
      if [ "$(jq '.appliedActions | length' <<< "$out" 2> /dev/null || echo 0)" -gt 0 ]; then
        status changed "REA skill" "reinstalled for rea-agents $(rea --version 2> /dev/null || true)"
      else
        status ok "REA skill" "matches rea-agents $(rea --version 2> /dev/null || true)"
      fi
    else
      status fail "REA skill" "run: rea setup --skill-client shared --skill-client claude_code --skill --yes"
      # The JSON payload is the whole doctor report; only the skill remediation helps here
      out=$(jq -r '.doctor.identity.skill.remediation // .message // empty' <<< "$out" 2> /dev/null || printf '%s' "$out")
      show
    fi
  fi
  # Re-running the pinned installer is the vendor's update and re-wires hooks a
  # release adds; a newer release is only reported, since the pin is a reviewed commit
  if ! module_off agents "Hindsight memory" && [ -f "${HINDSIGHT_CONFIG:-$HOME/.hindsight/coding-agent.json}" ]; then
    step "Hindsight memory"
    # What the installer writes: the hooks in both agents' settings and the
    # staged runtime, plus the daemon environment's lock. Compared before and after, since its output lists every
    # step as done either way
    hindsight_state() {
      {
        jq -c '.hooks' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json" || true
        cat "$HOME/.codex/hooks.json" "$HOME/.hindsight/coding-agents/package.json" "${HINDSIGHT_DAEMON_ENV:-$HOME/.hindsight/daemon-env}/uv.lock" || true
      } 2> /dev/null | cksum
    }
    hindsight_before=$(hindsight_state)
    if capture hindsight-memory upgrade; then
      # The installer's own warnings (▲ lines: no uv, no cargo, no LLM) don't
      # fail it, but each one means the daemon can't cold-start from this shell
      warned=$(sed -n 's/^│  ▲ \(..*\)/\1/p' <<< "$out")
      newer=$(grep -o 'newer release [^;]*' <<< "$out" || true)
      [ -z "$newer" ] || status notice "Hindsight memory" "$newer; bump CODING_AGENTS_VERSION in bin/hindsight-memory"
      [ -z "$warned" ] || status notice "Hindsight memory" "installer: ${warned%%$'\n'*}; see the log"
      # hindsight-memory exits 0 here and the hook is back on uvx; the removed lock is not an update
      if grep -q 'daemon environment did not build' <<< "$out"; then
        status notice "Hindsight memory" "daemon environment did not build; run: hindsight-memory upgrade"
      elif [ "$(hindsight_state)" != "$hindsight_before" ]; then
        status changed "Hindsight memory" "hooks, runtime or daemon environment updated"
      elif [ -z "$newer$warned" ]; then
        status ok "Hindsight memory" "hooks and runtime unchanged"
      fi
    else
      status fail "Hindsight memory" "run: hindsight-memory upgrade"
      show
    fi
  fi
  # SnippetsLab's skill is a static copy of `lab skill show` (see setup/misc.sh)
  if ! module_off agents "SnippetsLab skill" && [ -x /Applications/SnippetsLab.app/Contents/Helpers/lab ]; then
    step "SnippetsLab skill"
    snippetslab_skill="$HOME/.agents/skills/snippetslab/SKILL.md"
    snippetslab_before=$(cksum 2> /dev/null < "$snippetslab_skill" || true)
    if capture install-snippetslab-skill; then
      if [ "$(cksum 2> /dev/null < "$snippetslab_skill" || true)" = "$snippetslab_before" ]; then
        status ok "SnippetsLab skill" "unchanged"
      else
        status changed "SnippetsLab skill" "updated from SnippetsLab"
      fi
    else
      status fail "SnippetsLab skill" "not refreshed; run: install-snippetslab-skill"
      show
    fi
  fi
  if ! module_off claude plugins "Claude config" catalog; then
    # Plugins get no upgrade elsewhere: refresh every marketplace, then each
    # installed plugin (the CLI takes one name; every scope in the registry, not
    # just user scope as claude-config's save does). Claude Code applies updates
    # on its next start. `-y` accepts a marketplace-declared install command
    # unseen (required off a terminal); the tracked marketplaces are ones we
    # vetted, see agents/claude-plugins.txt
    step plugins
    if ! capture claude plugin marketplace update < /dev/null; then
      status fail marketplaces "run: claude plugin marketplace update"
      show
    fi
    plugin_count=0 plugin_updates="" plugins_blocked=0
    while read -r id; do
      if capture claude plugin update -y "$id" < /dev/null; then
        # Counted only once checked: a failed one is its own fail line
        plugin_count=$((plugin_count + 1))
        plugin_updates+=$(grep -E 'Plugin "?[^" ]+"? (updated|downgraded) from ' <<< "$out" \
          | sed -E $'s/^.*Plugin "?([^" ]+)"? (updated|downgraded) from ([^ ]+) to ([^ ]*[^ .]).*$/\\1\t\\3 → \\4/' \
          || true)$'\n'
      elif grep -q "blocked by your organization's policy" <<< "$out"; then
        # Managed settings on this Mac forbid the marketplace; nothing to rerun
        plugins_blocked=$((plugins_blocked + 1))
      else
        status fail plugins "updating $id failed; run: claude plugin update $id"
        show
      fi
    done < <(jq -r '.plugins | keys[]' "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/installed_plugins.json" 2> /dev/null)
    [ "$plugins_blocked" -eq 0 ] \
      || status notice plugins "$(plural "$plugins_blocked" plugin) skipped: marketplace blocked by your organization's policy"
    plugin_updates=$(sed '/^$/d' <<< "$plugin_updates")
    if [ -n "$plugin_updates" ]; then
      status changed plugins "$(plural "$(wc -l <<< "$plugin_updates" | tr -d ' ')" plugin) updated"
      rows <<< "$plugin_updates"
      actions+=("Restart Claude Code to apply plugin updates")
    elif [ "$plugin_count" -gt 0 ]; then
      status ok plugins "$(plural "$plugin_count" plugin) up to date"
    fi

    step "Claude config"
    # Compared before and after, so changes left uncommitted from an earlier run
    # don't count, while a further edit to an already-dirty file does
    agents_state() { git -C "$DOTFILES" status --porcelain agents/ && git -C "$DOTFILES" diff HEAD -- agents/; } 2> /dev/null
    # Retired rules go before save records this Mac's list. Only removals run
    # here: new grants wait for a restore the user runs and reviews
    live_settings="${CLAUDE_CONFIG_DIR:-$HOME/.claude}/settings.json"
    settings_before=$(cksum "$live_settings" 2> /dev/null || true)
    if ! capture claude-config retire; then
      status fail "Claude settings" "run: claude-config retire"
      show
    elif [ "$(cksum "$live_settings" 2> /dev/null || true)" != "$settings_before" ]; then
      status changed "Claude settings" "dropped retired permission rules"
    fi
    agents_before=$(agents_state || true)
    # save writes this Mac over the tracked files, which would erase what a pull
    # just added and ask to commit that. shortcut: a live rule with an absolute
    # $HOME path also reads as pending until a restore adds its ~ form
    capture claude-config restore plugins --dry-run || true
    pending=$out
    capture claude-config restore settings --dry-run || true
    pending+=$out
    if [ "$installed" = true ]; then
      status ok "Claude config" "installed copy: not saved into it"
      [ -z "$pending" ] || actions+=("Take the Claude config this copy ships (review with --dry-run): claude-config restore")
    elif [ -n "$pending" ]; then
      status notice "Claude config" "the repo has plugins or settings this Mac lacks, so nothing was saved"
      actions+=("Take the tracked Claude config (review with --dry-run): claude-config restore; or drop it from the repo: claude-config save")
    elif ! capture claude-config save; then
      status fail "Claude config" "claude-config save failed; the tracked lists were left as they were; run: claude-config save"
      show
    elif [ "$(agents_state || true)" != "$agents_before" ]; then
      status changed "Claude config" "tracked Claude config changed"
      actions+=("Review and commit: git -C $DOTFILES diff agents/")
    else
      status ok "Claude config" "unchanged"
    fi
    step catalog
    if capture claude-catalog; then
      catalog_dir=$(sed -nE 's#^wrote (.*)/CATALOG\.md,.*#\1#p' <<< "$out")
      since=$(sed -nE 's/^wrote .*, since (.*): \+([0-9]+) -([0-9]+)$/\1 \2 \3/p' <<< "$out")
      read -r since_date added removed <<< "${since:-none 0 0}"
      if [ "$added$removed" != 00 ]; then
        status changed catalog "catalog rebuilt, +$added -$removed since $since_date"
        sed -nE $'s/^  (added|removed): /\\1\t/p' <<< "$out" | rows
      else
        status ok catalog "catalog rebuilt"
      fi
    else
      status fail catalog "claude-catalog failed; agents/catalog/curated.toml may name something no longer installed; run: claude-catalog"
    fi
    while read -r lint; do
      status notice catalog "$lint"
    done < <(sed -n 's/^  lint: /lint: /p' <<< "$out")
  fi
  # mise's MCP server (setup/misc.sh registers it). A down user-scope entry
  # with another command (the retired mcp-cache-hints wrapper, a moved
  # binary) is re-registered; no entry (removed on purpose) or a local or
  # project one shadowing it is left alone. "tools fetch failed" with the
  # right command is anthropics/claude-code#88128 back, which re-registering
  # can't fix: a proxy covered it until 7e7db8a.
  if ! module_off agents "mise MCP"; then
    step "mise MCP"
    if mise_bin="$(command -v mise)"; then
      mise_get() { claude mcp get mise 2> /dev/null | sed 's/^ *//' || true; }
      mise_mcp="$(mise_get)"
      printf '%s\n' "$mise_mcp" >> "$log"
      if grep -qx 'Status: ✔ Connected' <<< "$mise_mcp"; then
        status ok "mise MCP" "connected"
      elif [ -n "$mise_mcp" ]; then
        if grep -q '^Scope: User config' <<< "$mise_mcp" \
          && ! { grep -qxF "Command: $mise_bin" <<< "$mise_mcp" && grep -qx 'Args: mcp' <<< "$mise_mcp"; }; then
          echo "Re-registering mise's MCP server with Claude Code…" >> "$log"
          claude mcp remove mise -s user > /dev/null 2>&1 \
            && claude mcp add --scope user mise -- "$mise_bin" mcp > /dev/null || true
          mise_mcp="$(mise_get)"
        fi
        if grep -qx 'Status: ✔ Connected' <<< "$mise_mcp"; then
          status changed "mise MCP" "re-registered"
        elif grep -q 'tools fetch failed' <<< "$mise_mcp"; then
          status notice "mise MCP" "lists no tools: anthropics/claude-code#88128 is back; the proxy is in git history (7e7db8a)"
        else
          status fail "mise MCP" "not connected; see: claude mcp get mise; re-register: claude mcp remove mise -s user; claude mcp add --scope user mise -- $mise_bin mcp"
        fi
      fi
    fi
  fi
fi

# Raycast (open gives no evidence of what the check found)
if ! module_off apps Raycast; then
  step Raycast
  if open raycast://extensions/raycast/raycast/check-for-updates \
    && open raycast://extensions/raycast/raycast/check-for-extension-updates; then
    status ok Raycast "asked to check for updates"
  else
    status fail Raycast "couldn't open Raycast; run: open raycast://extensions/raycast/raycast/check-for-updates"
  fi
fi

# Amp is installed by hand (see agents/README.md), so it may not be here
if command -v amp > /dev/null; then
  step Amp
  if ! capture amp update; then
    status fail Amp "run: amp update"
    show
  elif ! grep -qiE 'already|up to date|latest version' <<< "$out" && grep -qE '[0-9]+\.[0-9]+' <<< "$out"; then
    status changed Amp "$(tail -1 <<< "$out")"
  else
    status ok Amp "up to date"
  fi
fi

# Summary. Empty arrays are unbound under set -u in bash 3.2, hence the guards.
step summary
# summary <title> <level> <step<TAB>detail…>: a colored title, then one row per
# line, laid out as the status lines are
summary() {
  local title=$1 level=$2 line
  style "$level"
  shift 2
  say "$c_bold$color$title$c_reset"
  for line in "$@"; do
    say "$(entry "  " "$level" "${line%%$'\t'*}" "${line#*$'\t'}")"
  done
}
# link <label> <path>: on a terminal the path as ~/… and clickable (OSC 8),
# otherwise a file:// URL, which terminals without OSC 8 still link
link() {
  local short
  short=$(tildify "$2")
  if [ -n "$progress" ]; then
    printf '%s%-8s%s \033]8;;file://%s\033\\%s\033]8;;\033\\\n' "$c_dim" "$1" "$c_reset" "$2" "$short"
  else
    printf '%-8s file://%s\n' "$1" "$2"
  fi
  printf '%-8s file://%s\n' "$1" "$2" >> "$log"
}
# counts: "4 changed · 1 notice · 1 failed · 2 actions", leaving out zeros
counts() {
  local parts=()
  [ ${#changed[@]} -eq 0 ] || parts+=("${#changed[@]} changed")
  [ ${#notices[@]} -eq 0 ] || parts+=("$(plural ${#notices[@]} notice)")
  [ ${#failed[@]} -eq 0 ] || parts+=("${#failed[@]} failed")
  [ ${#actions[@]} -eq 0 ] || parts+=("$(plural ${#actions[@]} action)")
  [ ${#parts[@]} -eq 0 ] || printf '%s · ' "${parts[@]}" | sed 's/ · $//'
}
clear_line
say ""
done_in="${c_bold}Done in $(elapsed "$SECONDS")${c_reset}"
tally=$(counts)
if [ -z "$tally" ]; then
  say "$done_in"
  say "${c_ok}Everything up to date.${c_reset}"
else
  say "$done_in ${c_dim}·${c_reset} $tally"
  [ ${#changed[@]} -eq 0 ] || summary Changed changed "${changed[@]}"
  [ ${#notices[@]} -eq 0 ] || summary Notices notice "${notices[@]}"
  [ ${#failed[@]} -eq 0 ] || summary Failed fail "${failed[@]}"
  # Last before the links, set apart, so it's what the eye lands on
  if [ ${#actions[@]} -gt 0 ]; then
    say ""
    say "${c_banner} ▶ ACTION NEEDED ($(plural ${#actions[@]} item)) ${c_reset}"
    style prompt
    for action in "${actions[@]}"; do
      say "$(wrap "  $color$glyph$c_reset $c_bold" 4 <<< "$action")$c_reset"
    done
  fi
fi
say ""
[ -z "${catalog_dir:-}" ] || link Catalog "$catalog_dir/catalog.html"
link Log "$log"
say ""

# Sign-off: Deadpool with his katanas (bin/nyan)
nyan
