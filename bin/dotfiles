#!/bin/bash
#
# Update the dotfiles repo by pulling the latest changes.
# > Re-run `setup.sh` afterwards to apply any new symlinks.
#
# - Pull the latest dotfiles:
#
# `dotfiles`
#
# ---
# License: MIT

set -eu

# Resolve the repo location from this script's own path, falling back to
# $DOTFILES (exported by ~/.zshenv)
DOTFILES="${DOTFILES:-$(cd "$(dirname "$0")/.." && pwd -P)}"

cd "$DOTFILES" || exit 1

# mise's checkout is updated through mise, which also reruns setup
if [ "$("$(dirname "$0")/lib/rotm-mode" "$DOTFILES")" = installed ]; then
  echo "This is an installed copy. Run: rotm update"
  exit 0
fi

echo "Pulling changes from upstream…"
before="$(git rev-parse HEAD)"
git pull
if [ "$(git rev-parse HEAD)" != "$before" ]; then
  echo
  echo "🦏 Open a new terminal for the changes to take effect."
fi
