#!/bin/bash
#
# Show help for this repo's aliases, `docs/` pages and `bin/` scripts, or fall back to tldr-pages.
# > More information: <https://github.com/tldr-pages/tlrc>.
#
# - Show the alias and shortcut index (`docs/README.md`):
#
# `help`
#
# - Show help for a script in `bin/`, a docs page (e.g. `gui/safari`), or any command:
#
# `help {{command}}`
#
# ---
# License: MIT

cd "$(dirname "$0")/.." || exit

DOTFILES_DIR="$(pwd -P)"
config="$DOTFILES_DIR/tilde/.tlrc.toml"

# The pages in docs/ are regular Markdown (headings, tables), which tlrc's
# strict tldr-page format rejects, so render those with bat instead
render_markdown() {
  if command -v bat &> /dev/null; then
    bat --language=markdown --style=plain --paging=never "$1"
  else
    cat "$1"
  fi
}

if [[ "$1" != "" ]]; then
  md="$("$DOTFILES_DIR"/bin/lib/get-tldr-md "$1")" || {
    echo "No help for $1" >&2
    exit 1
  }
else
  md="$DOTFILES_DIR/docs/README.md"
fi

# get-tldr-md writes a script's page into its own mkdtemp dir, tldr-XXXXXX
# directly under Node's os.tmpdir(). Only such a dir is ever deleted: a path
# check against the repo breaks when help and get-tldr-md resolve it
# differently (~/dotfiles symlink vs $DOTFILES), and the wrong branch would
# rm -rf a docs folder
tmp_root="${TMPDIR:-/tmp}"
tmp_root="${tmp_root%/}"
page_dir="$(dirname "$md")"
if [[ "$(dirname "$page_dir")" == "$tmp_root" && "${page_dir##*/}" == tldr-?????? && -f "$md" ]]; then
  trap 'rm -rf "$page_dir"' EXIT
  tldr --config "$config" --render "$md"
elif [ "$md" != "" ]; then
  render_markdown "$md"
else
  tldr --config "$config" "$@"
fi
