#!/bin/bash
#
# Serve current directory with an HTTP server.
#
# - Start a server with the default port (`8080`):
#
# `serve`
#
# - Start a server with a specific port:
#
# `serve {{port}}`
#
# ---
# See more: https://docs.python.org/3/library/http.server.html
#
# License: MIT

port="${1:-8080}"
[ -n "${SERVE_NO_OPEN:-}" ] || open "http://localhost:${port}/"
exec python3 -m http.server "$port"
