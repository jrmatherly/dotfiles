#!/bin/bash
#
# Start REA's MCP server with the JDK the installed Homebrew Ghidra uses, resolved at launch.
#
# - What Claude Code runs for the `rea` server (registered by setup/misc.sh):
#
# `rea-mcp`
#
# - See the environment it would hand to `rea mcp`:
#
# `rea-mcp --print-env`
#
# ---
# License: MIT

set -euo pipefail

# Ghidra's JDK moves: the ghidra formula depended on openjdk@21, then 12.2 moved
# it to openjdk@25 (2026-10-22). A JAVA_HOME pinned in the Claude Code
# registration dangled until the next setup run, so nothing versioned is
# registered. This reads both paths from the installed keg every start: the
# JAVA_HOME default in Homebrew's own ghidraRun wrapper, which brew rewrites
# with each Ghidra install, so it is the JDK the GUI uses and never one that a
# `brew update` without `brew upgrade` only promises. A JAVA_HOME already in the
# environment wins, as in that wrapper. Ghidra problems only cost the Ghidra
# provider: the server still starts for Hopper and the built-in providers.
# brew is looked up by absolute path too, since an app-launched Claude Code has
# no Homebrew on PATH.
warn() { echo "rea-mcp: $*" >&2; }

brew="$(command -v brew || echo /opt/homebrew/bin/brew)"
ghidra=""
if [ -x "$brew" ]; then
  ghidra="$("$brew" --prefix ghidra 2> /dev/null || true)"
fi
if [ -d "$ghidra/libexec" ]; then
  export GHIDRA_INSTALL_DIR="$ghidra/libexec"
  if [ -z "${JAVA_HOME:-}" ]; then
    # Homebrew's wrapper: JAVA_HOME="${JAVA_HOME:-/opt/homebrew/opt/openjdk@N/libexec/openjdk.jdk/Contents/Home}" exec …
    JAVA_HOME="$(sed -n 's/^JAVA_HOME="${JAVA_HOME:-\([^}]*\)}".*/\1/p' "$ghidra/bin/ghidraRun" 2> /dev/null | head -1)"
    [ -n "$JAVA_HOME" ] || warn "no JAVA_HOME default in $ghidra/bin/ghidraRun; the Ghidra provider will fail its Java check"
  fi
  if [ -n "${JAVA_HOME:-}" ] && [ ! -x "$JAVA_HOME/bin/java" ]; then
    warn "JAVA_HOME=$JAVA_HOME has no bin/java; leaving it unset"
    unset JAVA_HOME
  fi
  [ -n "${JAVA_HOME:-}" ] && export JAVA_HOME
else
  warn "Homebrew ghidra not found (brew install ghidra); starting REA without its Ghidra provider"
fi

if [ "${1:-}" = --print-env ]; then
  echo "GHIDRA_INSTALL_DIR=${GHIDRA_INSTALL_DIR:-}"
  echo "JAVA_HOME=${JAVA_HOME:-}"
  exit 0
fi
exec "${MISE_DATA_DIR:-$HOME/.local/share/mise}/shims/rea" mcp "$@"
