#!/bin/bash
#
# Save or restore Claude Code's plugins, base settings and user skills (tracked in agents/claude-*).
#
# - Record this machine's plugins, settings and skills into the repo (review with `git diff`):
#
# `claude-config save`
#
# - Install/merge whatever this machine is missing (setup/misc.sh runs this):
#
# `claude-config restore`
#
# - Restore one part only, or show what restore would do:
#
# `claude-config restore {{plugins|settings|skills}} --dry-run`
#
# - Drop retired allow rules from this machine's settings and change nothing else (`upup` runs this):
#
# `claude-config retire`
#
# - Reinstall each tracked skill whose GitHub folder or well-known site digest changed since install, and any it can't check, for its listed agents (`upup` runs this):
#
# `claude-config restore skills --update`
#
# ---
# Files (in agents/):
#   claude-plugins.txt   marketplaces + user-scope plugins ("disabled" = off)
#   claude-settings.json ~/.claude/settings.json without the keys tools own
#                        (enabledPlugins, extraKnownMarketplaces, hooks);
#                        restore merges it in: values already on the machine
#                        win, permission lists are unioned
#   claude-permissions-retired.txt
#                        allow rules that save, restore and retire drop, because
#                        the union alone would keep them on every other Mac
#   claude-skills.txt    user skills installed with the `skills` CLI, and for
#                        which agents (claude-code → ~/.claude/skills,
#                        codex → ~/.agents/skills)
# Reads ~/.claude (or $CLAUDE_CONFIG_DIR) and ~/.agents. Needs jq; skills need
# npx (Node from mise).
#
# License: MIT

set -euo pipefail

DOTFILES_DIR="${DOTFILES_DIR:-$(cd "$(dirname "$0")/.." && pwd -P)}"
save_dir="${CLAUDE_CONFIG_SAVE_DIR:-$DOTFILES_DIR/agents}"
config="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
plugins_list="$save_dir/claude-plugins.txt"
settings_base="$save_dir/claude-settings.json"
skills_list="$save_dir/claude-skills.txt"
retired_list="$save_dir/claude-permissions-retired.txt"
settings="$config/settings.json"
skill_lock="$HOME/.agents/.skill-lock.json"
# Never saved: keys other tools write (plugins are restored separately;
# NotchBar's and CodeGraph's installers add their hooks), credential helpers,
# and env vars except Claude Code's own switches, the one opt-out its plugin
# hooks read and Hindsight's provider pick — env is where API keys and tokens
# go, and the saved file is committed. Of Claude Code's switches, the two the
# LLM Router writes with its gateway profile are left out too: the router adds
# them whenever a provider exists but never removes them from a settings file
# that holds anything else (checked at 4.3.1), and restore never deletes a
# key, so a tracked copy would put a gateway profile on a Mac with no router
settings_filter='del(.enabledPlugins, .extraKnownMarketplaces, .hooks,
    .apiKeyHelper, .awsCredentialExport, .awsAuthRefresh, .otelHeadersHelper)
  | if .env then .env |= with_entries(select((.key | test("^(CLAUDE_CODE_|DISABLE_|MAX_|AZURE_MCP_COLLECT_TELEMETRY$|HINDSIGHT_API_(LLM_PROVIDER|[A-Z_]*LLM_MODEL)$)"))
      and (.key | test("(TOKEN|SECRET|PASSPHRASE|API_KEY|CLIENT_KEY)$") | not)
      and (.key | IN("CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY", "CLAUDE_CODE_DISABLE_UNKNOWN_MODEL_WINDOW_ENFORCEMENT") | not)))
      | if .env == {} then del(.env) else . end
    else . end'
# $HOME → ~ only where it starts a path (after start, space, ( = : or a
# quote, and followed by / or the end); Claude Code's //$HOME/ absolute rule
# syntax becomes ~/
# shellcheck disable=SC2016 # jq program: $h, $s, $p are jq variables, not shell
untilde='def untilde($h): (split("//" + $h + "/") | join("~/")) as $s | ($s | split($h)) as $p
  | reduce range(1; $p | length) as $i ($p[0];
      . + (if (. == "" or (.[-1:] | test("[\\s(=:\"'"'"']"))) and ($p[$i] == "" or ($p[$i] | startswith("/")))
           then "~" else $h end) + $p[$i]);'

dry_run=false
update=false
failed=0
# A jq that fails mid-write leaves its .tmp behind in the repo
tree_cache=""
trap 'rm -f "$save_dir"/*.tmp; [ -z "$tree_cache" ] || rm -rf "$tree_cache"' EXIT

run() {
  if [ "$dry_run" = true ]; then
    echo "$*"
  # stdin is the restore loop's list: keep commands from reading it
  elif ! "$@" < /dev/null; then
    echo "claude-config: failed: $*" >&2
    failed=1
  fi
}

#
# Plugins
#

# `name source` per marketplace; source is what `claude plugin marketplace add`
# takes: a GitHub owner/repo, a git URL or a local path
known_marketplaces() {
  local f="$config/plugins/known_marketplaces.json"
  [ -f "$f" ] || return 0
  jq -r 'to_entries[] | "\(.key) \(.value.source | .repo // .url // .path // empty)"' "$f"
}

# plugin@marketplace ids installed at user scope
installed_plugins() {
  local f="$config/plugins/installed_plugins.json"
  [ -f "$f" ] || return 0
  jq -r '.plugins | to_entries[] | select(any(.value[]; .scope == "user")) | .key' "$f"
}

# Saving must never shrink a tracked file because this machine lacks its
# source (not set up yet, or a tool moved its files): skip with a warning
missing_source() {
  if [ ! -s "$1" ]; then
    echo "claude-config: $(tildify "$1") not found — kept $(tildify "$2")" >&2
    return 0
  fi
  return 1
}

# ...or because its source does not parse: an empty jq result would save
# as an empty list
valid_json() {
  jq -e 'type == "object"' "$1" > /dev/null 2>&1 && return 0
  echo "claude-config: $(tildify "$1") is not a valid JSON object, kept $(tildify "$2")" >&2
  return 1
}

save_plugins() {
  local f disabled=""
  # Without the marketplaces the list loses those lines, without settings its disabled flags
  for f in "$config/plugins/installed_plugins.json" "$config/plugins/known_marketplaces.json" "$settings"; do
    missing_source "$f" "$plugins_list" && return 0
  done
  for f in "$config/plugins/installed_plugins.json" "$config/plugins/known_marketplaces.json" "$settings"; do
    valid_json "$f" "$plugins_list" || return 0
  done
  disabled=$(jq -r '(.enabledPlugins // {}) | to_entries[] | select(.value == false) | .key' "$settings")
  {
    echo "# Claude Code marketplaces and user-scope plugins — see bin/claude-config."
    echo "# \"disabled\" = installed but turned off."
    known_marketplaces | sort | sed 's/^/marketplace /'
    installed_plugins | sort | while read -r id; do
      if grep -qxF "$id" <<< "$disabled"; then
        echo "plugin $id disabled"
      else
        echo "plugin $id"
      fi
    done
  } > "$plugins_list.tmp" && mv "$plugins_list.tmp" "$plugins_list"
}

restore_plugins() {
  local have_marketplaces have_plugins kind name arg marketplace updated=""
  have_marketplaces=$(known_marketplaces | cut -d' ' -f1)
  have_plugins=$(installed_plugins)
  while read -r kind name arg; do
    case $kind in
      marketplace)
        grep -qxF "$name" <<< "$have_marketplaces" || run claude plugin marketplace add "$arg"
        ;;
      plugin)
        grep -qxF "$name" <<< "$have_plugins" && continue
        # A marketplace already on this machine may predate the plugin:
        # refresh it once before the first install from it
        marketplace="${name#*@}"
        if grep -qxF "$marketplace" <<< "$have_marketplaces" && ! grep -qxF "$marketplace" <<< "$updated"; then
          run claude plugin marketplace update "$marketplace"
          updated+="$marketplace"$'\n'
        fi
        run claude plugin install --scope user "$name"
        # Only a fresh install gets the recorded disabled state; one already
        # here keeps whatever you set on this machine
        if [ "$arg" = disabled ]; then run claude plugin disable "$name"; fi
        ;;
    esac
  done < <(grep -Ev '^\s*(#|$)' "$plugins_list")
}

#
# Settings
#

retired_rules() {
  { grep -Ev '^[[:space:]]*(#|$)' "$retired_list" 2> /dev/null || true; } | jq -Rn '[inputs]'
}

save_settings() {
  missing_source "$settings" "$settings_base" && return 0
  valid_json "$settings" "$settings_base" || return 0
  # Sorted permission lists keep the diff stable
  jq --arg home "$HOME" --argjson retired "$(retired_rules)" "$untilde $settings_filter"' | walk(if type == "string" then untilde($home) else . end)
    | if .permissions.allow then .permissions.allow -= $retired else . end
    | if .permissions then .permissions |= with_entries(if (.value | type) == "array" then .value |= sort else . end) else . end' \
    "$settings" > "$settings_base.tmp" && mv "$settings_base.tmp" "$settings_base"
}

restore_settings() {
  local current='{}' merged same='walk(if type == "array" then sort else . end)'
  [ -s "$settings" ] && current=$(cat "$settings")
  # Base first, then what's already here wins; permission lists are unioned
  if ! merged=$(jq -n --argjson base "$(cat "$settings_base")" --argjson cur "$current" --argjson retired "$(retired_rules)" '
    ($base * $cur)
    | reduce ("allow", "deny", "ask", "additionalDirectories") as $k (.;
        if ($base.permissions[$k] // $cur.permissions[$k]) then
          .permissions[$k] = (($base.permissions[$k] // []) + ($cur.permissions[$k] // []) | unique)
        else . end)
    | if .permissions.allow then .permissions.allow -= $retired else . end'); then
    echo "claude-config: couldn't merge $(tildify "$settings_base") into $(tildify "$settings") (invalid JSON?)" >&2
    failed=1
    return 0
  fi
  # Nothing missing (order aside): leave the file alone
  if [ "$(jq -S "$same" <<< "$merged")" = "$(jq -S "$same" <<< "$current")" ]; then
    return
  fi
  if [ "$dry_run" = true ]; then
    echo "merge $(tildify "$settings_base") into $(tildify "$settings")"
    return
  fi
  mkdir -p "$config"
  printf '%s\n' "$merged" > "$settings.tmp" && mv "$settings.tmp" "$settings"
}

# Only ever removes: new rules wait for a restore you run yourself, so a pull
# can't grant anything and a rule revoked here stays revoked
retire_settings() {
  [ -s "$settings" ] || return 0
  valid_json "$settings" "$settings" || return 1
  local trimmed
  trimmed=$(jq --argjson retired "$(retired_rules)" 'if .permissions.allow then .permissions.allow -= $retired else . end' "$settings")
  [ "$(jq -S . <<< "$trimmed")" = "$(jq -S . "$settings")" ] && return 0
  printf '%s\n' "$trimmed" > "$settings.tmp" && mv "$settings.tmp" "$settings"
}

#
# Skills
#

save_skills() {
  missing_source "$skill_lock" "$skills_list" && return 0
  valid_json "$skill_lock" "$skills_list" || return 0
  {
    echo "# User skills installed with the \`skills\` CLI — see bin/claude-config."
    echo "# skill <name> <source> <agents>"
    # A well-known source (https://host/.well-known/agent-skills) records a
    # bare host in `source`, which `skills add` treats as a git URL and fails
    # to clone; `sourceBaseUrl` keeps the URL as typed
    jq -r '.skills | to_entries[] | "\(.key) \(.value.sourceBaseUrl // .value.source)"' "$skill_lock" | sort \
      | while read -r name source; do
        local agents=()
        [ -e "$config/skills/$name" ] && agents+=(claude-code)
        [ -e "$HOME/.agents/skills/$name" ] && agents+=(codex)
        [ ${#agents[@]} -gt 0 ] || continue
        echo "skill $name $source $(
          IFS=,
          echo "${agents[*]}"
        )"
      done
  } > "$skills_list.tmp" && mv "$skills_list.tmp" "$skills_list"
}

# upstream <name>: prints same or changed by comparing what the skills CLI
# recorded at install with the source now: the git tree SHA of the skill's
# folder on GitHub (skillFolderHash), or for a well-known source the digest its
# site's index.json lists (wellKnownDigest). unknown when it can't check (no gh,
# another source type, a network or API error)
upstream() {
  local entry repo path hash dir tree sha url
  if entry=$(jq -r --arg n "$1" '.skills[$n] | select(.sourceType == "well-known" and (.wellKnownDigest // "") != "")
    | "\(.sourceUrl) \(.wellKnownDigest)"' "$skill_lock" 2> /dev/null) && [ -n "$entry" ]; then
    read -r url hash <<< "$entry"
    # sourceUrl is <site>/.well-known/agent-skills/<name>/skill.md, beside the index
    sha=$(curl -fsSL --max-time 20 "${url%/*/*}/index.json" 2> /dev/null \
      | jq -r --arg n "$1" '.skills[]? | select(.name == $n) | .digest // empty' 2> /dev/null)
    if [ -z "$sha" ]; then echo unknown; elif [ "$sha" = "$hash" ]; then echo same; else echo changed; fi
    return
  fi
  command -v gh > /dev/null \
    && entry=$(jq -r --arg n "$1" '.skills[$n] | select(.sourceType == "github" and .skillFolderHash != null)
      | "\(.source) \(.skillFolderHash) \(.skillPath)"' "$skill_lock" 2> /dev/null) \
    && read -r repo hash path <<< "$entry" && [ -n "$path" ] || {
    echo unknown
    return
  }
  dir=$(dirname "$path")
  # One tree listing per repository, shared by its skills
  tree="$tree_cache/${repo//\//_}"
  [ -s "$tree" ] || gh api "repos/$repo/git/trees/HEAD?recursive=1" > "$tree" 2> /dev/null || {
    rm -f "$tree"
    echo unknown
    return
  }
  sha=$(jq -r --arg d "$dir" 'if $d == "." then .sha else (.tree[] | select(.path == $d and .type == "tree") | .sha) end' "$tree" 2> /dev/null)
  if [ -z "$sha" ]; then echo unknown; elif [ "$sha" = "$hash" ]; then echo same; else echo changed; fi
}

restore_skills() {
  local kind name source agents agent missing before state npx=(npx)
  command -v mise > /dev/null && npx=(mise exec node -- npx)
  tree_cache=$(mktemp -d)
  while read -r kind name source agents; do
    [ "$kind" = skill ] || continue
    # Only the agents that don't have it yet. --update takes them all when the
    # skill changed upstream: the CLI's own `skills update` reinstalls with no
    # agent list, so a skill tracked for one agent would spread to the rest
    missing=()
    for agent in ${agents//,/ }; do
      case $agent in
        claude-code) [ -e "$config/skills/$name" ] || missing+=("$agent") ;;
        codex) [ -e "$HOME/.agents/skills/$name" ] || missing+=("$agent") ;;
      esac
    done
    # One line per skill for upup: skill <same|changed|unknown> <name>
    if [ "$update" = true ]; then
      state=$(upstream "$name")
      echo "skill $state $name"
      # shellcheck disable=SC2206 # agents is a comma list of plain names
      [ "$state" = same ] || missing=(${agents//,/ })
    fi
    [ ${#missing[@]} -gt 0 ] || continue
    # run keeps going after a failure; a skill the source no longer ships is
    # the usual cause, and the fix is on the lock side
    before=$failed failed=0
    DO_NOT_TRACK=1 DISABLE_TELEMETRY=1 run "${npx[@]}" -y skills add "$source" -g -s "$name" -a "${missing[@]}" -y
    [ "$failed" = 0 ] || echo "claude-config: if $source no longer ships $name, drop it: npx -y skills remove -g -s $name -y, then claude-config save" >&2
    [ "$before" = 0 ] || failed=1
  done < <(grep -Ev '^\s*(#|$)' "$skills_list")
}

tildify() {
  # Not ${1/#$HOME/~}: bash 5 tilde-expands that replacement back to $HOME
  [[ $1 == "$HOME" || $1 == "$HOME"/* ]] && printf '~%s' "${1#"$HOME"}" || printf '%s' "$1"
}

case "${1:-}" in
  save)
    mkdir -p "$save_dir"
    save_plugins
    save_settings
    save_skills
    echo "Saved $(grep -c '^plugin ' "$plugins_list") plugins, settings and $(grep -c '^skill ' "$skills_list") skills to $(tildify "$save_dir")"
    ;;
  restore)
    shift
    part=all
    for arg in "$@"; do
      case $arg in
        --dry-run) dry_run=true ;;
        --update) update=true ;;
        plugins | settings | skills) part=$arg ;;
        *)
          echo "claude-config: unknown argument: $arg" >&2
          exit 2
          ;;
      esac
    done
    # Marketplaces and plugins first: settings don't depend on them, but the
    # catalog built afterwards (setup/misc.sh) does
    if [ "$part" = all ] || [ "$part" = plugins ]; then restore_plugins; fi
    if [ "$part" = all ] || [ "$part" = settings ]; then restore_settings; fi
    if [ "$part" = all ] || [ "$part" = skills ]; then restore_skills; fi
    exit "$failed"
    ;;
  retire) retire_settings ;;
  *)
    echo "Usage: claude-config save | retire | restore [plugins|settings|skills] [--dry-run] [--update]" >&2
    exit 2
    ;;
esac
