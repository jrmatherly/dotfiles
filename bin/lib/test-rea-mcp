#!/bin/bash
#
# Self-check for rea-mcp against a fixture Homebrew prefix and mise shim.
#
# - Run it (pnpm check does too); exits 1 naming the first failed assertion:
#
# `test-rea-mcp`
#
# ---
# Never starts REA: HOMEBREW_PREFIX points at a temp dir holding a fixture
# Ghidra keg and JDK, and the mise shim only prints what it was given.
#
# License: MIT

set -euo pipefail

script="$(cd "$(dirname "$0")/.." && pwd -P)/rea-mcp"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

export MISE_DATA_DIR="$tmp/mise" HOMEBREW_PREFIX="$tmp/brew"
unset JAVA_HOME GHIDRA_INSTALL_DIR
mkdir -p "$MISE_DATA_DIR/shims" "$HOMEBREW_PREFIX/opt/ghidra/libexec" "$HOMEBREW_PREFIX/opt/ghidra/bin" \
  "$HOMEBREW_PREFIX/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home/bin"
jdk="$HOMEBREW_PREFIX/opt/openjdk@25/libexec/openjdk.jdk/Contents/Home"
touch "$jdk/bin/java" && chmod +x "$jdk/bin/java"
printf '#!/bin/bash\nJAVA_HOME="${JAVA_HOME:-%s}" exec "%s/libexec/ghidraRun"  "$@"\n' "$jdk" "$HOMEBREW_PREFIX/opt/ghidra" > "$HOMEBREW_PREFIX/opt/ghidra/bin/ghidraRun"
printf '#!/bin/bash\necho "shim: $*"\necho "GHIDRA_INSTALL_DIR=${GHIDRA_INSTALL_DIR:-}"\necho "JAVA_HOME=${JAVA_HOME:-}"\necho "JAVA_HOME_SET=${JAVA_HOME+yes}"\n' > "$MISE_DATA_DIR/shims/rea"
chmod +x "$MISE_DATA_DIR/shims/rea"

fail() {
  echo "test-rea-mcp: $1" >&2
  exit 1
}

out=$("$script" --print-env 2>&1)
[ "$out" = "GHIDRA_INSTALL_DIR=$HOMEBREW_PREFIX/opt/ghidra/libexec
JAVA_HOME=$jdk" ] || fail "resolves the wrapper's JDK: $out"

out=$(JAVA_HOME=/preset "$script" --print-env 2>&1)
grep -q 'JAVA_HOME=/preset has no bin/java' <<< "$out" || fail "warns about a preset JAVA_HOME without java: $out"
grep -qx 'JAVA_HOME=' <<< "$out" || fail "drops the bad preset JAVA_HOME: $out"

mkdir -p "$tmp/other/bin" && touch "$tmp/other/bin/java" && chmod +x "$tmp/other/bin/java"
out=$(JAVA_HOME="$tmp/other" "$script" --print-env 2>&1)
grep -qx "JAVA_HOME=$tmp/other" <<< "$out" || fail "a valid preset JAVA_HOME wins: $out"

out=$("$script" extra --flag 2>&1)
grep -qx 'shim: mcp extra --flag' <<< "$out" || fail "execs the shim with mcp and the arguments: $out"
grep -qx "JAVA_HOME=$jdk" <<< "$out" || fail "the shim sees JAVA_HOME: $out"

printf '#!/bin/bash\nexec run\n' > "$HOMEBREW_PREFIX/opt/ghidra/bin/ghidraRun"
out=$("$script" --print-env 2>&1)
grep -q 'no JAVA_HOME default' <<< "$out" || fail "warns when the wrapper has no default: $out"
grep -qx 'JAVA_HOME=' <<< "$out" || fail "leaves JAVA_HOME unset without a default: $out"
out=$(JAVA_HOME=/preset "$script" 2>&1)
grep -qx 'JAVA_HOME_SET=' <<< "$out" || fail "the shim sees a bad preset JAVA_HOME unset, not empty: $out"

rm -r "$HOMEBREW_PREFIX/opt/ghidra"
out=$("$script" 2>&1)
grep -q 'ghidra not found' <<< "$out" || fail "warns when ghidra is missing: $out"
grep -qx 'shim: mcp' <<< "$out" || fail "still starts REA without ghidra: $out"
grep -qx 'GHIDRA_INSTALL_DIR=' <<< "$out" || fail "sets no GHIDRA_INSTALL_DIR without ghidra: $out"

out=$(HOMEBREW_PREFIX=/nonexistent "$script" --print-env 2>&1) || fail "a prefix without ghidra must not exit non-zero: $out"
grep -q 'ghidra not found' <<< "$out" || fail "warns when the prefix has no ghidra: $out"

echo "test-rea-mcp: ok"
