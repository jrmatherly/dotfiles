#!/bin/bash
#
# Self-check for rotm-modules: the module names, the off list and the list of files mise skips.
#
# - Run it (pnpm check does too); exits 1 naming the first failed assertion:
#
# `test-modules`
#
# ---
# Never touches the real home or mise config: MISE_CONFIG_DIR is a temp dir,
# and every mise call runs with every mise dir in it. Installs nothing.
#
# License: MIT

set -euo pipefail

cd "$(dirname "$0")/../.."

# Print the failed assertion and stop
fail() {
  echo "FAIL: $1" >&2
  exit 1
}

repo=$PWD
tmp=$(cd "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$tmp"' EXIT
cfg="$tmp/cfg"
export MISE_CONFIG_DIR="$cfg"
unset MISE_ENV MISE_IGNORED_CONFIG_PATHS
reset() {
  rm -rf "$cfg"
  mkdir -p "$cfg"
}
reset

m="$repo/bin/lib/rotm-modules"
[ "$("$m" list | tr '\n' ' ')" = "fonts apps vscode claude agents cloud kubernetes devops security network languages media menubar " ] || fail "list"
registry_modules=$(python3 -c 'import sys, tomllib
print(" ".join(s["key"] for s in tomllib.load(open(sys.argv[1], "rb"))["setting"] if s["kind"] == "module"))' settings/registry.toml)
[ "$registry_modules " = "$("$m" list | tr '\n' ' ')" ] || fail "the registry's module rows are not rotm-modules list, in order: $registry_modules"
line() { grep '^ignored_config_paths' "$cfg/miserc.local.toml"; }

# Nothing off: no file, no line, no output. This is every Mac that never ran sync
[ -z "$("$m" sync)" ] || fail "sync with nothing off printed something"
[ -z "$(ls -A "$cfg")" ] || fail "sync with nothing off wrote something"

# Off, and back on
"$m" set security off > "$tmp/out"
[ "$(cat "$cfg/miserc.local.toml")" = 'ignored_config_paths = ["conf.d/60-rotm-security.toml"]' ] || fail "set off on an empty dir"
grep -qx 'modules: off = \[security\]' "$tmp/out" || fail "set off did not say what is off"
[ -z "$("$m" sync)" ] || fail "a second sync printed something"
[ "$("$m" off)" = security ] || fail "off does not list it"
"$m" is-on fonts || fail "is-on fonts"
if "$m" is-on security; then fail "is-on security"; fi
"$m" set security on > /dev/null
[ "$(line)" = 'ignored_config_paths = []' ] || fail "set on left the module ignored"
[ -z "$("$m" off)" ] || fail "set on left the module in the off list"
rc=0
"$m" set security maybe 2> /dev/null || rc=$?
[ "$rc" = 2 ] || fail "set with a third word other than on or off exited $rc"

# Only our entries of the one line change: env, other keys and the user's own ignores stay; a stale module entry goes
reset
printf 'env = ["rotm-installed"]\nignored_config_paths = ["/opt/mine.toml", "conf.d/60-rotm-gone.toml"]\nfoo = 1\n' > "$cfg/miserc.local.toml"
"$m" sync --without fonts,cloud > /dev/null
grep -qxF 'env = ["rotm-installed"]' "$cfg/miserc.local.toml" || fail "sync touched the env line"
"$m" sync > /dev/null
grep -qx 'foo = 1' "$cfg/miserc.local.toml" || fail "sync dropped another key"
[ "$(line)" = 'ignored_config_paths = ["/opt/mine.toml", "conf.d/60-rotm-fonts.toml", "conf.d/60-rotm-cloud.toml"]' ] || fail "the user's entry was not kept first, or a stale one stayed"
[ "$("$m" off | tr '\n' ' ')" = "fonts cloud " ] || fail "--without"

# Unknown names
rc=0
"$m" is-on nope 2> /dev/null || rc=$?
[ "$rc" = 2 ] || fail "is-on with an unknown name exited $rc"
rc=0
"$m" sync --without media,nope 2> "$tmp/err" || rc=$?
[ "$rc" = 2 ] || fail "--without with an unknown name exited $rc"
grep -q nope "$tmp/err" || fail "--without did not name the unknown module"
[ "$("$m" off | tr '\n' ' ')" = "fonts cloud " ] || fail "--without with an unknown name wrote something"
rc=0
"$m" sync --without 2> /dev/null || rc=$?
[ "$rc" = 2 ] || fail "--without with no names exited $rc"
echo typo >> "$cfg/modules-off.local"
"$m" sync 2> "$tmp/err" || fail "a stray name in modules-off.local failed sync"
grep -q 'typo' "$tmp/err" || fail "a stray name was not reported"

# A profile has its own off list, and the line follows the list in effect
reset
printf 'env = ["rotm-p-work"]\n' > "$cfg/miserc.local.toml"
echo cloud > "$cfg/modules-off.local"
echo fonts > "$cfg/modules-off.rotm-p-work.local"
[ "$("$m" off)" = fonts ] || fail "a profile's off list is not the one in effect"
"$m" set media off > /dev/null
[ "$(tr '\n' ' ' < "$cfg/modules-off.rotm-p-work.local")" = "fonts media " ] || fail "set did not change the profile's list"
[ "$(cat "$cfg/modules-off.local")" = cloud ] || fail "set in a profile changed the shared list"
[ "$(line)" = 'ignored_config_paths = ["conf.d/60-rotm-fonts.toml", "conf.d/60-rotm-media.toml"]' ] || fail "the line is not the profile's list: $(line)"
ROTM_SHARED=1 "$m" set network off > /dev/null
[ "$(tr '\n' ' ' < "$cfg/modules-off.local")" = "cloud network " ] || fail "ROTM_SHARED did not change the shared list"
[ "$(tr '\n' ' ' < "$cfg/modules-off.rotm-p-work.local")" = "fonts media " ] || fail "ROTM_SHARED changed the profile's list"
[ "$(line)" = 'ignored_config_paths = ["conf.d/60-rotm-fonts.toml", "conf.d/60-rotm-media.toml"]' ] || fail "a shared change rewrote the profile's line"
sed -i '' 's/^env = .*/env = []/' "$cfg/miserc.local.toml"
"$m" sync > /dev/null
[ "$(line)" = 'ignored_config_paths = ["conf.d/60-rotm-cloud.toml", "conf.d/60-rotm-network.toml"]' ] || fail "leaving the profile did not restore the shared list's line"
# The env line is read as Python reads it: a name in a trailing comment or under a table is not the profile, single quotes are
printf 'env = ["rotm-installed"] # was "rotm-p-work"\n' > "$cfg/miserc.local.toml"
[ "$("$m" off | tr '\n' ' ')" = "cloud network " ] || fail "a profile named only in a comment was used"
printf 'ignored_config_paths = []\n[x]\nenv = ["rotm-p-work"]\n' > "$cfg/miserc.local.toml"
[ "$("$m" off | tr '\n' ' ')" = "cloud network " ] || fail "an env line under a table was used"
printf "env = ['rotm-p-work']\n" > "$cfg/miserc.local.toml"
[ "$("$m" off | tr '\n' ' ')" = "fonts media " ] || fail "a single-quoted profile name was not read"
printf 'env = []\n' > "$cfg/miserc.local.toml"
# A saved profile whose list is not on this Mac: reads use the shared list, a change is refused
sed -i '' 's/^env = .*/env = ["rotm-installed", "rotm-p-gone"]/' "$cfg/miserc.local.toml"
[ "$("$m" off | tr '\n' ' ')" = "cloud network " ] || fail "a profile with no list does not read the shared one"
before=$(cat "$cfg"/*)
rc=0
"$m" set media off 2> "$tmp/err" || rc=$?
[ "$rc" = 1 ] && grep -qF 'modules-off.rotm-p-gone.local' "$tmp/err" || fail "set in a profile with no list exited $rc, or did not name the file"
grep -qF 'rotm settings set --shared' "$tmp/err" || fail "the refusal does not name a way to change the shared list that exists"
[ "$(cat "$cfg"/*)" = "$before" ] || fail "a refused set changed a file"
ROTM_SHARED=1 "$m" set media off > /dev/null
[ "$(tr '\n' ' ' < "$cfg/modules-off.local")" = "cloud network media " ] || fail "ROTM_SHARED with no profile list did not change the shared list"

# A list on several lines, the variable that replaces the saved list, and no config dir
reset
printf 'ignored_config_paths = [\n  "/opt/mine.toml",\n]\n' > "$cfg/miserc.local.toml"
rc=0
"$m" set fonts off 2> "$tmp/err" || rc=$?
[ "$rc" = 1 ] || fail "a multi-line list exited $rc"
grep -q 'one line' "$tmp/err" || fail "a multi-line list was not explained"
[ "$(sed -n 1p "$cfg/miserc.local.toml")" = 'ignored_config_paths = [' ] || fail "a multi-line list was rewritten"
reset
MISE_IGNORED_CONFIG_PATHS=/x "$m" set fonts off 2> "$tmp/err" > /dev/null || fail "set with MISE_IGNORED_CONFIG_PATHS set"
grep -q 'MISE_IGNORED_CONFIG_PATHS' "$tmp/err" || fail "no warning that the variable replaces the saved list"
rc=0
MISE_CONFIG_DIR="$tmp/missing" "$m" set fonts off 2> /dev/null || rc=$?
[ "$rc" = 1 ] || fail "set without a config dir exited $rc"
[ ! -e "$tmp/missing" ] || fail "set created a config dir"

# What mise makes of it: a module's cask is declared unless the module is off
if ! command -v mise > /dev/null; then
  echo "test-modules: mise is not on PATH, skipping the mise cases" >&2
  echo ok
  exit 0
fi
reset
mkdir -p "$cfg/conf.d" "$tmp/misebin" "$tmp/home/.config" "$tmp/nobrew"
ln -s "$(command -v mise)" "$tmp/misebin/mise"
ln -s "$cfg" "$tmp/home/.config/mise"
printf '[bootstrap.packages]\n"brew:jq" = "latest"\n' > "$cfg/conf.d/30-packages.toml"
printf '[bootstrap.packages]\n"brew-cask:font-fira-code" = "latest"\n' > "$cfg/conf.d/60-rotm-fonts.toml"
printf '[bootstrap.packages]\n"brew:nmap" = "latest"\n' > "$cfg/conf.d/60-rotm-security.toml"
# mise with only temp state, from the temp dir; extra VAR=value words go first
smise() {
  (cd "$tmp" && env -i HOME="$tmp/home" TMPDIR="$tmp" PATH="$tmp/misebin:/usr/bin:/bin" \
    MISE_CONFIG_DIR="$cfg" MISE_TRUSTED_CONFIG_PATHS="$cfg" MISE_CEILING_PATHS="$tmp" \
    MISE_SYSTEM_BREW_PREFIX="$tmp/nobrew" \
    MISE_DATA_DIR="$tmp/data" MISE_STATE_DIR="$tmp/state" MISE_CACHE_DIR="$tmp/cache" "$@")
}
declared() { smise "$@" mise bootstrap packages status --json 2> /dev/null; }
declared | grep -q '"jq"' || fail "mise: the base's formula is not declared"
declared | grep -q font-fira-code || fail "mise: a module with no state does not declare its cask"
declared MISE_ENV=dev | grep -q font-fira-code || fail "mise: MISE_ENV dropped a module"
# The helper runs inside smise from here on, through the ~/.config/mise link as on a real Mac, so its mise trust writes scratch state
rotm() { smise MISE_CONFIG_DIR= "$m" "$@"; }
rotm set fonts off > /dev/null
declared | grep -q '"jq"' || fail "mise: the base's formula went with the module"
if declared | grep -q font-fira-code; then fail "mise: a module that is off still declares its cask"; fi
if declared MISE_ENV=dev | grep -q font-fira-code; then fail "mise: MISE_ENV brought an off module back"; fi
if declared MISE_CONFIG_DIR= | grep -q font-fira-code; then fail "mise: an off module loads through the ~/.config/mise link"; fi
declared MISE_CONFIG_DIR= | grep -q nmap || fail "mise: the link case loaded no module at all"

# Dotfiles and bootstrap work with a module off because sync had mise trust the file
smise MISE_CONFIG_DIR= mise dotfiles status > "$tmp/dot.out" 2>&1 || {
  cat "$tmp/dot.out" >&2
  fail "mise: dotfiles status with a module off"
}
# Without that record mise refuses the ignored file. When this fails, mise is fixed: drop the mise trust call from rotm-modules and setup.sh's second sync
if smise MISE_CONFIG_DIR= MISE_STATE_DIR="$tmp/state-untrusted" mise dotfiles status > "$tmp/dot.out" 2>&1; then
  fail "mise: dotfiles status passes with an ignored file and no trust record, so the mise trust workaround can go"
fi
grep -q 'not trusted' "$tmp/dot.out" || fail "mise: dotfiles status failed for another reason: $(head -1 "$tmp/dot.out")"

# Two mise behaviours the design rests on: the variable replaces the saved list, and --save-env keeps the line
declared MISE_IGNORED_CONFIG_PATHS="$cfg/conf.d/60-rotm-security.toml" > "$tmp/var.json"
grep -q font-fira-code "$tmp/var.json" || fail "mise: MISE_IGNORED_CONFIG_PATHS no longer replaces the saved list"
if grep -q nmap "$tmp/var.json"; then fail "mise: MISE_IGNORED_CONFIG_PATHS did not ignore its own file"; fi
before=$(line)
smise MISE_CONFIG_DIR= mise -E rotm-installed bootstrap --save-env --only final-hook --yes > "$tmp/save.out" 2>&1 || {
  cat "$tmp/save.out" >&2
  fail "mise: bootstrap --save-env"
}
grep -q '^env = \["rotm-installed"\]' "$cfg/miserc.local.toml" || fail "mise: --save-env did not save the env list"
[ "$(line)" = "$before" ] || fail "mise: --save-env changed the ignored_config_paths line"

rotm set fonts on > /dev/null
declared | grep -q font-fira-code || fail "mise: a module switched back on does not declare its cask"

# The tracked fragments with one module off. Dropped from the copies: the [tools] tables (status would resolve every tool
# from the network) and the taps with their six packages (mise clones a tap and needs Ruby 3+ to read it; check.yml's dry run covers them)
real="$tmp/real"
mkdir -p "$real/conf.d"
for f in "$repo"/tilde/.config/mise/conf.d/30-packages.toml "$repo"/tilde/.config/mise/conf.d/60-rotm-*.toml; do
  awk '/^\[(tools|bootstrap\.brew\.taps)\]/{skip=1; next} /^\[/{skip=0} !skip' "$f" \
    | grep -vE '^"brew(-cask)?:[^"/]+/[^"/]+/' > "$real/conf.d/$(basename "$f")"
done
tracked() { smise MISE_CONFIG_DIR="$real" MISE_TRUSTED_CONFIG_PATHS="$real" "$@"; }
if ! tracked mise bootstrap packages status --json > "$tmp/all.json" 2> "$tmp/all.err"; then
  cat "$tmp/all.err" >&2
  fail "mise: status of the tracked fragments"
fi
all=$(jq '[.brew.packages[], ."brew-cask".packages[]] | length' "$tmp/all.json")
[ "$all" = 171 ] || fail "every module on declares $all formulae and casks outside the taps, not 171"
tracked "$m" set security off > /dev/null
tracked mise bootstrap packages status --json > "$tmp/s.json" 2> /dev/null || fail "mise: status with security off"
for p in nmap hydra ghidra; do
  if jq -e --arg p "$p" '.brew.packages[] | select(.package == $p)' "$tmp/s.json" > /dev/null; then
    fail "security is off and $p is still declared"
  fi
done
jq -e '.brew.packages[] | select(.package == "git")' "$tmp/s.json" > /dev/null || fail "the base lost git"

echo ok
