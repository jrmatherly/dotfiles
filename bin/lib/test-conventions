#!/bin/bash
#
# Tree invariants the docs promise; run by pnpm check.
#
# - Run it (pnpm check does too); exits 1 naming the first broken invariant:
#
# `test-conventions`
#
# ---
# Checks the telemetry pairing (setup.sh exports a subset of zsh/env.zsh's),
# that Prettier ignores every zsh file, that every bin/ script's header renders
# through help (a header comment on line 2 without tldr), that help cleans up its
# temp pages, refuses a directory and keeps docs/gui when run through a symlink,
# that the VS Code template pins no mise path, and that git keeps
# its default file protocol policy and curl its own user agent and no referer,
# that the tracked Claude Code permissions ask before curl and gh api and
# deny credential paths, git add -f and VS Code's private state, that no allow
# rule is also retired, that rtk's hook rewrites no command with a Bash ask rule,
# that every setup/*.sh is executable, that nothing calls brew, and that the
# instruction files stay under their caps.
#
# License: MIT

set -euo pipefail

cd "$(dirname "$0")/../.."

fail() {
  echo "FAIL: $1" >&2
  exit 1
}

while IFS= read -r name; do
  grep -q "^export $name=" zsh/env.zsh || fail "telemetry: $name missing from zsh/env.zsh"
done < <(sed -nE 's/^export ([A-Z_]*(TELEMETRY|OPTOUT|DO_NOT_TRACK)[A-Z_]*)=.*/\1/p' setup.sh)

for file in tilde/.zshenv tilde/.zprofile tilde/.zshrc zsh/*.zsh; do
  node_modules/.bin/prettier --file-info "$file" | jq -e .ignored > /dev/null \
    || fail "zsh prettier-ignored: $file"
done

# tlrc rejects a page with a wrapped line, so render every header through help;
# without tldr (the CI runner), only check that a header comment starts on line 2
have_tldr=false
if command -v tldr > /dev/null; then have_tldr=true; else
  echo "test-conventions: tldr not found, skipping the help render check" >&2
fi
# Each render must also remove the temp dir its page was written to (find,
# not ls: with no tldr-* dirs, as on CI, ls fails and pipefail ends the script)
before=$(find "${TMPDIR:-/tmp}/" -maxdepth 1 -name "tldr-*" | wc -l)
for file in bin/*; do
  [[ -f $file && $file != bin/CLAUDE.md ]] || continue
  if [ "$have_tldr" = true ]; then
    bin/help "${file#bin/}" > /dev/null 2>&1 || fail "help render: $file"
  else
    sed -n 2p "$file" | grep -qE '^(#|//)' || fail "bin headers: $file"
  fi
done
[ "$(find "${TMPDIR:-/tmp}/" -maxdepth 1 -name "tldr-*" | wc -l)" -le "$before" ] || fail "help leaves temp dirs"
bin/help lib > /dev/null 2>&1 && fail "help lib should fail cleanly" || true

# help reached through a symlink (~/dotfiles) while $DOTFILES names the real
# path must render a docs page, never delete its folder. Run against a scratch
# copy, so a regression only ever deletes the copy's docs/gui
if command -v node > /dev/null; then
  scratch=$(mktemp -d)
  mkdir "$scratch/real"
  cp -R bin docs "$scratch/real/"
  mkdir "$scratch/real/tilde" && cp tilde/.tlrc.toml "$scratch/real/tilde/"
  ln -s "$scratch/real" "$scratch/link"
  page=$(ls docs/gui | head -1)
  DOTFILES="$(cd "$scratch/real" && pwd -P)" "$scratch/link/bin/help" "gui/${page%.md}" > /dev/null 2>&1 || true
  [ -f "$scratch/real/docs/gui/$page" ] || {
    rm -rf "$scratch"
    fail "help through a symlink deleted docs/gui"
  }
  rm -rf "$scratch"
else
  echo "test-conventions: node not found, skipping the help symlink check" >&2
fi

# mise is at ~/.local/bin on a new Mac and at /opt/homebrew/bin before migration:
# the extension's default finds it on PATH, a pinned path is wrong on one of them
! grep -n '"mise.binPath"' vscode/User/settings.json.j2 || fail "the VS Code template pins mise to a path"

# CVE-2022-39253: a malicious repo's file:// submodule can read local files
! grep -qE '^[[:space:]]*allow[[:space:]]*=[[:space:]]*always' tilde/.gitconfig || fail "gitconfig: protocol.file.allow = always (CVE-2022-39253)"

! grep -qE '^(user-agent|referer)' tilde/.curlrc || fail "curlrc: spoofed user-agent or auto referer"

# tput fails with TERM unset (CI, a launchd job), which aborts a set -e script;
# each setup script shadows it with a guarded wrapper
for file in setup/packages.sh setup/zsh.sh setup/misc.sh; do
  grep -qF 'tput() { command tput "$@" 2> /dev/null || true; }' "$file" || fail "unguarded tput: $file"
done

# Network fetches ask, credential paths and force-adds are denied.
# rules <file> <list> <want: present|absent> <rule>...
rules() {
  local file=$1 list=$2 want=$3 r
  shift 3
  for r in "$@"; do
    jq -e --arg r "$r" ".permissions.$list | index(\$r) $([ "$want" = present ] && echo '!=' || echo '==') null" "$file" > /dev/null \
      || fail "$file $list: $r should be $want"
  done
}
rules agents/claude-settings.json allow absent 'Bash(curl:*)' 'Bash(gh api:*)' 'WebFetch' 'Bash(gh issue:*)' 'Bash(git remote *)'
rules agents/claude-settings.json deny present 'Read(~/.ssh/**)' 'Read(~/.aws/**)' 'Read(~/.config/gh/hosts.yml)' \
  'Read(**/.env)' 'Read(**/.env.*)' 'Read(!.env.example)' 'Bash(git add -f*)' 'Bash(git add --force*)'
# a gitignore negation only carves out of the deny rules listed before it
jq -e '.permissions.deny | index("Read(!.env.example)") > index("Read(**/.env.*)")' agents/claude-settings.json > /dev/null \
  || fail "agents/claude-settings.json deny: Read(!.env.example) must follow Read(**/.env.*)"
# restore and save would silently drop it
both=$(grep -v '^#' agents/claude-permissions-retired.txt | jq -Rnc --slurpfile s agents/claude-settings.json '[inputs] as $r | $s[0].permissions.allow | map(select(IN($r[])))')
[ "$both" = '[]' ] || fail "agents/claude-settings.json allows retired rules: $both"
# a single leading / anchors at the project root in project settings
rules .claude/settings.json deny present 'Read(/vscode/User/History/**)' 'Read(/vscode/User/workspaceStorage/**)' \
  'Read(/vscode/User/globalStorage/**)'
# sysup and set-defaults change the machine: every way to start them asks,
# `bash bin/sysup` included (it once ran unasked)
for s in sysup set-defaults; do
  rules .claude/settings.json ask present "Bash($s *)" "Bash(bin/$s*)" "Bash(./bin/$s*)" "Bash(*/bin/$s*)" \
    "Bash(bash bin/$s*)" "Bash(sh bin/$s*)"
done

# Hooks and setup.sh run these directly, and a test that runs `bash "$script"` cannot see a missing mode bit.
# :(glob) keeps * from crossing a slash, so setup/tests/*.sh (run with bash) is not matched.
notexec=$(git ls-files -s ':(glob)setup/*.sh' | awk '$1 != "100755" { print $4 }')
[ -z "$notexec" ] || fail "setup scripts must be executable (chmod +x): $notexec"

# D5: nothing in setup, sysup, shell startup or CI runs brew. Comment lines,
# bin/CLAUDE.md's prose and the fixture text of Homebrew's own script
# (test-ca-roots) are not callers.
# migrate/ and its test are the one place that knows the old layout (Part B)
callers=$(grep -nE '(^|[^[:alnum:]_/.-])brew[[:space:]]+(install|update|upgrade|bundle|cleanup|doctor|outdated|shellenv|trust|autoremove|uninstall|list|info|cat|--prefix)' \
  setup.sh setup/*.sh bin/* bin/lib/* zsh/*.zsh tilde/.zprofile tilde/.zshrc tilde/.zshenv .github/workflows/*.yml 2> /dev/null \
  | grep -vE '^[^:]+:[0-9]+:[[:space:]]*#' | grep -vE '^(bin/CLAUDE\.md|bin/lib/test-ca-roots|bin/lib/test-migrate|migrate/[^:]*):' || true)
[ -z "$callers" ] || fail "a brew command is still called: $callers"

# rtk's hook rewrites a command before Claude Code matches rules, so `curl x` as
# `rtk curl x` skips `Bash(curl *)`. rtk leaves a deny match alone by itself, but
# not an ask match. A scratch HOME tests the tracked config, not the live one.
# Rules holding a path name scripts, not tools, and rules starting with * have no
# command to probe, so neither is checked. rtk rewrites many tools only by
# subcommand (`git status`, not `git x`), so a whole-tool rule gets several probes
if command -v rtk > /dev/null; then
  scratch=$(mktemp -d)
  trap 'rm -rf "$scratch"' EXIT
  mkdir -p "$scratch/Library/Application Support/rtk"
  cp rtk/config.toml "$scratch/Library/Application Support/rtk/"
  # With no rtk rewrite to compare against, every probe below would pass
  [ -n "$(HOME="$scratch" rtk rewrite "git status" 2> /dev/null || true)" ] || fail "rtk rewrite no longer rewrites git status"
  probed=0
  while IFS= read -r command; do
    probed=$((probed + 1))
    args="x status list get ps test build push"
    [[ $command != *" "* ]] || args=x
    for arg in $args; do
      rewritten=$(HOME="$scratch" rtk rewrite "$command $arg" 2> /dev/null || true)
      [ -z "$rewritten" ] || fail "rtk rewrites '$command $arg' to '$rewritten', so its ask rule never matches: add the command to rtk/config.toml"
    done
  done < <(jq -r '.permissions.ask // [] | .[] | select(startswith("Bash(")) | .[5:-1] | split("*")[0] | rtrimstr(" ") | rtrimstr(":") | select(length > 0 and (contains("/") | not))' agents/claude-settings.json .claude/settings.json)
  [ "$probed" -gt 0 ] || fail "no Bash ask rules found to probe against rtk"
else
  echo "test-conventions: rtk not found, skipping the rewrite check" >&2
fi

# Instruction files load into agent context, and each change used to append to
# them (bin/CLAUDE.md grew 8.6 KB in four days). A long catch-all line is what
# invites that, so cap both: past a limit, delete restated text or scope a rule
size_limit() {
  local max=$1 file bytes
  shift
  for file in "$@"; do
    bytes=$(wc -c < "$file" | tr -d ' ')
    [ "$bytes" -le "$max" ] || fail "$file is $bytes bytes, over $max: trim it or move it to a path-scoped rule"
  done
}
size_limit 12000 CLAUDE.md
size_limit 8000 bin/CLAUDE.md
size_limit 6000 .claude/rules/*.md tilde/.claude/rules/*.md .claude/agents/*.md .claude/skills/*/SKILL.md tilde/.claude/skills/*/SKILL.md
long=$(awk -v max=1000 'length($0) > max { print FILENAME ":" FNR " (" length($0) ")" }' CLAUDE.md bin/CLAUDE.md .claude/rules/*.md tilde/.claude/rules/*.md)
[ -z "$long" ] || fail "instruction lines over 1000 bytes: $long"

echo "conventions: all checks passed"
