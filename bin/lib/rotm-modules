#!/bin/bash
#
# Name the returnofthemac modules, keep the list of those switched off, and write mise's env list from it.
#
# - List every module:
#
# `rotm-modules list`
#
# - List the modules that are off:
#
# `rotm-modules off`
#
# - Exit 0 when a module is on, 1 when it is off:
#
# `rotm-modules is-on {{module}}`
#
# - Turn a module on or off:
#
# `rotm-modules set {{module}} {{on|off}}`
#
# - Rewrite mise's env list, first turning some modules off:
#
# `rotm-modules sync --without {{fonts,cloud}}`
#
# ---
# A module is tilde/.config/mise/config.rotm-<name>.toml, loaded only while
# the env list in miserc.local.toml names rotm-<name>. The stored truth is the
# off list (modules-off.local): env is derived as every module minus those, so
# a module that arrives in an update is on for everyone. The env entries carry
# the rotm- prefix because a saved env name also selects mise.<name>.toml in
# every project on the Mac. Callers run this by path, never through PATH, so a
# test fixture uses its own copy. Exits 2 for a name that is not a module.
#
# License: MIT

set -euo pipefail

modules=(fonts apps vscode claude agents cloud kubernetes devops security network languages media)
dir="${MISE_CONFIG_DIR:-$HOME/.config/mise}"
off_file="$dir/modules-off.local"
rc_file="$dir/miserc.local.toml"

die() {
  echo "rotm-modules: $2" >&2
  exit "$1"
}

need_known() {
  local m
  for m in "${modules[@]}"; do
    if [ "$m" = "$1" ]; then return 0; fi
  done
  die 2 "no module named '$1' (modules: ${modules[*]})"
}

is_off() { [ -f "$off_file" ] && grep -qxF -- "$1" "$off_file"; }

# Replace a file in the config dir with stdin, through a temp file so a failed run leaves the old one
replace() {
  [ -d "$dir" ] || die 1 "no mise config dir at $dir"
  local t
  t=$(mktemp "$dir/.rotm-modules.XXXXXX")
  cat > "$t"
  mv "$t" "$1"
}

# Rewrite the off list: the modules already off, plus or minus one, in list order
write_off() {
  local m
  for m in "${modules[@]}"; do
    if [ "$m" = "$1" ]; then
      [ "$2" = on ] || echo "$m"
    elif is_off "$m"; then
      echo "$m"
    fi
  done | replace "$off_file"
}

sync() {
  [ -d "$dir" ] || die 1 "no mise config dir at $dir"
  local line='' entries='' inner part m stray
  if [ -f "$off_file" ]; then
    while IFS= read -r stray; do
      case " ${modules[*]} " in
        *" $stray "*) ;;
        *) [ -z "$stray" ] || echo "rotm-modules: '$stray' in $off_file is not a module, ignored" >&2 ;;
      esac
    done < "$off_file"
  fi
  if [ -n "${MISE_ENV:-}" ]; then
    echo "rotm-modules: MISE_ENV is set ($MISE_ENV), and mise uses it in place of the saved list: no module loads in this shell" >&2
  fi

  if [ -f "$rc_file" ] && grep -qE '^env[[:space:]]*=' "$rc_file"; then
    line=$(grep -E '^env[[:space:]]*=[[:space:]]*\[.*\][[:space:]]*$' "$rc_file" | head -1) \
      || die 1 "the env list in miserc.local.toml is not on one line; not rewriting $rc_file"
    inner=$(sed -E 's/^[^[]*\[(.*)\][[:space:]]*$/\1/' <<< "$line")
    # Entries that are not ours (installed, a profile) stay first, in their order
    while IFS= read -r part; do
      part=$(sed -E 's/^[[:space:]]+|[[:space:]]+$//g' <<< "$part")
      case $part in '' | '"rotm-'*) continue ;; esac
      entries="$entries${entries:+, }$part"
    done < <(tr ',' '\n' <<< "$inner")
  fi
  for m in "${modules[@]}"; do
    is_off "$m" || entries="$entries${entries:+, }\"rotm-$m\""
  done

  local new="env = [$entries]"
  [ "$new" != "$line" ] || return 0
  if [ -n "$line" ]; then
    NEW="$new" awk '!done && /^env[[:space:]]*=/ { print ENVIRON["NEW"]; done = 1; next } { print }' "$rc_file"
  else
    if [ -f "$rc_file" ]; then cat "$rc_file"; fi
    echo "$new"
  fi | replace "$rc_file"
  echo "modules: $new"
}

case "${1:-}" in
  list)
    printf '%s\n' "${modules[@]}"
    ;;
  off)
    for m in "${modules[@]}"; do
      if is_off "$m"; then echo "$m"; fi
    done
    ;;
  is-on)
    need_known "${2:-}"
    ! is_off "$2"
    ;;
  set)
    need_known "${2:-}"
    case "${3:-}" in on | off) ;; *) die 2 "set takes on or off, not '${3:-}'" ;; esac
    write_off "$2" "$3"
    sync
    ;;
  sync)
    if [ "${2:-}" = --without ]; then
      [ -n "${3:-}" ] || die 2 "--without takes module names, as in --without fonts,cloud"
      IFS=, read -ra without <<< "$3"
      for m in "${without[@]}"; do need_known "$m"; done
      for m in "${without[@]}"; do write_off "$m" off; done
    elif [ $# -gt 1 ]; then
      die 2 "sync takes --without <a,b> or nothing"
    fi
    sync
    ;;
  *)
    die 2 "usage: rotm-modules list | off | is-on <module> | set <module> on|off | sync [--without <a,b>]"
    ;;
esac
