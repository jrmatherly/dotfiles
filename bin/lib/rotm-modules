#!/bin/bash
#
# Name the returnofthemac modules, keep the list of those switched off, and tell mise which to skip.
#
# - List every module:
#
# `rotm-modules list`
#
# - List the modules that are off:
#
# `rotm-modules off`
#
# - Exit 0 when a module is on, 1 when it is off:
#
# `rotm-modules is-on {{module}}`
#
# - Turn a module on or off:
#
# `rotm-modules set {{module}} {{on|off}}`
#
# - Rewrite the list of modules mise skips, first turning some off:
#
# `rotm-modules sync --without {{fonts,cloud}}`
#
# ---
# A module is tilde/.config/mise/conf.d/60-rotm-<name>.toml, which mise always
# loads unless ignored_config_paths in miserc.local.toml names it. The stored
# truth is the off list (modules-off.local) and that line is derived from it,
# so a Mac with no state loads every module and one that arrives in an update
# is on for everyone. The paths are relative to the miserc's dir because only
# that form matches however mise reached the config dir (through the
# ~/.config/mise link or by its real path). Callers run this by path, never
# through PATH, so a test fixture uses its own copy. Exits 2 for a name that
# is not a module.
#
# License: MIT

set -euo pipefail

modules=(fonts apps vscode claude agents cloud kubernetes devops security network languages media)
dir="${MISE_CONFIG_DIR:-$HOME/.config/mise}"
off_file="$dir/modules-off.local"
rc_file="$dir/miserc.local.toml"

die() {
  echo "rotm-modules: $2" >&2
  exit "$1"
}

need_known() {
  local m
  for m in "${modules[@]}"; do
    if [ "$m" = "$1" ]; then return 0; fi
  done
  die 2 "no module named '$1' (modules: ${modules[*]})"
}

is_off() { [ -f "$off_file" ] && grep -qxF -- "$1" "$off_file"; }

# Replace a file in the config dir with stdin, through a temp file so a failed run leaves the old one
replace() {
  [ -d "$dir" ] || die 1 "no mise config dir at $dir"
  local t
  t=$(mktemp "$dir/.rotm-modules.XXXXXX")
  cat > "$t"
  mv "$t" "$1"
}

# Rewrite the off list: the modules already off, plus or minus one, in list order
write_off() {
  local m
  for m in "${modules[@]}"; do
    if [ "$m" = "$1" ]; then
      [ "$2" = on ] || echo "$m"
    elif is_off "$m"; then
      echo "$m"
    fi
  done | replace "$off_file"
}

# The entries of a one-line TOML list that do not match a glob, joined with ", ".
# The glob is matched after the entry's opening quote: bash 3.2 does not match a quote held in a pattern variable
# shortcut: splits on commas, so an entry that holds one breaks; parse the TOML if a path ever does
kept() {
  local inner part out=''
  inner=$(sed -E 's/^[^[]*\[(.*)\][[:space:]]*$/\1/' <<< "$1")
  while IFS= read -r part; do
    part=$(sed -E 's/^[[:space:]]+|[[:space:]]+$//g' <<< "$part")
    # shellcheck disable=SC2254 # $2 is a glob on purpose
    case ${part#\"} in '' | $2) continue ;; esac
    out="$out${out:+, }$part"
  done < <(tr ',' '\n' <<< "$inner")
  echo "$out"
}

sync() {
  [ -d "$dir" ] || die 1 "no mise config dir at $dir"
  local line='' entries='' names='' new='' trust='' have='' want m stray
  if [ -f "$off_file" ]; then
    while IFS= read -r stray; do
      case " ${modules[*]} " in
        *" $stray "*) ;;
        *) [ -z "$stray" ] || echo "rotm-modules: '$stray' in $off_file is not a module, ignored" >&2 ;;
      esac
    done < "$off_file"
  fi
  if [ -n "${MISE_IGNORED_CONFIG_PATHS:-}" ]; then
    echo "rotm-modules: MISE_IGNORED_CONFIG_PATHS is set, and mise uses it in place of the saved list: a module that is off still loads in this shell" >&2
  fi

  if [ -f "$rc_file" ]; then
    have=$(cat "$rc_file")
    if grep -qE '^ignored_config_paths[[:space:]]*=' "$rc_file"; then
      line=$(grep -E '^ignored_config_paths[[:space:]]*=[[:space:]]*\[.*\][[:space:]]*$' "$rc_file" | head -1) \
        || die 1 "the ignored_config_paths list in miserc.local.toml is not on one line; not rewriting $rc_file"
      # The user's own entries stay first, in their order
      entries=$(kept "$line" 'conf.d/60-rotm-*')
    fi
  fi
  for m in "${modules[@]}"; do
    if is_off "$m"; then
      entries="$entries${entries:+, }\"conf.d/60-rotm-$m.toml\""
      names="$names${names:+, }$m"
      if [ -z "$trust" ] && [ -f "$dir/conf.d/60-rotm-$m.toml" ]; then trust="$dir/conf.d/60-rotm-$m.toml"; fi
    fi
  done
  # With nothing off and no line there is nothing to write: no state means every module loads
  if [ -n "$line" ] || [ -n "$entries" ]; then new="ignored_config_paths = [$entries]"; fi

  # mise's dotfiles history still reads an ignored file and refuses it as untrusted, which stops
  # `mise dotfiles` and `mise bootstrap` (mise 2026.11.5 to 2026.11.7). Trusting one module file
  # records the home dir as a trusted config root, and that covers every module file.
  # test-modules fails when mise no longer needs this
  if [ -n "$trust" ] && command -v mise > /dev/null; then
    mise trust "$trust" > /dev/null 2>&1 \
      || echo "rotm-modules: 'mise trust $trust' failed, so mise dotfiles and mise bootstrap will stop at that file" >&2
  fi

  want=$({ [ -z "$have" ] || printf '%s\n' "$have"; } | IGN="$new" awk '
    !i && /^ignored_config_paths[[:space:]]*=/ { print ENVIRON["IGN"]; i = 1; next }
    { print }
    END { if (!i && ENVIRON["IGN"] != "") print ENVIRON["IGN"] }')
  [ "$want" != "$have" ] || return 0
  printf '%s' "${want:+$want
}" | replace "$rc_file"
  echo "modules: off = [$names]"
}

case "${1:-}" in
  list)
    printf '%s\n' "${modules[@]}"
    ;;
  off)
    for m in "${modules[@]}"; do
      if is_off "$m"; then echo "$m"; fi
    done
    ;;
  is-on)
    need_known "${2:-}"
    ! is_off "$2"
    ;;
  set)
    need_known "${2:-}"
    case "${3:-}" in on | off) ;; *) die 2 "set takes on or off, not '${3:-}'" ;; esac
    write_off "$2" "$3"
    sync
    ;;
  sync)
    if [ "${2:-}" = --without ]; then
      [ -n "${3:-}" ] || die 2 "--without takes module names, as in --without fonts,cloud"
      IFS=, read -ra without <<< "$3"
      for m in "${without[@]}"; do need_known "$m"; done
      for m in "${without[@]}"; do write_off "$m" off; done
    elif [ $# -gt 1 ]; then
      die 2 "sync takes --without <a,b> or nothing"
    fi
    sync
    ;;
  *)
    die 2 "usage: rotm-modules list | off | is-on <module> | set <module> on|off | sync [--without <a,b>]"
    ;;
esac
