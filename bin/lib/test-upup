#!/bin/bash
#
# Self-check for upup's report against stubbed tools.
#
# - Run it (pnpm check does too); exits 1 naming the first failed assertion:
#
# `test-upup`
#
# ---
# Never upgrades anything: every external command upup calls is a stub on
# PATH, HOME is a temp dir, DOTFILES a throwaway git repo and CLAUDE_CONFIG_DIR
# a fixture.
#
# License: MIT

set -euo pipefail

script="$(cd "$(dirname "$0")/.." && pwd -P)/upup"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

# mise shims (jq) refuse the global config under a fake HOME unless mise's
# trust records stay in the real state dir
export MISE_STATE_DIR="${MISE_STATE_DIR:-$HOME/.local/state/mise}"
# A scratch HOME: upup's rm of a stale REA skill link must never reach the real one.
# HOMEBREW_PREFIX points nowhere so upup's by-path rustup falls back to the stub
export HOME="$tmp/home" DOTFILES="$tmp/dotfiles" CLAUDE_CONFIG_DIR="$tmp/claude" STATE="$tmp/state" HOMEBREW_PREFIX="$tmp/nobrew"
unset DOTFILES_MAC_PASSWORD_OP
mkdir -p "$HOME" "$DOTFILES/agents" "$CLAUDE_CONFIG_DIR/plugins" "$STATE" "$tmp/bin"
printf 'skill one src claude-code\nskill two src claude-code\n' > "$DOTFILES/agents/claude-skills.txt"
git -C "$DOTFILES" init -q
git -C "$DOTFILES" add -A
git -C "$DOTFILES" -c user.name=t -c user.email=t@t -c commit.gpgsign=false commit -qm init
# Left uncommitted by an earlier run: not a change this run made
echo "# uncommitted" >> "$DOTFILES/agents/claude-skills.txt"
printf '{"plugins":{"alpha@m":[],"beta@m":[]}}' > "$CLAUDE_CONFIG_DIR/plugins/installed_plugins.json"

# Each stub reads a flag file in $STATE to pick the "something changed" branch
stub() {
  printf '#!/bin/bash\n%s\n' "$2" > "$tmp/bin/$1"
  chmod +x "$tmp/bin/$1"
}
stub sudo '[ "$1" = -v ] && exit 0; exec "$@"'
stub dotfiles '[ -e "$STATE/pull" ] && git -C "$DOTFILES" -c user.name=t -c user.email=t@t -c commit.gpgsign=false commit -q --allow-empty -m "Pulled change"; echo pulled'
stub softwareupdate 'case $1 in
  -l) [ -e "$STATE/macos" ] || [ -e "$STATE/macos-os" ] || echo "No new software available."
    [ ! -e "$STATE/macos" ] || printf "* Label: Safari 99.1\n\tTitle: Safari, Version: 99.1, Recommended: YES, \n"
    [ ! -e "$STATE/macos-os" ] || printf "* Label: macOS 27.2-26B123\n\tTitle: macOS 27.2, Version: 27.2, Recommended: YES, Action: restart, \n" ;;
  *) [ -e "$STATE/macos-fails" ] && { echo "install failed"; exit 1; }
    case "$*" in *--stdinpass*) read -r pw; [ "$pw" = secret ] || { echo "wrong password"; exit 1; } ;; esac
    echo "Downloaded: macOS 27.2" ;;
esac'
stub brew 'case $1 in
  outdated) [ -e "$STATE/brew" ] && printf "gh\ncodex\n" ;;
  upgrade) echo "==> Upgrading gh"; echo "==> Caveats"; echo "zsh completions have been installed to:"; echo "  /opt/homebrew/share/zsh/site-functions"
    echo "==> gh"; echo "Run gh auth login to use it."; echo "Second line"
    echo "==> uv"; echo "The following uv executables are shadowed by commands in $HOME/.local/share/mise/shims:"; echo uv; echo uvx; echo "Running these by name will not invoke the version provided by Homebrew"
    echo "==> Upgrading codex"; echo "  0.164.0 -> 0.165.0"; echo "==> Upgraded 1 outdated package"; echo "gh       2.103.1  -> 2.103.2" ;;
  cleanup) echo "==> This operation has freed approximately 29.5MB of disk space." ;;
  doctor) [ -e "$STATE/brew-doctor" ] || { echo "Your system is ready to brew."; exit 0; }
    printf "Please note that these warnings are just used to help the Homebrew maintainers\n\nWarning: Some installed formulae or casks are missing dependencies:\n  gcloud-cli: python@3.13\n\nYou should `brew install` the missing dependencies:\n  brew install python@3.13\n\nWarning: You have unlinked kegs in your Cellar.\nLeaving kegs unlinked can lead to build-trouble. Run `brew link` on these:\n  openssl@3\n  python@3.12\n"; exit 1 ;;
esac
exit 0'
stub mise 'case $1 in
  ls) if [ -e "$STATE/prune" ]; then
      echo "{\"node\":[{\"version\":\"24.0.0\",\"install_path\":\"$STATE/installs/node/24.0.0\"}],\"github:microsoft/aspire\":[{\"version\":\"13.6.0\",\"install_path\":\"$STATE/installs/aspire/13.6.0\"}],\"npm:node\":[{\"version\":\"1.0.0\",\"install_path\":\"$STATE/installs/npm-node/1.0.0\"},{\"version\":\"2.0.0\",\"install_path\":\"$STATE/installs/npm-node/2.0.0\"}]}"
    else echo "{}"; fi ;;
  prune) case "$*" in *--yes*) ;; *) echo "mise ERROR mise prune requires confirmation but there was nobody to ask"; exit 1 ;; esac
    [ -e "$STATE/prune-fails" ] && { echo "mise ERROR uninstall failed"; exit 1; }; rm -rf "$STATE/installs" "$STATE/prune" ;;
  upgrade) if [ -e "$STATE/mise" ]; then
      printf "Upgraded 3 tools:\n  node 24.1.0 → 24.1.1\n  github:microsoft/aspire 13.6.1 → 13.6.2\n  npm:tsc 5.8.0 → 5.8.1\n  npm:tsc 6.0.0 → 6.0.1\n"
      echo "mise WARN  newer github:microsoft/aspire release 13.6.3 (released 2026-10-23, eligible 2026-10-24 14:17 EDT) ignored by minimum_release_age (24h); latest eligible release is 13.6.2"
      echo "mise WARN  failed to reinstall pipx tools: ~/.local/share/mise/shims/uv exited with non-zero status: exit code 2"
    fi ;;
  *) exit 1 ;;
esac'
stub rustup 'if [ -e "$STATE/rust" ]; then
  echo "  stable-aarch64-apple-darwin updated - rustc 1.99.1 (58cf8f9c3 2026-10-13) (from rustc 1.99.0 (b940084d7 2026-09-28))"
else echo "  stable-aarch64-apple-darwin unchanged - rustc 1.99.1 (58cf8f9c3 2026-10-13)"; fi'
stub uv 'if [ -e "$STATE/uv" ]; then
  echo "Updated serena-agent v0.1.4 -> v0.1.5"; echo " - serena-agent==0.1.4"; echo " + serena-agent==0.1.5"
  echo "Installed 3 executables: index-project, serena, serena-mcp-server"
  echo "Modified scrapling environment"; echo " - sse-starlette==3.5.0"; echo " + sse-starlette==3.5.1"
elif [ -e "$STATE/uv-fails" ]; then echo "error: network down"; exit 1
else echo "Nothing to upgrade"; fi'
stub scrapling 'echo "Chromium already installed"'
stub install-iosevka-code 'echo "Iosevka Code is up to date"'
stub install-snippetslab-skill '[ ! -e "$STATE/snippetslab" ] || { mkdir -p "$HOME/.agents/skills/snippetslab"; date +%s%N > "$HOME/.agents/skills/snippetslab/SKILL.md"; }'
stub claude 'case "$1 $2" in
  "plugin update") if [ -e "$STATE/plugin-fails" ] && [ "$4" = beta@m ]; then
      echo "fatal: unable to access https://github.com/o/r.git/: Recv failure: Operation timed out"; exit 1
    elif [ -e "$STATE/plugin-blocked" ]; then
      echo "Plugin \"${4%@*}\" is from marketplace \"m\", which is blocked by your organization'"'"'s policy"; exit 1
    elif [ -e "$STATE/plugin" ] && [ "$4" = alpha@m ]; then
      echo "Marketplace cache updated"
      echo "✔ Plugin \"alpha@m\" updated from 1.0.0 to 1.1.0 for scope user. Restart to apply changes."
    else echo "$4 is already at the latest version"; fi ;;
  "mcp get") echo "  Status: ✔ Connected" ;;
  "--version ") if [ -e "$STATE/claude-done" ]; then echo "2.1.311 (Claude Code)"; else echo "2.1.310 (Claude Code)"; fi ;;
  "update ") [ -e "$STATE/claude-fails" ] && { echo "Error: update failed"; exit 1; }
    [ -e "$STATE/claude" ] && touch "$STATE/claude-done"; echo "Checking for updates to latest version..." ;;
esac'
stub claude-config 'case $1 in
  save) [ -e "$STATE/config" ] && echo "# saved" >> "$DOTFILES/agents/claude-skills.txt" ;;
  restore) if [ -e "$STATE/skills" ]; then printf "skill changed one\nskill same two\n"; else printf "skill same one\nskill unknown two\n"; fi ;;
esac
exit 0'
stub rea 'case $1 in
  --version) echo 6.8.0 ;;
  setup) echo "warning: x" >&2
    case "$*" in *"--skill --yes --format json"*) ;; *) echo "bad args: $*" >&2; exit 2 ;; esac
    if [ -e "$STATE/rea-fails" ]; then echo "{\"status\":\"needs_human\",\"doctor\":{\"identity\":{\"skill\":{\"remediation\":\"Skill directory is a symbolic link.\"}}}}"; exit 1; fi
    if [ -e "$STATE/rea" ]; then echo "{\"appliedActions\":[{\"id\":\"install_skill\"}]}"; else echo "{\"appliedActions\":[]}"; fi ;;
esac'
stub claude-catalog 'echo "wrote /tmp/cat/CATALOG.md, CATALOG-lite.md, catalog.html, since 2026-10-20: +0 -0"'
stub open 'exit 0'
stub amp 'echo "Amp is already up to date"'
stub nyan 'exit 0'
stub op '[ "$1" = read ] && echo secret'
stub hindsight-memory '[ -e "$STATE/hindsight-fails" ] && { echo "installer failed"; exit 1; }; [ -e "$STATE/hindsight-newer" ] && echo "newer release 0.9.0 on npm; bump CODING_AGENTS_VERSION"
if [ -e "$STATE/hindsight-warns" ]; then echo "│  ✓ runtime staged at ~/.hindsight/coding-agents"; echo "│  ▲ macOS needs a current Rust toolchain to build the daemon'"'"'s dependencies (litellm"; echo "│    publishes no macOS wheel). Install from https://rustup.rs"; fi
[ ! -e "$STATE/hindsight-change" ] || { mkdir -p "$HOME/.codex"; date +%s%N > "$HOME/.codex/hooks.json"; }
echo "runtime re-staged"'
# A failing stub, not a missing one: CI's macOS runner has a real cargo on PATH
stub cargo '[ -e "$STATE/no-cargo" ] && exit 1; echo "cargo 1.99.1"'
export PATH="$tmp/bin:$PATH"
export HINDSIGHT_CONFIG="$STATE/coding-agent.json"
echo '{}' > "$HINDSIGHT_CONFIG"

check_true() {
  local name=$1
  shift
  "$@" || {
    echo "FAIL: $name" >&2
    echo "$screen" >&2
    exit 1
  }
  echo "ok: $name"
}
has() { grep -Eq -- "$1" <<< "$screen"; }
lacks() { ! has "$1"; }
log_lacks() { ! grep -q -- "$1" "$DOTFILES"/logs/upup-*.log; }
run() {
  local rc=0
  screen=$("$script" < /dev/null 2>&1) || rc=$?
  check_true "upup exited $rc" [ "$rc" -eq 0 ]
  check_true "no colors off a terminal" lacks $'\x1b'
}

run
check_true "up to date: Homebrew is ok" has '^✔ Homebrew +up to date$'
check_true "up to date: cleanup reports what it freed" has '^✔ brew cleanup +freed 29.5MB$'
check_true "up to date: healthy brew doctor gets a line" has '^✔ brew doctor +ready to brew$'
check_true "up to date: an installed Scrapling browser gets a line" has '^✔ Scrapling +browser up to date$'
check_true "up to date: a connected mise MCP server gets a line" has '^✔ mise MCP +connected$'
check_true "up to date: config left dirty before the run is unchanged" has '^✔ Claude config +unchanged$'
check_true "up to date: plugins counted" has '^✔ plugins +2 plugins up to date$'
check_true "up to date: Claude Code version" has '^✔ Claude Code +2\.1\.310 up to date$'
check_true "up to date: skills checked, the uncheckable one named" has '^✔ agent skills +1 unchanged, reinstalled without a check: two$'
check_true "up to date: REA skill matches" has '^✔ REA skill +matches rea-agents 6\.8\.0$'
check_true "up to date: Hindsight unchanged" has '^✔ Hindsight memory +hooks and runtime unchanged$'
check_true "up to date: Rust is ok" has '^✔ Rust +up to date$'
check_true "up to date: nothing for mise prune" has '^✔ mise prune +nothing unused$'
check_true "up to date: no changed, notice or failed line" lacks '^ *[↻●✖]'
check_true "up to date: one-line summary" has '^Everything up to date\.$'
check_true "up to date: log is a file:// link" has "^Log +file://$DOTFILES/logs/upup-[0-9]{8}-[0-9]{6}\\.log\$"
check_true "up to date: no step slow enough for a time" lacks '\([0-9]+s\)$'
[ ! -x /Applications/SnippetsLab.app/Contents/Helpers/lab ] || check_true "up to date: SnippetsLab unchanged" has '^✔ SnippetsLab skill +unchanged$'
check_true "up to date: summary links the catalog" has '^Catalog +file:///tmp/cat/catalog\.html$'
check_true "up to date: log has the Homebrew section" grep -qx '== Homebrew ==' "$DOTFILES"/logs/upup-*.log
# The header promises one status line per step: a step whose branch forgot its
# line shows as a heading with nothing under it (the summary has none by design)
silent_steps=$(awk '
  /^== / { if (step && !seen) print step; step = $0; seen = 0; next }
  /^[✔↻●✖›] / { seen = 1 }
  END { if (step != "== summary ==" && !seen) print step }' "$DOTFILES"/logs/upup-*.log)
check_true "up to date: every step has a status line${silent_steps:+ (silent: $silent_steps)}" [ -z "$silent_steps" ]

rm -rf "$DOTFILES/logs"
mkdir -p "$STATE/installs/node/24.0.0" "$STATE/installs/aspire/13.6.0"
head -c 2048 /dev/zero > "$STATE/installs/node/24.0.0/bin"
touch "$STATE/skills" "$STATE/hindsight-change" "$STATE/snippetslab" "$STATE/prune" "$STATE/pull" "$STATE/brew" "$STATE/mise" "$STATE/uv-fails" "$STATE/plugin" "$STATE/config" "$STATE/claude-fails" "$STATE/hindsight-newer" "$STATE/hindsight-warns" "$STATE/rea" "$STATE/brew-doctor"
mkdir -p "$CLAUDE_CONFIG_DIR/skills"
ln -s /nonexistent "$CLAUDE_CONFIG_DIR/skills/reverse-engineer-anything"
run
check_true "stale REA skill symlink removed in the scratch config dir" test ! -L "$CLAUDE_CONFIG_DIR/skills/reverse-engineer-anything"
check_true "changes: REA skill reinstalled" has '^↻ REA skill +reinstalled for rea-agents 6\.8\.0$'
check_true "changes: newer Hindsight release is a notice" has '^● Hindsight memory +newer release 0.9.0 on npm; bump CODING_AGENTS_VERSION in bin/hindsight-memory$'
check_true "changes: the installer's ▲ warning is a notice, first line only" has '^● Hindsight memory +installer: macOS needs a current Rust toolchain to build the daemon.s dependencies \(litellm; see the log$'
check_true "changes: a warned or newer Hindsight step is not also ok" lacks '^✔ Hindsight memory'
check_true "changes: skills that changed upstream named" has '^↻ agent skills +1 skill updated: one; 1 unchanged$'
check_true "changes: Hindsight hooks change seen" has '^↻ Hindsight memory +hooks or runtime updated$'
[ ! -x /Applications/SnippetsLab.app/Contents/Helpers/lab ] || check_true "changes: SnippetsLab change seen" has '^↻ SnippetsLab skill +updated from SnippetsLab$'
check_true "changes: no upgrading line off a terminal" lacks 'upgrading'
check_true "changes: a further edit to dirty config is a change" has '^↻ Claude config +tracked Claude config changed$'
check_true "changes: dotfiles pulled" has '^↻ dotfiles +pulled 1 commit$'
check_true "changes: brew upgrade noise stays off screen" lacks '^==> Upgrading gh$'
check_true "changes: boilerplate caveat dropped" lacks 'completions'
check_true "changes: a caveat shows its package and first line" has '^    gh: Run gh auth login to use it\. \(more in the log\)$'
check_true "changes: a shadow caveat is one line" has '^    uv: uv, uvx shadowed by ~/\.local/share/mise/shims$'
check_true "changes: full caveats kept in the log" grep -qx 'Second line' "$DOTFILES"/logs/upup-*.log
check_true "changes: a brew doctor warning names what it found" has '^● brew doctor +Warning: Some installed formulae or casks are missing dependencies: gcloud-cli: python@3.13$'
check_true "changes: each brew doctor warning is its own notice, items joined" has '^● brew doctor +Warning: You have unlinked kegs in your Cellar. openssl@3, python@3.12$'
check_true "changes: brew doctor prose stays in the log" lacks 'Leaving kegs unlinked'
check_true "changes: Homebrew line counts" has '^↻ Homebrew +2 packages upgraded$'
check_true "changes: a formula's versions come from brew's table" has '^    gh     2\.103\.1 → 2\.103\.2$'
check_true "changes: a cask's versions come from its Upgrading block" has '^    codex  0\.164\.0 → 0\.165\.0$'
check_true "changes: summary keeps the short Homebrew line" has '^  ↻ Homebrew +2 packages upgraded$'
check_true "changes: mise line counts" has '^↻ mise +4 versions upgraded$'
check_true "changes: one tool in two pinned versions keeps its short name" has '^    tsc     5\.8\.0 → 5\.8\.1$'
check_true "changes: mise names each old → new pair, one row each" has '^    node    24\.1\.0 → 24\.1\.1$'
check_true "changes: mise rows drop the backend and align" has '^    aspire  13\.6\.1 → 13\.6\.2$'
check_true "changes: mise prune counts and sizes what it removed" has '^↻ mise prune +4 versions removed, [0-9]+KB freed$'
check_true "changes: mise prune names each tool in a row" has '^    aspire      13\.6\.0$'
check_true "changes: a tool pruned from one backend keeps its short name" has '^    node        24\.0\.0$'
check_true "changes: two backends of one tool stay apart" has '^    node \(npm\)  1\.0\.0, 2\.0\.0$'
check_true "changes: prune ran before the upgrade" grep -q 'mise prune.*mise ' <<< "$(grep -oE '^== mise( prune)? ==' "$DOTFILES"/logs/upup-*.log | tr '\n' ' ')"
check_true "changes: mise held release is a notice" has '^● mise +aspire 13.6.3 held until 2026-10-24 14:17 EDT by minimum_release_age$'
check_true "changes: mise reinstall failure is a notice" has '^● mise +failed to reinstall pipx tools; the next upup.s mise prune removes a version no config pins$'
check_true "changes: uv failure names the command" has '^✖ uv +run: uv tool upgrade --all$'
check_true "changes: uv failure output shown" has '^    error: network down$'
check_true "changes: Claude Code failure names the command" has '^✖ Claude Code +run: claude update$'
check_true "changes: Claude Code failure output shown" has '^    Error: update failed$'
check_true "changes: plugin update listed" has '^↻ plugins +1 plugin updated$'
check_true "changes: plugin versions in a row" has '^    alpha@m  1\.0\.0 → 1\.1\.0$'
check_true "changes: steps after the failure still run" has '^✔ Raycast +asked to check for updates$'
for section in Changed Notices Failed; do
  check_true "changes: summary has $section" has "^$section\$"
done
check_true "changes: summary lists the failure" has '^  ✖ uv +run: uv tool upgrade --all$'
check_true "changes: restart action" has '^  › Restart Claude Code to apply plugin updates$'
check_true "changes: new terminal action" has '^  › Open a new terminal: dotfiles changed$'
check_true "changes: action banner counts the items" has '^ ▶ ACTION NEEDED \([0-9]+ items\) $'
check_true "changes: headline counts each kind" has '^Done in [0-9]+s · [0-9]+ changed · [0-9]+ notices · [0-9]+ failed · [0-9]+ actions$'
check_true "changes: not everything up to date" lacks 'Everything up to date'
check_true "changes: log keeps the uv output" grep -qx 'error: network down' "$DOTFILES"/logs/upup-*.log
check_true "changes: log keeps the status lines and the table" grep -q -e '^↻ Homebrew  *2 packages upgraded$' -e '^    gh  ' "$DOTFILES"/logs/upup-*.log

# A warning alone (no newer release) must still replace the ok line
rm -rf "$DOTFILES/logs" "$STATE/hindsight-newer" "$STATE/skills" "$STATE/hindsight-change" "$STATE/snippetslab" "$STATE/brew-doctor"
run
check_true "warned: installer warning is the step's only line" lacks '^✔ Hindsight memory'
check_true "warned: installer warning still a notice" has '^● Hindsight memory +installer: '

rm -rf "$DOTFILES/logs" "$STATE/claude-fails"
touch "$STATE/claude" "$STATE/hindsight-fails" "$STATE/uv" "$STATE/rust" "$STATE/no-cargo" "$STATE/rea-fails" "$STATE/prune" "$STATE/prune-fails"
run
check_true "update: mise prune failure names the command" has '^✖ mise prune +run: mise prune --yes$'
check_true "update: mise prune failure output shown" has '^    mise ERROR uninstall failed$'
rm -f "$STATE/prune" "$STATE/prune-fails"
check_true "update: REA skill failure names the command" has '^✖ REA skill +run: rea setup --skill-client shared --skill-client claude_code --skill --yes$'
check_true "update: REA skill failure shows only the remediation" has '^    Skill directory is a symbolic link\.$'
check_true "update: REA skill failure hides the doctor payload" lacks 'needs_human'
check_true "update: Rust names the channel and versions" has '^↻ Rust +stable 1\.99\.0 → 1\.99\.1$'
check_true "update: a failing cargo is a notice" has "^● Rust +cargo --version failed: rustup's proxies live in /opt/homebrew/opt/rustup/bin, so open a new terminal, or run: rustup default stable$"
check_true "update: uv names the upgraded tool and the one whose dependencies moved" has '^↻ uv +serena-agent v0\.1\.4 -> v0\.1\.5, scrapling dependencies$'
check_true "update: uv output shown" has '^    Modified scrapling environment$'
check_true "update: no unrecognized uv output" lacks 'unrecognized output'
check_true "update: Claude Code updated" has '^↻ Claude Code +2\.1\.310 → 2\.1\.311$'
check_true "update: Claude Code restart action" has '^  › Restart Claude Code to run 2\.1\.311$'
check_true "update: Hindsight failure names the command" has '^✖ Hindsight memory +run: hindsight-memory upgrade$'
check_true "update: Hindsight failure output shown" has '^    installer failed$'

rm -rf "$DOTFILES/logs" "$STATE/rea-fails"
touch "$STATE/macos" "$STATE/macos-fails" "$STATE/rea"
run
check_true "macOS: failed install reports fail only" has '^✖ macOS'
check_true "macOS: failed install does not also say changed" lacks '^↻ macOS'
check_true "REA skill change seen despite stderr noise" has '^↻ REA skill'
rm -rf "$DOTFILES/logs" "$STATE/macos-fails"
touch "$STATE/macos-os" "$STATE/prune"
mkdir -p "$HOME/.local/share/mise/installs/rust"
run
check_true "macOS: a restart update is downloaded, not installed" has '^↻ macOS +Safari 99\.1 installed; macOS 27\.2-26B123 downloaded, not installed yet$'
check_true "macOS: the install is an action naming what installs it" has "^  › Install macOS 27\\.2-26B123: System Settings → General → Software Update → Restart Now, or run: sudo softwareupdate -ia --restart \\(a plain restart doesn't install it\\)\$"
check_true "macOS: off a terminal without a stored password the install stays in the log" lacks '^Downloaded:'
check_true "macOS: off a terminal no password prompt" lacks 'Mac password'
check_true "macOS: no 1Password prompt without DOTFILES_MAC_PASSWORD_OP" lacks '1Password'
check_true "rust in mise: prune skipped as a notice" has '^● mise prune +skipped while a mise rust install shadows rustup; see the Rust step$'
check_true "rust in mise: prune never ran" test -e "$STATE/prune"
rm -rf "$DOTFILES/logs" "$STATE/macos"
screen=$(DOTFILES_MAC_PASSWORD_OP=op://vault/item/password "$script" < /dev/null 2>&1) || true
check_true "macOS: the 1Password fingerprint is announced" has '^› macOS +1Password: approve reading the Mac password for macOS 27\.2-26B123$'
check_true "macOS: with the stored password the install stays in the log" lacks '^Downloaded:'
check_true "macOS: the stored password was accepted" has '^↻ macOS +macOS 27\.2-26B123 downloaded, not installed yet$'
rm -rf "$DOTFILES/logs"
# A real terminal: the typed password must not echo. The delay lets upup's
# read turn echo off before the keys arrive
screen=$({
  sleep 2
  printf 'secret\n'
} | TERM=xterm-256color script -q /dev/null "$script" 2>&1 | tr -d '\r') || true
check_true "macOS: a terminal asks for the password itself" has 'Mac password for macOS 27\.2-26B123'
check_true "macOS: the typed password is not shown" lacks 'secret'
check_true "macOS: the typed password was accepted" has 'macOS 27\.2-26B123 downloaded, not installed yet'
rm -rf "$DOTFILES/logs" "$STATE/macos-os"
touch "$STATE/macos"
run
check_true "macOS: an update needing no restart installs quietly" lacks '^Downloaded:'
check_true "macOS: no install action for it" lacks 'Software Update → Restart Now'
rm -rf "$DOTFILES/logs" "$STATE/macos" "$STATE/rea" "$STATE/prune" "$HOME/.local/share/mise"
screen=$(UPUP_SLOW=0 "$script" < /dev/null 2>&1) || true
check_true "slow: a step's line names its time" has '^✔ brew doctor +ready to brew \([0-9]+s\)$'
check_true "slow: the summary leaves the time out" lacks '^  [↻●✖›] .*\([0-9]+s\)$'

# Back to the uv failure: the terminal run below needs a failed step
rm -rf "$DOTFILES/logs" "$HINDSIGHT_CONFIG" "$STATE/uv"
run
check_true "no Hindsight config: step skipped" lacks 'Hindsight memory'

rm -rf "$DOTFILES/logs" "$STATE/plugin"
touch "$STATE/plugin-fails"
run
check_true "plugin failure: its own fail line" has '^✖ plugins +updating beta@m failed; run: claude plugin update beta@m$'
check_true "plugin failure: not counted as up to date" has '^✔ plugins +1 plugin up to date$'
rm -f "$STATE/plugin-fails"
rm -rf "$DOTFILES/logs"
touch "$STATE/plugin-blocked"
run
check_true "plugins blocked by policy: one notice, no fail line" has "^● plugins +2 plugins skipped: marketplace blocked by your organization's policy\$"
check_true "plugins blocked by policy: not a failure" lacks '^✖ plugins'
rm -f "$STATE/plugin-blocked"

rm -rf "$DOTFILES/logs"
rc=0
screen=$(TERM=xterm-256color script -q /dev/null "$script" < /dev/null | tr -d '\r') || rc=$?
check_true "terminal: upup exited $rc" [ "$rc" -eq 0 ]
check_true "terminal: status lines colored" has $'\x1b\\[[0-9;]*m✔'
check_true "terminal: a running step shows a … line" has '… Homebrew'
check_true "terminal: summary colored" has $'^  \x1b\\[[0-9;]*m✖'
check_true "terminal: the log link is an OSC 8 hyperlink" has $'\x1b]8;;file://'"$DOTFILES"$'/logs/upup-[0-9-]+\\.log\x1b\\\\'
check_true "terminal: action banner colored" has $'\x1b\\[[0-9;]*m ▶ ACTION NEEDED'
check_true "terminal: log has no color codes" log_lacks $'\x1b'
