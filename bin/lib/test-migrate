dotfiles_needs_the_dotfiles_link() {
  rm "$HOME/dotfiles"
  before=$(snapshot)
  : > "$STATE/mise.log"
  out=$(yes | "$script" --step dotfiles 2>&1) && fail "ran without ~/dotfiles" || [ $? = 1 ] || fail "no ~/dotfiles: want exit 1"
  check_out "says how to fix it" "^~/dotfiles is missing.*ln -s '$REPO_COPY' ~/dotfiles"
  [ "$(snapshot)" = "$before" ] && [ -z "$(mutations)" ] || fail "changed something without ~/dotfiles"
  ln -s "$REPO_COPY" "$HOME/dotfiles"
