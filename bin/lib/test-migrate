#!/bin/bash
#
# Self-check for migrate/legacy-to-mise against a scratch HOME and stubbed brew, mise, claude, curl, pgrep, defaults, tmutil and socketfilterfw.
#
# - Run it (pnpm check does too); exits 1 naming the first failed assertion:
#
# `test-migrate`
#
# ---
# Never changes this Mac: HOME, HOMEBREW_PREFIX and the clone are temp dirs, and
# PATH holds only the stubs and /usr/bin:/bin, so no real mise, brew or claude
# (all under /opt/homebrew or ~/.local/bin) can run. Temporary, like migrate/.
#
# License: MIT

# No pipefail: `yes | "$script"` would report SIGPIPE (141) for a script that exits 0
set -eu

src="$(cd "$(dirname "$0")/../.." && pwd -P)/migrate"
# Physical: the script resolves REPO with pwd -P, and macOS's temp dir is behind the /var link
tmp=$(cd "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$tmp"' EXIT

export HOME="$tmp/home" STATE="$tmp/state" HOMEBREW_PREFIX="$tmp/prefix" PATH="$tmp/bin:/usr/bin:/bin"
# The override cache may export the two switches into the shell that runs pnpm check
unset HOMEBREW_NO_ANALYTICS MISE_CONFIG_DIR DOTFILES_MACOS_DISABLE_TIME_MACHINE DOTFILES_MACOS_FIREWALL
REPO_COPY="$tmp/repo"
mkdir -p "$HOME/.config" "$STATE" "$HOMEBREW_PREFIX" "$tmp/bin" "$REPO_COPY/tilde/.config/mise/conf.d" "$REPO_COPY/settings"
cp -R "$src" "$REPO_COPY/migrate"
ln -s "$REPO_COPY/tilde/.config/mise" "$HOME/.config/mise"
: > "$STATE/mise.log"
: > "$STATE/brew.log"
: > "$STATE/claude.log"
script="$REPO_COPY/migrate/legacy-to-mise"

fail() {
  echo "test-migrate: $1" >&2
  exit 1
}
check() {
  local description=$1
  shift
  "$@" || fail "$description"
}
check_out() { grep -qE "$2" <<< "$out" || fail "$1 (output: $out)"; }

stub() {
  printf '#!/bin/bash\n%s\n' "$2" > "$tmp/bin/$1"
  chmod +x "$tmp/bin/$1"
}
stub mise 'echo "mise $*" >> "$STATE/mise.log"
case "$*" in
  --version) echo "${FAKE_MISE_VERSION:-2026.11.5} macos-arm64 (2026-11-08)" ;;
  "bootstrap packages status --json")
    [ ! -e "$STATE/status-fails" ] || exit 1
    # status-fails-later fails every read after the first; created once, so its mtime never shows in a snapshot
    if [ -e "$STATE/status-read" ] && [ -e "$STATE/status-fails-later" ]; then exit 1; fi
    [ -e "$STATE/status-read" ] || : > "$STATE/status-read"
    if [ -e "$STATE/differs-without-brew" ] && [ ! -e "$HOMEBREW_PREFIX/bin/brew" ]; then
      jq ".\"brew-cask\".packages[] |= (if .managed_by == \"mise\" then .managed_by = \"unknown\" else . end)" "$STATE/status.json"
    else
      cat "$STATE/status.json"
    fi
    ;;
  "bootstrap packages prune --manager brew --dry-run") [ -e "$STATE/prune-empty" ] || printf "remove brew:abseil@1\nremove brew:ack@3\n" ;;
  reshim) ;; # as the real one: without --force an existing shim keeps its link
  "reshim --force") # as the real one: every shim becomes a link to the first mise on PATH, not to the binary that ran
    for s in "${MISE_DATA_DIR:-$HOME/.local/share/mise}"/shims/*; do if [ -L "$s" ]; then ln -sfn "$(command -v mise)" "$s"; fi; done ;;
  "bootstrap packages apply --yes brew-cask:"*)
    [ ! -e "$STATE/apply-fails" ] || exit 1
    for t; do :; done
    t=${t#brew-cask:}
    jq --arg t "$t" "(.\"brew-cask\".packages[] | select(.package == \$t)) |= (.state = \"installed\" | .managed_by = \"mise\")" "$STATE/status.json" > "$STATE/s" && mv "$STATE/s" "$STATE/status.json"
    while read -r a; do mkdir -p "$MIGRATE_APPDIR/$a"; done < <(cat "$STATE/apps/$t" 2> /dev/null)
    ;;
  "set --file "*) # set --file <file> KEY: prints $STATE/override/KEY, exit 1 when absent
    for key; do :; done
    if [ -f "$STATE/override/$key" ]; then cat "$STATE/override/$key"; else exit 1; fi
    ;;
  "set --override "*) # set --override KEY=VALUE, one argument; the real one writes the override file
    [ $# = 3 ] || { echo "set --override got $# args" >&2; exit 9; }
    kv=$3
    mkdir -p "$STATE/override"
    printf "%s\n" "${kv#*=}" > "$STATE/override/${kv%%=*}"
    touch "$HOME/.config/mise/config.override.toml"
    ;;
  "bootstrap macos defaults status --json") cat "$STATE/defaults.json" ;;
  "dot "*)
    shift
    exec "$STATE/../fake-dot" "$@"
    ;;
esac'
# The dotfiles half of the fake mise. $STATE/dot-targets holds one absolute target<TAB>source per line.
# The Codex edit behaves as A5's E9 and E18 measured it, after the file conflicts, which stop the real apply first
cat > "$tmp/fake-dot" << 'EOF'
#!/bin/bash
codex="$HOME/.codex/config.toml"
src="$REPO_COPY/tilde/.codex/config.toml"
tilde() { case $1 in "$HOME"/*) echo "~/${1#"$HOME"/}" ;; *) echo "$1" ;; esac; }
targets() { grep . "$STATE/dot-targets" || true; }
conflicts() {
  targets | while IFS=$'\t' read -r t s; do
    if [ -e "$t" ] && [ ! -L "$t" ]; then echo "  $(tilde "$t")"; fi
  done
}
edit_error() {
  local reason
  if [ -L "$codex" ] && [ ! "$codex" -ef "$src" ]; then
    reason="target is a symlink; replace it with a copy of the real file before merging"
  elif [ -f "$codex" ] && [ ! -L "$codex" ] && [ "$(head -1 "$codex")" = "model = " ]; then
    reason="failed to parse the TOML target: expected a value"
  else
    return 1
  fi
  printf 'mise ERROR edits: cannot apply these entries, fix them manually:\n  "~/.codex/config.toml" (merge:defaults): %s\n' "$reason" >&2
}
case "$*" in
  "status --json")
    targets | jq -Rn --arg home "$HOME" --arg repo "$REPO_COPY" '
      def t: if startswith($home + "/") then "~/" + .[($home | length) + 1:] else . end;
      def s: if startswith($repo + "/") then "~/dotfiles/" + .[($repo | length) + 1:] else . end;
      {files: ([inputs | split("\t") | {target: (.[0] | t), source: (.[1] | s), mode: "symlink", state: "applied"}]
        + [{target: "~/.claude/rules", source: ($repo + "/tilde/.claude/rules"), mode: "symlink-each", state: "applied"}]),
       edits: [{path: "~/.codex/config.toml", edit: "merge:defaults", state: "applied"}]}'
    ;;
  "status --missing")
    targets | while IFS=$'\t' read -r t s; do [ -L "$t" ] && [ "$t" -ef "$s" ] || exit 1; done || exit 1
    [ -f "$codex" ] && [ ! -L "$codex" ] && [ "$(head -1 "$codex")" != "model = " ]
    ;;
  "apply --dry-run" | "apply --yes")
    c=$(conflicts)
    if [ -n "$c" ]; then
      printf 'mise ERROR files: refusing to overwrite existing files (use --force):\n%s\n' "$c" >&2
      exit 1
    fi
    if [ "$2" = --yes ]; then
      if [ -e "$STATE/dot-apply-fails" ]; then
        echo "mise ERROR files: the apply failed" >&2
        exit 1
      fi
      targets | while IFS=$'\t' read -r t s; do mkdir -p "$(dirname "$t")" && ln -sfn "$s" "$t"; done
    fi
    ! edit_error || exit 1
    [ "$2" = --yes ] || exit 0
    if [ ! -e "$codex" ] && [ ! -L "$codex" ]; then
      mkdir -p "$(dirname "$codex")" && cp "$src" "$codex" && chmod 600 "$codex"
    elif [ -L "$codex" ]; then
      # as the real one: the file existed, so permissions do not apply
      rm "$codex" && cp "$src" "$codex" && chmod 644 "$codex"
    fi
    ;;
  *) exit 2 ;;
esac
EOF
chmod +x "$tmp/fake-dot"
export REPO_COPY
stub brew 'echo "brew $*" >> "$STATE/brew.log"
[ "${HOMEBREW_NO_ANALYTICS:-}" = 1 ] || { echo "brew ran without HOMEBREW_NO_ANALYTICS=1" >&2; exit 97; }
for t; do :; done # the last argument: the cask token
case "$*" in
  "info --json=v2 --cask "*) cat "$STATE/cask-info/$t.json" ;;
  "uninstall mise") # fails while a shim still links to this mise, which pins reshim-before-uninstall
    if find "$HOME/.local/share/mise/shims" -type l -lname "$HOMEBREW_PREFIX/bin/mise" | grep -q .; then echo "shims still use this mise" >&2; exit 1; fi
    rm "$HOMEBREW_PREFIX/bin/mise"
    ;;
  "uninstall --cask "*)
    jq --arg t "$t" "(.\"brew-cask\".packages[] | select(.package == \$t)) |= (.state = \"missing\" | del(.managed_by))" "$STATE/status.json" > "$STATE/s" && mv "$STATE/s" "$STATE/status.json"
    ;;
esac'
stub claude 'echo "claude $*" >> "$STATE/claude.log"
case "$*" in
  "mcp get mise")
    [ -e "$STATE/mcp-command" ] || exit 1
    printf "mise:\n  Command: %s\n" "$(cat "$STATE/mcp-command")"
    ;;
  "mcp add --scope user mise -- "*) echo "$7" > "$STATE/mcp-command" ;;
esac'
# For mise.run it prints a one-line installer that copies the fake mise into place
stub curl 'echo "curl $*" >> "$STATE/curl.log"
[ ! -e "$STATE/offline" ] || exit 1
case "$*" in
  *mise.run*)
    if [ -e "$STATE/installer-fails" ]; then
      echo "exit 1"
    else
      echo "mkdir -p \"\$(dirname \"\$MISE_INSTALL_PATH\")\" && cp \"$STATE/../bin/mise\" \"\$MISE_INSTALL_PATH\""
    fi
    ;;
esac'
stub pgrep '[ -e "$STATE/running" ] || exit 1
for last; do :; done
while read -r name; do case $last in *"$name"*) exit 0 ;; esac; done < "$STATE/running"
exit 1'
stub defaults 'case "$*" in
  "read com.apple.dock autohide-delay" | "read com.apple.dock autohide-time-modifier") echo 0.2 ;;
  "read /Library/Preferences/com.apple.TimeMachine AutoBackup") if [ -e "$STATE/tm-on" ]; then echo 1; else exit 1; fi ;;
  "read "*) exit 1 ;;
  *) echo "defaults $*" >> "$STATE/defaults.log" ;;
esac'
stub tmutil 'echo "tmutil: No destinations configured."'
stub socketfilterfw 'if [ -e "$STATE/fw-off" ]; then echo "Firewall is disabled. (State = 0)"; else echo "Firewall is enabled. (State = 1)"; fi'
for tool in mise brew claude curl pgrep defaults tmutil socketfilterfw; do
  [ "$(command -v "$tool")" = "$tmp/bin/$tool" ] || fail "$tool resolves to $(command -v "$tool"), not the stub"
done
# The script appends /usr/sbin to PATH, so none of these system folders may hold a real one
for tool in mise brew claude code; do
  for dir in /usr/bin /bin /usr/sbin; do
    [ ! -e "$dir/$tool" ] || fail "$dir/$tool exists, so a run could reach the real $tool"
  done
done

export MIGRATE_APPDIR="$tmp/apps"
: > "$STATE/curl.log"
mkdir -p "$STATE/cask-info" "$STATE/apps"
cat > "$STATE/status.json" << 'EOF'
{"brew":{"packages":[
  {"package":"jq","state":"installed","installed_version":"1.8.2"},
  {"package":"rustup","state":"needs_repair","installed_version":"1.28.2"}]},
 "brew-cask":{"packages":[
  {"package":"ghostty","state":"installed","installed_version":"1.2.3","auto_updates":true,"managed_by":"homebrew"},
  {"package":"font-hack-nerd-font","state":"installed","installed_version":"3.4.0","managed_by":"homebrew"},
  {"package":"utm","state":"installed","installed_version":"4.7.4","managed_by":"homebrew"},
  {"package":"freelens","state":"installed","installed_version":"1.6.1","managed_by":"homebrew"},
  {"package":"raycast","state":"installed","installed_version":"1.103.0","auto_updates":true,"managed_by":"mise"}]}}
EOF
echo '{"casks":[{"artifacts":[{"app":["Ghostty.app"]}]}]}' > "$STATE/cask-info/ghostty.json"
echo '{"casks":[{"artifacts":[{"font":["Hack.ttf"]}]}]}' > "$STATE/cask-info/font-hack-nerd-font.json"
echo '{"casks":[{"artifacts":[{"app":["UTM.app"],"target":"/Applications/UTM.app"}]}]}' > "$STATE/cask-info/utm.json"
echo '{"casks":[{"artifacts":[{"app":["Freelens.app"]}]}]}' > "$STATE/cask-info/freelens.json"
echo Ghostty.app > "$STATE/apps/ghostty"
echo UTM.app > "$STATE/apps/utm"
echo Freelens.app > "$STATE/apps/freelens"
echo '{"macos_defaults":{"available":true,"entries":[]}}' > "$STATE/defaults.json"
: > "$STATE/status-read"
# The dotfiles fixture: every source goes through ~/dotfiles, as on a real Mac
ln -s "$REPO_COPY" "$HOME/dotfiles"
mkdir -p "$REPO_COPY/tilde/.claude/rules" "$REPO_COPY/tilde/.claude/skills" "$REPO_COPY/tilde/.codex" "$REPO_COPY/mole" "$REPO_COPY/firefox/chrome" "$HOME/.claude"
for f in .zshrc .gitconfig .starship.toml .zshenv .zprofile .claude/rules/a.md .claude/skills/x firefox/user.js firefox/chrome/userContent.css firefox/chrome/userChrome.css; do
  case $f in firefox/*) echo "$f" > "$REPO_COPY/$f" ;; *) echo "$f" > "$REPO_COPY/tilde/$f" ;; esac
done
printf 'model = "o3"\nsandbox_mode = "workspace-write"\n' > "$REPO_COPY/tilde/.codex/config.toml"
{
  for f in .zshrc .gitconfig .starship.toml .zshenv; do printf '%s\t%s\n' "$HOME/$f" "$REPO_COPY/tilde/$f"; done
  printf '%s\t%s\n' "$HOME/.config/mise" "$REPO_COPY/tilde/.config/mise"
} > "$STATE/dot-targets"
cat > "$REPO_COPY/settings/registry.toml" << 'EOF'
[[setting]]
id = "updates.trim_ca_roots"
kind = "env"
key = "DOTFILES_TRIM_CA_ROOTS"
access = "rw"

[[setting]]
access = "rw"
choices = []
key = "DOTFILES_MAC_PASSWORD_OP"
kind = "env"

[[setting]]
kind = "env"
key = "DOTNET_CLI_TELEMETRY_OPTOUT"
access = "ro"

[[setting]]
kind = "tool"
key = "NOT_ENV"
access = "rw"
EOF

phase() {
  local marker
  case $1 in
    env) marker=zsh/override-env.zsh ;;
    macos) marker=tilde/.config/mise/conf.d/20-macos.toml ;;
    packages) marker=tilde/.config/mise/conf.d/30-packages.toml ;;
    dotfiles) marker=tilde/.config/mise/conf.d/40-dotfiles.toml ;;
    setup) marker=tilde/.config/mise/conf.d/50-bootstrap.toml ;;
  esac
  mkdir -p "$(dirname "$REPO_COPY/$marker")"
  touch "$REPO_COPY/$marker"
}
snapshot() {
  find "$HOME" "$HOMEBREW_PREFIX" "$STATE" ! -path "$STATE/*.log" -exec ls -ld {} + | sort
  find "$HOME" "$HOMEBREW_PREFIX" "$STATE" -type f ! -path "$STATE/*.log" -exec cksum {} + | sort
}
mutations() {
  cat "$STATE/mise.log" "$STATE/brew.log" "$STATE/claude.log" \
    | grep -vE 'status|--version|--dry-run|set --file|info --json|mcp get' || true
}

refuses_absent_phase() {
  for s in env macos packages dotfiles setup; do
    out=$("$script" --step "$s" 2>&1) && fail "$s ran with its phase absent" || rc=$?
    [ "$rc" = 3 ] || fail "$s: exit $rc, want 3"
    check_out "$s names the marker" "refusing $s: [a-z./0-9-]+ is not in this checkout"
  done
}
refuses_old_mise() {
  phase macos
  out=$(FAKE_MISE_VERSION=2026.11.4 "$script" --step macos 2>&1) && fail "ran on old mise" || rc=$?
  [ "$rc" = 3 ] || fail "old mise: exit $rc, want 3"
  check_out "names the floor" 'mise 2026\.11\.5 or newer'
  out=$(FAKE_MISE_VERSION=2026.12.0 "$script" --step macos 2>&1) || fail "refused 2026.12.0: $out"
  out=$(FAKE_MISE_VERSION=2026.11.10 "$script" --step macos 2>&1) || fail "refused 2026.11.10 (compared as text, not as a version): $out"
}
refuses_missing_mise() {
  mv "$tmp/bin/mise" "$tmp/mise.off"
  out=$("$script" --step macos 2>&1) && fail "ran without mise" || rc=$?
  mv "$tmp/mise.off" "$tmp/bin/mise"
  [ "$rc" = 3 ] || fail "no mise: exit $rc, want 3"
  check_out "no mise names the floor" 'mise 2026\.11\.5 or newer'
}
refuses_foreign_mise_config() {
  rm "$HOME/.config/mise" && mkdir "$HOME/.config/mise"
  out=$("$script" --step macos 2>&1) && fail "ran with a foreign ~/.config/mise" || rc=$?
  [ "$rc" = 3 ] || fail "foreign config: exit $rc, want 3"
  rmdir "$HOME/.config/mise" && ln -s "$REPO_COPY/tilde/.config/mise" "$HOME/.config/mise"
}
usage_errors() {
  "$script" --step nope > /dev/null 2>&1 && fail "accepted --step nope" || [ $? = 2 ] || fail "--step nope: want exit 2"
  "$script" --frob > /dev/null 2>&1 && fail "accepted --frob" || [ $? = 2 ] || fail "--frob: want exit 2"
  "$script" --step > /dev/null 2>&1 && fail "accepted --step with no name" || [ $? = 2 ] || fail "--step alone: want exit 2"
  "$script" --help | grep -q '2027-02-28' || fail "--help does not state the removal date"
}
skips_absent_phases() {
  out=$("$script" < /dev/null 2>&1) || fail "a run with some phases absent: exit $?: $out"
  check_out "names a skipped step" '^skipped env: its phase is not in this checkout$'
}
dry_run_asks_nothing() {
  out=$("$script" --dry-run < /dev/null 2>&1) || fail "--dry-run: exit $?: $out"
  check_out "--dry-run ends with the count" '^Changed 0 thing\(s\)\.$'
}
env_refuses_without_registry() {
  phase env
  mv "$REPO_COPY/settings/registry.toml" "$tmp/reg"
  "$script" --step env > /dev/null 2>&1 && fail "env ran without the registry" || [ $? = 3 ] || fail "env without registry: want exit 3"
  mv "$tmp/reg" "$REPO_COPY/settings/registry.toml"
}
env_value_forms() {
  local want got rc line
  eval "$(sed -n '/^zsh_local_value()/,/^}/p' "$script")"
  # want<TAB>line: 1 no export, 2 not an accepted form, otherwise "0 <value>"; the last export wins
  while IFS=$'\t' read -r want line; do
    printf '%s\n' 'export K=earlier' "$line" > "$HOME/.zsh.local"
    rc=0
    got=$(zsh_local_value K) || rc=$?
    [ "$rc" = 0 ] && got="0 $got" || got=$rc
    [ "$got" = "$want" ] || fail "zsh_local_value on [$line]: got [$got], want [$want]"
  done << 'EOF'
0 a b "c"	export K='a b "c"'  # note
0 a b 'c'	export K="a b 'c'"
0 op://x/y@z:1,2+3%4=5~6-7.	export K=op://x/y@z:1,2+3%4=5~6-7.
0 1	  export K=1 # comment
0 	export K=''
0 	export K=
0 later	export K=later
2	export K=~/x
2	export K=a$b
2	export K='a$b'
2	export K="$HOME"
2	export K="a`b`"
2	export K="a\b"
2	export K="a"b
2	export K='a'#b
2	export K=a b
2	export K=a;b
0 earlier	# export K=commented
0 earlier	KK=1
EOF
  printf '%s\n' 'K=x' 'export KK=y' '# export K=z' > "$HOME/.zsh.local"
  rc=0
  zsh_local_value K > /dev/null || rc=$?
  [ "$rc" = 1 ] || fail "zsh_local_value with no export of K: exit $rc, want 1"
  rm "$HOME/.zsh.local"
}
env_quoting() {
  cat > "$HOME/.zsh.local" << 'EOF'
export DOTFILES_MAC_PASSWORD_OP='op://Private/Mac login/pass "q"'  # note
export DOTFILES_TRIM_CA_ROOTS=1
export DOTNET_CLI_TELEMETRY_OPTOUT=0
export NOT_ENV=x
export UNREGISTERED="y"
EOF
  zsh_local_before=$(cksum < "$HOME/.zsh.local")
  out=$(yes | "$script" --step env 2>&1) || fail "env: exit $?: $out"
  [ "$(cat "$STATE/override/DOTFILES_MAC_PASSWORD_OP")" = 'op://Private/Mac login/pass "q"' ] || fail "value with spaces and quotes was changed"
  [ "$(cat "$STATE/override/DOTFILES_TRIM_CA_ROOTS")" = 1 ] || fail "bare value not written"
  [ ! -e "$STATE/override/DOTNET_CLI_TELEMETRY_OPTOUT" ] || fail "wrote a read-only setting"
  [ ! -e "$STATE/override/NOT_ENV" ] && [ ! -e "$STATE/override/UNREGISTERED" ] || fail "wrote an unregistered key"
  [ "$(cksum < "$HOME/.zsh.local")" = "$zsh_local_before" ] || fail "$HOME/.zsh.local was edited"
  check_out "explains seed and override" 'An override beats the seed'
}
env_second_run_changes_nothing() {
  before=$(snapshot)
  : > "$STATE/mise.log"
  out=$(yes | "$script" --step env 2>&1) || fail "env rerun: exit $?"
  [ "$(snapshot)" = "$before" ] || fail "env rerun changed something"
  [ -z "$(mutations)" ] || fail "env rerun made mutating calls: $(mutations)"
  check_out "says already" 'DOTFILES_TRIM_CA_ROOTS: already an override'
}
env_unsafe_values_are_skipped() {
  rm -rf "$STATE/override"
  printf '%s\n' 'export DOTFILES_MAC_PASSWORD_OP="$(op read x)"' "export DOTFILES_TRIM_CA_ROOTS='a\$b'" > "$HOME/.zsh.local"
  out=$(yes | "$script" --step env 2>&1) || fail "env unsafe: exit $?"
  [ ! -e "$STATE/override" ] || fail "wrote a value it could not read safely"
  check_out "gives the manual command" 'mise set --override DOTFILES_MAC_PASSWORD_OP=<value>'
}
env_names_retired_knobs() {
  phase macos
  printf '%s\n' 'export DOTFILES_MACOS_NO=1' "export COMPUTERNAME='Old Mac'" 'export LOCALHOSTNAME=old-mac' 'export HOMEBREW_NO_AUTO_UPDATE=1' > "$HOME/.zsh.local"
  out=$("$script" --step env < /dev/null 2>&1) || fail "env retired names: exit $?"
  check_out "names a dead knob" '^DOTFILES_MACOS_NO: retired, no longer read'
  check_out "points the old prompt variable at its setting" '^COMPUTERNAME: retired, no longer read\. Set it with: dotfiles-settings set macos\.computer_name'
  check_out "and the hostname one" '^LOCALHOSTNAME: retired, no longer read\. Set it with: dotfiles-settings set macos\.local_hostname <host>$'
  ! grep -q 'HOMEBREW_NO_AUTO_UPDATE' <<< "$out" || fail "called a HOMEBREW_ export retired before its phase"
  phase packages
  out=$("$script" --step env < /dev/null 2>&1) || fail "env retired names, packages phase: exit $?"
  check_out "a HOMEBREW_ export is retired with the packages phase" '^HOMEBREW_NO_AUTO_UPDATE: retired, no longer read\. Delete its line from ~/\.zsh\.local yourself\.$'
  [ ! -e "$STATE/override" ] || fail "wrote an override for a retired name"
}
env_dry_run_and_closed_stdin_change_nothing() {
  printf '%s\n' 'export DOTFILES_TRIM_CA_ROOTS=1' > "$HOME/.zsh.local"
  for how in "--dry-run" ""; do
    before=$(snapshot)
    : > "$STATE/mise.log"
    # shellcheck disable=SC2086 # $how is one flag or nothing
    out=$("$script" --step env $how < /dev/null 2>&1) || fail "env $how: exit $?"
    [ "$(snapshot)" = "$before" ] && [ -z "$(mutations)" ] || fail "env $how with closed stdin changed something"
    if [ -n "$how" ]; then check_out "--dry-run shows the question" '^would ask: Make DOTFILES_TRIM_CA_ROOTS=1 from ~/\.zsh\.local an override\?$'; fi
  done
}
env_backs_up_override_before_replacing() {
  mkdir -p "$STATE/override"
  echo 0 > "$STATE/override/DOTFILES_TRIM_CA_ROOTS"
  echo '[env]' > "$REPO_COPY/tilde/.config/mise/config.override.toml"
  out=$(yes | "$script" --step env 2>&1) || fail "env replace: exit $?"
