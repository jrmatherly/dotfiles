dotfiles_declined_or_dry_run_changes_nothing() {
  echo mine > "$HOME/.zprofile"
  printf '%s\t%s\n' "$HOME/.zprofile" "$REPO_COPY/tilde/.zprofile" >> "$STATE/dot-targets"
  for how in "--dry-run" ""; do
    before=$(snapshot)
    : > "$STATE/mise.log"
    # shellcheck disable=SC2086 # $how is one flag or nothing
    out=$("$script" --step dotfiles $how < /dev/null 2>&1) || true
    [ "$(snapshot)" = "$before" ] && [ -z "$(mutations)" ] || fail "dotfiles $how changed something"
  done
  check_out "closed stdin leaves them" '^Left as they are\. Finish with: mise dot apply$'
  out=$("$script" --step dotfiles --dry-run < /dev/null 2>&1) || true
  check_out "--dry-run shows the one question" '^would ask: Back up the 1 item\(s\) above and let mise link them\?$'
}
dotfiles_failed_apply_keeps_the_backup() {
  rm -rf "$HOME/.dotfiles-migration-backup"
  touch "$STATE/dot-apply-fails"
  out=$(echo y | "$script" --step dotfiles 2>&1) && fail "a failed apply must exit 1" || [ $? = 1 ] || fail "failed apply: want exit 1"
  rm "$STATE/dot-apply-fails"
  check_out "points at the backup" '^mise dot apply failed\. What this step moved is in .*RESTORE\.txt there puts each item back'
  check_out "the summary still runs" '^Restore commands: '
  bak=$(echo "$HOME"/.dotfiles-migration-backup/*)
  [ "$(cat "$bak/files$HOME/.zprofile")" = mine ] || fail "the moved file is not in the backup after a failed apply"
  # the rerun finds nothing in the way, only what is missing, and finishes
  : > "$STATE/mise.log"
  out=$(echo y | "$script" --step dotfiles 2>&1) || fail "rerun after a failed apply: exit $?: $out"
  grep -qx 'mise dot apply --yes' "$STATE/mise.log" || fail "the rerun did not apply what was missing"
  check_out "ends clean" '^All dotfiles are in their declared state\.$'
  rm -rf "$HOME/.dotfiles-migration-backup"
}
