  out=$(echo y | "$script" --step dotfiles 2>&1) && fail "want exit 1" || [ $? = 1 ] || fail "want exit 1"
  [ -e "$REPO_COPY/tilde/.claude/skills/x" ] || fail "moved a tracked file out of the clone"
