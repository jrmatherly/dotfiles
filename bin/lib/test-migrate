dotfiles_keeps_the_local_mole_list() {
  local entry='"~/.config/mole/whitelist" = { source = "~/dotfiles/mole/whitelist.local", mode = "symlink" }'
  echo x > "$REPO_COPY/mole/whitelist.local"
  local_toml="$REPO_COPY/tilde/.config/mise/config.local.toml"
  out=$("$script" --step dotfiles --dry-run < /dev/null 2>&1) || true
  check_out "--dry-run shows the question" "^would ask: Keep this Mac's Mole whitelist list by adding it to config\.local\.toml\?$"
  [ ! -e "$local_toml" ] || fail "--dry-run wrote config.local.toml"
  out=$(echo y | "$script" --step dotfiles 2>&1) || true
  grep -qxF "$entry" "$local_toml" || fail "local Mole entry not written"
  [ "$(grep -c '^\[dotfiles\]' "$local_toml")" = 1 ] || fail "wrote a second [dotfiles] table"
  ! grep -q 'whitelist_optimize' <<< "$out" || fail "asked about a list with no .local file"
  before=$(cksum < "$local_toml")
  out=$(echo y | "$script" --step dotfiles 2>&1) || true
  [ "$(cksum < "$local_toml")" = "$before" ] || fail "wrote the Mole entry twice"
  # a [dotfiles] table without the entry: it goes under that header, as step_packages adds its packages
  rm -rf "$HOME/.dotfiles-migration-backup"
  printf '[dotfiles]\n"~/.x" = { source = "~/x", mode = "symlink" }\n' > "$local_toml"
  out=$(echo y | "$script" --step dotfiles 2>&1) || true
  [ "$(sed -n 2p "$local_toml")" = "$entry" ] && grep -qxF '"~/.x" = { source = "~/x", mode = "symlink" }' "$local_toml" || fail "entry not added under the existing [dotfiles] table: $(cat "$local_toml")"
  [ "$(grep -c '^\[dotfiles\]' "$local_toml")" = 1 ] || fail "wrote a second [dotfiles] table into one that had it"
  ls "$HOME"/.dotfiles-migration-backup/*/files"$local_toml" > /dev/null 2>&1 || fail "config.local.toml not backed up before the write"
  # this Mac's case: the owner added the entry by hand under a comment header, so nothing is asked or written
  rm -rf "$HOME/.dotfiles-migration-backup"
  printf '# Machine-local mise config (gitignored).\n\n[dotfiles]\n# This Mac keeps its own list\n%s\n' "$entry" > "$local_toml"
  before=$(cksum < "$local_toml")
  out=$(echo y | "$script" --step dotfiles 2>&1) || true
  ! grep -q "Keep this Mac's Mole" <<< "$out" || fail "asked about a Mole entry that is already there"
  [ "$(cksum < "$local_toml")" = "$before" ] || fail "rewrote a config.local.toml that already had the entry"
  ! ls "$HOME"/.dotfiles-migration-backup/*/files"$local_toml" > /dev/null 2>&1 || fail "backed up config.local.toml with nothing to write"
  rm -rf "$local_toml" "$REPO_COPY/mole/whitelist.local" "$HOME/.dotfiles-migration-backup"
}
dotfiles_replaces_a_codex_config_link() {
  codex="$HOME/.codex/config.toml"
  src="$REPO_COPY/tilde/.codex/config.toml"
  # only the Codex edit is in play: the earlier cases' targets (the ~/.claude/skills conflict among them) would stop each run first
  cp "$STATE/dot-targets" "$tmp/dot-targets.saved"
  : > "$STATE/dot-targets"
  rm -f "$codex"
  ln -s "$src" "$codex" # an old symlinks.sh link into the clone
  before=$(snapshot)
  : > "$STATE/mise.log"
  out=$("$script" --step dotfiles < /dev/null 2>&1) || true # declined: the apply never runs, so the exit is the status check's 1
  [ -L "$codex" ] && [ "$(snapshot)" = "$before" ] && [ -z "$(mutations)" ] || fail "a declined run touched the codex link"
  check_out "names the codex link" '^~/\.codex/config\.toml: a link into the clone\. Removed before the apply'
  out=$(yes | "$script" --step dotfiles 2>&1) || fail "codex link into the clone: exit $?: $out"
  [ -f "$codex" ] && [ ! -L "$codex" ] || fail "codex config is still a link"
  [ "$(stat -f %Lp "$codex")" = 600 ] || fail "codex config is not 0600: the link was not removed before the apply"
  grep -qF "ln -sfn '$src' '$codex'" "$HOME"/.dotfiles-migration-backup/*/RESTORE.txt || fail "codex link not recorded"
  printf 'model = "x"\n\n[mcp_servers.t]\ncommand = "t"\n' > "$tmp/elsewhere.toml"
  rm "$codex"
  ln -s "$tmp/elsewhere.toml" "$codex" # a link somewhere else
  out=$(yes | "$script" --step dotfiles 2>&1) || fail "codex link elsewhere: exit $?: $out"
  [ -f "$codex" ] && [ ! -L "$codex" ] && cmp -s "$codex" "$tmp/elsewhere.toml" || fail "a link elsewhere was not replaced by a copy of its file"
  [ "$(stat -f %Lp "$codex")" = 600 ] || fail "the copy is not 0600"
  [ -f "$tmp/elsewhere.toml" ] || fail "removed the file the link pointed to"
  rm "$codex"
  printf 'model = "mine"\n' > "$codex" # valid TOML, the Mac's own
  chmod 644 "$codex"
  out=$(yes | "$script" --step dotfiles 2>&1) || fail "regular codex config: exit $?: $out"
  [ "$(cat "$codex")" = 'model = "mine"' ] && [ "$(stat -f %Lp "$codex")" = 644 ] || fail "touched a regular codex config"
  printf 'model = \n' > "$codex" # invalid TOML
  cp "$codex" "$tmp/codex.bad"
  : > "$STATE/mise.log"
  out=$(yes | "$script" --step dotfiles 2>&1) && fail "want exit 1 over an invalid codex config" || [ $? = 1 ] || fail "invalid codex config: want exit 1"
  check_out "names the invalid file" '^~/\.codex/config\.toml is not valid TOML'
  cmp -s "$codex" "$tmp/codex.bad" || fail "an invalid codex config was rewritten"
  ! grep -q 'dot apply --yes' "$STATE/mise.log" || fail "applied over an invalid codex config"
  printf 'model = "mine"\n' > "$codex"
  mv "$tmp/dot-targets.saved" "$STATE/dot-targets"
  rm -rf "$HOME/.dotfiles-migration-backup"
}
half_way_dotfiles() {
  # the conflict was backed up by an earlier run but apply never ran: ~/.zprofile is absent.
  # The ~/.claude/skills link with its target stops every run at "resolves into the clone" before the prompt, so it goes first
  rm -f "$HOME/.zprofile" "$HOME/.claude/skills"
  grep -v '/\.claude/skills/x' "$STATE/dot-targets" > "$STATE/t" && mv "$STATE/t" "$STATE/dot-targets"
  : > "$STATE/mise.log"
  out=$("$script" --step dotfiles --dry-run < /dev/null 2>&1) || true
  check_out "--dry-run shows the half-way question" '^would ask: Run mise dot apply to link what is missing\?$'
  out=$("$script" --step dotfiles < /dev/null 2>&1) || true
  check_out "closed stdin: tells the user what is left" '^Left as they are\. Finish with: mise dot apply$'
  out=$(echo y | "$script" --step dotfiles 2>&1) || fail "half-way rerun: exit $?: $out"
  grep -qx 'mise dot apply --yes' "$STATE/mise.log" || fail "did not finish the apply on the rerun"
  rm -rf "$HOME/.dotfiles-migration-backup"
}
