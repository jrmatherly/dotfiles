#!/bin/bash
#
# Self-check for the package and tool lists across the base and the modules (key shape, taps, no pins, nothing lost) and the vscode plugin.
#
# - Run it (pnpm check does too); exits 1 naming the first failed assertion:
#
# `test-packages`
#
# ---
# Reads conf.d/30-packages.toml, config.toml and every conf.d/60-rotm-*.toml under
# tilde/.config/mise with tomllib (or under the dir given as $1). Runs the
# mise-plugins/vscode hooks against a fake code with every mise dir in a temp
# dir. Installs nothing and never runs mise against the live config.
#
# License: MIT

set -euo pipefail

cd "$(dirname "$0")/../.."

# Print the failed assertion and stop
fail() {
  echo "FAIL: $1" >&2
  exit 1
}

# Python 3.11+ for tomllib: mise's, not macOS's 3.9 (the same switch as bin/lib/check)
if command -v mise > /dev/null && mise where python > /dev/null 2>&1; then
  py=(mise exec python -- python3)
else
  py=(python3)
fi

# The config dir to read: the tracked one, or the one given (a split written to a scratch dir is checked before it is copied in)
config_dir=${1:-tilde/.config/mise}

# check_lists <config dir>: the assertions below, on the tracked dir or a scratch copy
check_lists() {
  "${py[@]}" - "$1" "$(bin/lib/rotm-modules list)" << 'PY'

import re
import sys
import tomllib
from pathlib import Path

config_dir, modules = Path(sys.argv[1]), sys.argv[2].split()


class File:
    def __init__(self, name, *paths):
        self.name = name
        docs = [tomllib.loads(p.read_text()) for p in paths]
        boot = [d.get("bootstrap", {}) for d in docs]
        self.brew = {k: v for b in boot for k, v in b.get("brew", {}).items() if k != "taps"}
        self.taps = {k: v for b in boot for k, v in b.get("brew", {}).get("taps", {}).items()}
        self.packages = {k: v for b in boot for k, v in b.get("packages", {}).items()}
        self.tools = {k: v for d in docs for k, v in d.get("tools", {}).items()}


# The base is two files: mise reads [tools] from config.toml and the packages from the fragment
base = File("base", config_dir / "conf.d/30-packages.toml", config_dir / "config.toml")
mods = {n: File(n, config_dir / f"conf.d/60-rotm-{n}.toml") for n in modules}
files = [base, *mods.values()]

assert base.brew.get("adopt") is True, "[bootstrap.brew] adopt must be true"
assert all("homebrew_metadata" not in f.brew for f in files), "homebrew_metadata hands casks back to Homebrew"
assert all(not f.brew for f in mods.values()), "[bootstrap.brew] settings belong in the base"

every_package, all_tools, all_taps, dupes = {}, {}, {}, []
for f in files:
    for table, seen in ((f.packages, every_package), (f.tools, all_tools), (f.taps, all_taps)):
        # A tap may sit in two files whose packages both use it, at one URL (mise accepts the duplicate)
        dupes += [f"{k} ({f.name})" for k in table if k in seen and not (seen is all_taps and seen[k] == table[k])]
        seen.update(table)
assert not dupes, f"declared in two files: {dupes}"
assert all(v == "latest" for v in every_package.values()), "every package value is \"latest\": no pins, no inline tables"
managers = {k.split(":", 1)[0] for k in every_package}
assert managers == {"brew", "brew-cask", "vscode"}, managers


def tap_of(key):
    return "/".join(key.split(":", 1)[1].split("/")[:2])


def is_tap_key(key):
    return not key.startswith("vscode:") and key.count("/") == 2


for key in every_package:
    manager, name = key.split(":", 1)
    if is_tap_key(key):
        owner, tap, _ = name.split("/")
        assert all_taps.get(f"{owner}/{tap}") == f"https://github.com/{owner}/homebrew-{tap}.git", f"undeclared tap for {key}"
    if manager == "vscode":
        assert name == name.lower() and re.fullmatch(r"[a-z0-9-]+\.[a-z0-9-]+", name), key
# A tap sits in the file whose packages use it, so switching a module off drops its tap too
for f in files:
    used = {tap_of(k) for k in f.packages if is_tap_key(k)}
    assert set(f.taps) == used, f"{f.name}: tap declared but unused, or used but undeclared: {set(f.taps) ^ used}"
assert len(all_taps) <= 5, "more than 5 taps: a new Mac runs out of anonymous GitHub API calls (Review Focus 1)"
assert "brew:mise" not in every_package, "mise is installed by its own installer"

# The union is what the two files held before the split: nothing lost, nothing added
count = lambda m: sum(k.startswith(m + ":") for k in every_package)
assert (count("brew"), count("brew-cask"), count("vscode")) == (144, 34, 184), "counts changed: update this line with the entry you added or removed"
assert len(all_tools) == 27, f"{len(all_tools)} tools: update this line with the tool you added or removed"

# The base keeps what setup, sysup and the shell run without a guard, and what mise itself needs (ruby reads the tap cask)
for k in ("brew:uv", "brew:ruby", "brew:jq", "brew:minijinja-cli", "brew:git-lfs", "brew:git", "brew:zsh", "brew-cask:visual-studio-code"):
    assert k in base.packages, f"{k} must stay in the base"
assert set(base.tools) == {"node", "python", "hunk"}, set(base.tools)
assert not any(k.startswith("vscode:") for f in files if f.name != "vscode" for k in f.packages), "a vscode: key outside the vscode module"
fonts = mods["fonts"].packages
assert all(k.startswith("brew-cask:font-") for k in fonts) and len(fonts) == 7, fonts

# Files on disk and names in rotm-modules agree, and a name has one dot (mise 2027.8.10 reads a second segment as an environment)
on_disk = {p.name for p in (config_dir / "conf.d").glob("60-rotm-*")}
assert on_disk == {f"60-rotm-{n}.toml" for n in modules}, on_disk
assert all(p.name.count(".") == 1 for p in (config_dir / "conf.d").iterdir()), "a conf.d name with two dots"
PY
}
check_lists "$config_dir" || fail "the package and tool lists in $config_dir"

# The flux2 and talosctl postinstall hooks write their zsh completions (P13)
hooks=$(
  "${py[@]}" - "$config_dir" << 'PY'
import sys
import tomllib
from pathlib import Path

tools = tomllib.loads((Path(sys.argv[1]) / "conf.d/60-rotm-kubernetes.toml").read_text())["tools"]
for tool, binary in (("flux2", "flux"), ("talosctl", "talosctl")):
    entry = tools.get(tool)
    ok = isinstance(entry, dict) and entry.get("version") == "latest" and entry.get("postinstall", {}).get("when") == "always"
    assert ok, f"{tool} has no postinstall that writes its completion (P13)"
    print(f"{binary}\t{entry['postinstall']['run']}")
PY
) || fail "the kubernetes module's completion hooks"

repo=$PWD
tmp=$(cd "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$tmp"' EXIT

# The same tap at two different URLs still fails
cp -R "$config_dir" "$tmp/two-urls"
sed -i '' 's#^"jrmatherly/tap" = "[^"]*"#"jrmatherly/tap" = "https://example.com/homebrew-tap.git"#' "$tmp/two-urls/conf.d/60-rotm-menubar.toml"
if check_lists "$tmp/two-urls" 2> /dev/null; then fail "one tap at two URLs passed"; fi
mkdir -p "$tmp/fakebin" "$tmp/home" "$tmp/empty"
comp="$tmp/home/.cache/dotfiles/completions"
while IFS=$'\t' read -r binary run; do
  printf '#!/bin/sh\n[ "$*" = "completion zsh" ] || exit 1\necho "#compdef %s"\n' "$binary" > "$tmp/fakebin/$binary"
  chmod +x "$tmp/fakebin/$binary"
  for _ in 1 2; do
    env -i HOME="$tmp/home" PATH="$tmp/fakebin:/usr/bin:/bin" /bin/sh -c "$run" \
      || fail "$binary postinstall exited non-zero"
  done
  [ "$(cat "$comp/_$binary" 2> /dev/null)" = "#compdef $binary" ] \
    || fail "$comp/_$binary is not exactly '#compdef $binary' after two runs"
done <<< "$hooks"

first=$(env -i HOME="$tmp/home" DOTFILES="$repo" /bin/zsh -fc 'source "$DOTFILES/zsh/completion.zsh"; print -r -- $fpath[1]')
[ "$first" = "$comp" ] || fail "zsh/completion.zsh does not put $comp first in fpath (got $first)"
first=$(env -i HOME="$tmp/empty" DOTFILES="$repo" /bin/zsh -fc 'source "$DOTFILES/zsh/completion.zsh"; print -r -- $fpath[1]')
case $first in "$tmp/empty"*) fail "zsh/completion.zsh adds a completions dir that does not exist" ;; esac

# The vscode plugin against a fake code, with every mise dir and HOME in the temp dir
if ! command -v mise > /dev/null; then
  echo "test-packages: mise is not on PATH, skipping the vscode plugin cases" >&2
  exit 0
fi
v="$tmp/vscode"
mkdir -p "$v/bin" "$v/misebin" "$v/home" "$v/cfg/conf.d" "$v/cfg2/conf.d"
# mise alone on PATH: its own dir (/opt/homebrew/bin here) also holds the real code
ln -s "$(command -v mise)" "$v/misebin/mise"
log="$v/code.log"
cat > "$v/bin/code" << FAKE
#!/bin/sh
echo "\$*" >> "$log"
case "\$*" in
  "--list-extensions --show-versions") printf 'ms-python.python@2026.1.0\nGolang.Go@0.50.0\n' ;;
  "--install-extension bad.ext") exit 1 ;;
esac
FAKE
chmod +x "$v/bin/code"
{ echo '[bootstrap.packages]'; printf '"vscode:%s" = "latest"\n' ms-python.python golang.go eamodio.gitlens; } \
  > "$v/cfg/conf.d/30-packages.toml"
{ echo '[bootstrap.packages]'; printf '"vscode:%s" = "latest"\n' aaa.first bad.ext zzz.last; } \
  > "$v/cfg2/conf.d/30-packages.toml"

# mise with only temp state, from the temp dir; cfg= and path= override the config dir and PATH
vmise() {
  (cd "$v" && env -i HOME="$v/home" TMPDIR="$v" PATH="${path:-$v/bin:$v/misebin:/usr/bin:/bin}" \
    MISE_CONFIG_DIR="$v/${cfg:-cfg}" MISE_TRUSTED_CONFIG_PATHS="$v/${cfg:-cfg}" \
    MISE_DATA_DIR="$v/data" MISE_STATE_DIR="$v/state" MISE_CACHE_DIR="$v/cache" mise "$@")
}

vmise plugins link --force vscode "$repo/mise-plugins/vscode" > /dev/null 2>&1 || fail "vscode: link"
# link exits 0 for a missing dir too; plugins ls lists only a plugin that loads
vmise plugins ls 2> /dev/null | grep -qx vscode || fail "vscode: link (plugins ls does not list vscode)"

: > "$log"
vmise bootstrap packages status --json 2> /dev/null > "$v/status.json" || fail "vscode: status --json"
"${py[@]}" - "$v/status.json" << 'PY' || fail "vscode: status --json states"
import json, sys

pkgs = {p["package"]: p for p in json.load(open(sys.argv[1]))["vscode"]["packages"]}
got = {k: (p["state"], p["installed_version"]) for k, p in pkgs.items()}
want = {"ms-python.python": ("installed", "2026.1.0"), "golang.go": ("installed", "0.50.0"), "eamodio.gitlens": ("missing", "")}
assert got == want, got
PY
[ -s "$log" ] && ! grep -vqx -- '--list-extensions --show-versions' "$log" \
  || fail "vscode: status ran code with something other than --list-extensions --show-versions"

rc=0
vmise bootstrap packages status --missing > /dev/null 2>&1 || rc=$?
[ "$rc" = 1 ] || fail "vscode: status --missing exited $rc, not 1"

out=$(vmise bootstrap packages apply --dry-run 2>&1) || fail "vscode: apply --dry-run"
grep -q 'would install eamodio.gitlens' <<< "$out" || fail "vscode: dry run does not print 'would install eamodio.gitlens'"
! grep -q -- '--install-extension' "$log" || fail "vscode: dry run ran code --install-extension"

vmise bootstrap packages apply --yes > /dev/null 2>&1 || fail "vscode: apply --yes"
[ "$(grep -c -- '--install-extension' "$log")" = 1 ] && grep -qx -- '--install-extension eamodio.gitlens' "$log" \
  || fail "vscode: apply did not run exactly one install, for eamodio.gitlens"

vmise bootstrap packages upgrade --yes > /dev/null 2>&1 || fail "vscode: upgrade --yes"
[ "$(grep -c -- '--install-extension' "$log")" = 1 ] || fail "vscode: upgrade ran code --install-extension"

: > "$log"
rc=0
out=$(cfg=cfg2 vmise bootstrap packages apply --yes 2>&1) || rc=$?
[ "$rc" != 0 ] || fail "vscode: apply with a failing extension exited 0"
for id in aaa.first bad.ext zzz.last; do
  grep -qx -- "--install-extension $id" "$log" || fail "vscode: one failed install stopped the install of $id"
done
failed=$(grep 'failed to install' <<< "$out") || fail "vscode: no 'failed to install' error in: $out"
grep -q 'bad\.ext' <<< "$failed" && ! grep -qE 'aaa\.first|zzz\.last' <<< "$failed" \
  || fail "vscode: the error names the wrong ids: $failed"

# One extension skipped from config.local.toml: installed (ms-python.python) and not (eamodio.gitlens)
mkdir -p "$v/cfg3/conf.d"
{ echo '[bootstrap.packages]'; printf '"vscode:%s" = "latest"\n' ms-python.python eamodio.gitlens; } \
  > "$v/cfg3/conf.d/30-packages.toml"
{ echo '[bootstrap.packages]'; printf '"vscode:%s" = { state = "absent" }\n' ms-python.python eamodio.gitlens; } \
  > "$v/cfg3/config.local.toml"
cfg=cfg3 vmise bootstrap packages status --json 2> /dev/null > "$v/absent.json" || fail "vscode: status with absent keys"
"${py[@]}" - "$v/absent.json" << 'PY' || fail "vscode: states of extensions declared absent"
import json, sys

got = {p["package"]: p["state"] for p in json.load(open(sys.argv[1]))["vscode"]["packages"]}
assert got == {"ms-python.python": "unexpectedly_installed", "eamodio.gitlens": "absent"}, got
PY
: > "$log"
# setup.sh passes --manager, and mise fails an installed package declared absent only then
rc=0
out=$(cfg=cfg3 vmise bootstrap packages apply --yes --manager vscode 2>&1) || rc=$?
[ "$rc" = 1 ] && grep -q 'does not support declarative package removal' <<< "$out" \
  || fail "vscode: apply --manager with an installed extension declared absent exited $rc: $out"
rc=0
out=$(cfg=cfg3 vmise bootstrap packages apply --yes 2>&1) || rc=$?
[ "$rc" = 0 ] || fail "vscode: apply without --manager and an installed extension declared absent exited $rc: $out"
! grep -q -- '--install-extension' "$log" || fail "vscode: an absent extension was installed"
! grep -q -- '--uninstall-extension' "$log" || fail "vscode: an absent extension was removed"
# sysup runs upgrade, with no --manager, and reports a non-zero exit as a failed step
cfg=cfg3 vmise bootstrap packages upgrade --yes > /dev/null 2>&1 \
  || fail "vscode: upgrade with an installed extension declared absent"

nocode="$v/misebin:/usr/bin:/bin"
! env -i PATH="$nocode" /bin/sh -c 'command -v code' > /dev/null || fail "vscode: code is on the no-code PATH"
path=$nocode vmise bootstrap packages status --json 2> /dev/null > "$v/nocode.json" \
  || fail "vscode: status --json fails without code on PATH"
"${py[@]}" - "$v/nocode.json" << 'PY' || fail "vscode: without code the manager is not reported unavailable"
import json, sys

doc = json.load(open(sys.argv[1]))
assert "vscode" not in doc or doc["vscode"]["available"] is False, doc.get("vscode")
PY
