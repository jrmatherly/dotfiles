#!/bin/bash
#
# Self-check for the zsh config that agent and user shells load.
#
# - Run it (pnpm check does too); exits 1 naming the first failed assertion:
#
# `test-shell`
#
# ---
# Runs interactive zsh against this repo's tilde/.zshrc through a temp ZDOTDIR
# (never ~/.zshrc), with the parent's tokens and CLAUDECODE stripped so the
# config alone decides each result. An assertion needing a missing tool skips.
#
# License: MIT

set -euo pipefail

repo="$(cd "$(dirname "$0")/../.." && pwd -P)"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
printf 'export DOTFILES=%q\n' "$repo" > "$tmp/.zshenv"
printf 'source "$DOTFILES/tilde/.zshrc"\n' > "$tmp/.zshrc"

# Print the failed assertion and stop
fail() {
  echo "FAIL: $1" >&2
  exit 1
}

# Return 1 (with a skip note on stderr) when a tool isn't installed
need() {
  command -v "$1" > /dev/null || {
    echo "skip: $1 not installed" >&2
    return 1
  }
}

# Run zsh code in an interactive shell built from the repo config; stdout only
run_zsh() {
  env -u GITHUB_TOKEN -u GH_TOKEN -u GIGET_AUTH -u CLAUDECODE -u RIPGREP_CONFIG_PATH \
    ZDOTDIR="$tmp" "$@" < /dev/null 2> /dev/null
}

# Agent shell: what Claude Code's Bash tool gets (CLAUDECODE=1)
agent_zsh() { run_zsh CLAUDECODE=1 zsh -i -c "$1"; }

# User shell: CLAUDECODE unset
user_zsh() { run_zsh zsh -i -c "$1"; }

# `.` is the source builtin, not an alias
printf 'echo sourced-ok\n' > "$tmp/s.zsh"
[ "$(agent_zsh ". $tmp/s.zsh")" = sourced-ok ] || fail "agent shell: . does not source"
[ "$(user_zsh ". $tmp/s.zsh")" = sourced-ok ] || fail "user shell: . does not source"

# Agent shells keep the builtin cd (zoxide as z); user shells keep zoxide's cd
# (`--cmd cd` defines cd and cdi, not z)
if need zoxide; then
  out=$(agent_zsh 'whence -w cd')
  [ "$out" = "cd: builtin" ] || fail "agent shell: cd is $out"
  agent_zsh 'whence -w z' | grep -q function || fail "agent shell: z is not defined"
  [ "$(user_zsh 'whence -w cd')" = "cd: function" ] || fail "user shell: cd is not zoxide's"
fi

# No shell exports the gh token
if need gh; then
  [ -z "$(agent_zsh 'echo -n $GITHUB_TOKEN$GIGET_AUTH')" ] || fail "agent shell exports a GitHub token"
  [ -z "$(user_zsh 'echo -n $GITHUB_TOKEN$GIGET_AUTH')" ] || fail "user shell exports a GitHub token"
fi

# The git wrapper keeps every argument, agent shells skip it, clone installs nothing
[ "$(user_zsh 'git rev-parse --sq-quote "" "a b"')" = " '' 'a b'" ] || fail "git wrapper drops empty args"
agent_zsh 'whence -w git' | grep -q command || fail "agent shell still has the git wrapper"
! user_zsh 'whence -f git' | grep -qE 'yarn|pnpm install|npm install|bun install' || fail "git clone still auto-installs"
# Flags before the URL must not decide the cd target (`--depth 1` once meant cd 1)
mkdir -p "$tmp/o/origin" "$tmp/w"
git -C "$tmp/o/origin" init -q
git -C "$tmp/o/origin" -c user.name=t -c user.email=t@t -c commit.gpgsign=false commit -q --allow-empty -m init
out=$(user_zsh "cd $tmp/w && git clone -q --depth 1 file://$tmp/o/origin && pwd")
[ "$out" = "$tmp/w/origin" ] || fail "git clone landed in '$out', not $tmp/w/origin"

# rg prints path:line:text (-H: one file omits the path): the repo config keeps
# the separator, agent shells skip the config
if need rg; then
  (cd "$repo" && RIPGREP_CONFIG_PATH=tilde/.ripgreprc rg -Hn fsmonitor tilde/.gitconfig) \
    | grep -qE '^tilde/\.gitconfig:[0-9]+:' || fail "tilde/.ripgreprc output is not path:line:text"
  [ -z "$(agent_zsh 'echo -n $RIPGREP_CONFIG_PATH')" ] || fail "agent shell sets RIPGREP_CONFIG_PATH"
  agent_zsh "cd $repo && rg -Hn fsmonitor tilde/.gitconfig" | grep -qE '^tilde/\.gitconfig:[0-9]+:' || fail "agent rg output is not path:line:text"
fi

# No alias shadows the linker or zsh's where builtin
! user_zsh 'alias ld' > /dev/null || fail "ld alias shadows the linker"
[ "$(user_zsh 'whence -w where')" = "where: builtin" ] || fail "where is not the builtin"

# The completion dump is fresh on its own day, below day 100 too (`date +%j` is 027, not 27)
touch -t 202601271200 "$tmp/dump"
[ "$(user_zsh "today=027; zcompdump_is_stale $tmp/dump && echo stale || echo fresh")" = fresh ] || fail "compinit cache miss on a day below 100"
[ "$(user_zsh "today=028; zcompdump_is_stale $tmp/dump && echo stale || echo fresh")" = stale ] || fail "compinit cache never goes stale"

# The Homebrew zsh plugins load (source_brew_plugin finds them under HOMEBREW_PREFIX)
if need brew && brew --prefix zsh-autosuggestions > /dev/null 2>&1; then
  user_zsh 'whence -w _zsh_autosuggest_start' | grep -q function || fail "zsh-autosuggestions did not load"
fi

# Interactive shells keep the PATH they inherit (a login shell's .zprofile
# entries, SnippetsLab's appended one included), with the repo's entries first
mkdir -p "$tmp/probe-bin"
lab=/Applications/SnippetsLab.app/Contents/Helpers
out=$(PATH="$tmp/probe-bin:$PATH:$lab" user_zsh 'echo $PATH' | tr : '\n')
grep -qx "$tmp/probe-bin" <<< "$out" || fail "an inherited PATH entry was dropped"
[ ! -d "$lab" ] || grep -qx "$lab" <<< "$out" || fail "SnippetsLab's lab dropped from PATH"
[ "$(grep -nx "$repo/bin" <<< "$out" | cut -d: -f1)" -lt "$(grep -nx "$tmp/probe-bin" <<< "$out" | cut -d: -f1)" ] || fail "repo bin is not ahead of the inherited PATH"

# npm init's author comes from the identity tilde/.gitconfig includes from ~/.gitconfig.local
if git config -f ~/.gitconfig.local user.name > /dev/null 2>&1; then
  [ -n "$(user_zsh 'echo -n $NPM_CONFIG_INIT_AUTHOR_NAME')" ] || fail "NPM_CONFIG_INIT_AUTHOR_NAME is empty"
fi

echo "shell: all checks passed"
