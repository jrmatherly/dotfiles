#!/bin/bash
#
# Self-check for hindsight-memory against a fixture HOME.
#
# - Run it (pnpm check does too); exits 1 naming the first failed assertion:
#
# `test-hindsight-memory`
#
# ---
# Never touches the real ~/.hindsight, Claude Code or Codex config: HOME is a
# temp dir, and the vendor installer, hindsight-embed, npm and uv are stub
# scripts that log their arguments.
#
# License: MIT

set -euo pipefail

script="$(cd "$(dirname "$0")/.." && pwd -P)/hindsight-memory"
repo="$(cd "$(dirname "$0")/../.." && pwd -P)"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT

mkdir -p "$tmp/bin"
# mise's shims stay off PATH, as on CI: under a fake HOME one starts cold and
# fetches every tool's versions from the network before it runs anything
PATH=$(tr ':' '\n' <<< "$PATH" | grep -v '/mise/shims$' | paste -sd: -)

# mktemp's /var/… is a symlink to /private/var/…; use the real path so HOME
# looks like a shell's
HOME=$(cd "$tmp" && pwd -P)
export HOME
export HINDSIGHT_CONFIG="$HOME/.hindsight/coding-agent.json"
export HINDSIGHT_MEMORY_INSTALLER="$HOME/bin/installer"
export HINDSIGHT_MEMORY_EMBED="$HOME/bin/embed"
export HINDSIGHT_MEMORY_NPM="$HOME/bin/npm"
export HINDSIGHT_MEMORY_UV="$HOME/bin/uv"
export HINDSIGHT_DAEMON_ENV="$HOME/.hindsight/daemon-env"
# for the timeout stub; the script reaches every other stub through its override
PATH="$HOME/bin:$PATH"
cfg=$HINDSIGHT_CONFIG

mkdir -p "$HOME/bin"
cat > "$HOME/bin/installer" << 'EOF'
#!/bin/bash
echo "$*" >> "$HOME/installer.log"
if [ "$1" = install ]; then
  [ -e "$HOME/installer-fails" ] && exit 1
  # like the real installer: set serverMode, keep every other key
  mkdir -p "$(dirname "$HINDSIGHT_CONFIG")"
  { cat "$HINDSIGHT_CONFIG" 2> /dev/null || echo '{}'; } | jq -c '.serverMode = "daemon"' > "$HINDSIGHT_CONFIG.s"
  mv "$HINDSIGHT_CONFIG.s" "$HINDSIGHT_CONFIG"
fi
exit 0
EOF
cat > "$HOME/bin/embed" << 'EOF'
#!/bin/bash
echo "$*" >> "$HOME/embed.log"
[ ! -e "$HOME/embed-fails" ] || exit 1
EOF
cat > "$HOME/bin/timeout" << 'EOF'
#!/bin/bash
echo "$*" >> "$HOME/timeout.log"
shift
exec "$@"
EOF
# the stub answers with the script's own pin by default, so a pin bump keeps the equal-to-pin case covered
sed -n 's/^CODING_AGENTS_VERSION=//p' "$script" > "$HOME/pin"
cat > "$HOME/bin/npm" << 'EOF'
#!/bin/bash
[ "$1 $2 $3" = 'pack --dry-run --json' ] || { echo "npm stub: unexpected args $*" >&2; exit 2; }
if [ -e "$HOME/npm-newer" ]; then v=99.0.0; elif [ -e "$HOME/npm-older" ]; then v=0.0.1; else v=$(cat "$HOME/pin"); fi
echo "[{\"version\":\"$v\"}]"
EOF
cat > "$HOME/bin/uv" << 'EOF'
#!/bin/bash
echo "$*" >> "$HOME/uv.log"
[ ! -e "$HOME/uv-fails" ] || exit 1
if [ "$1" = sync ]; then
  mkdir -p "$HINDSIGHT_DAEMON_ENV/.venv/bin"
  touch "$HINDSIGHT_DAEMON_ENV/.venv/bin/hindsight-embed"
  chmod +x "$HINDSIGHT_DAEMON_ENV/.venv/bin/hindsight-embed"
fi
exit 0
EOF
chmod +x "$HOME"/bin/*
embed_version=$(sed -n 's/.*"hindsight-embed==\([^"]*\)".*/\1/p' "$repo/hindsight/pyproject.toml")
hm() { "$script" "$@"; }

check() {
  if [[ $2 != "$3" ]]; then
    printf 'FAIL: %s\n  expected: %s\n  actual:   %s\n' "$1" "$2" "$3" >&2
    exit 1
  fi
  echo "ok: $1"
}
check_true() {
  local name=$1
  shift
  "$@" || {
    echo "FAIL: $name" >&2
    exit 1
  }
  echo "ok: $name"
}

check_true "init runs the installer once with both harnesses" hm init
check "installer args" "install claude-code codex --server daemon" "$(cat "$HOME/installer.log")"
check "init writes the default paths" '["~/dev"]' "$(jq -c .optInPaths "$cfg")"
check "init writes the other defaults" "daemon true false $embed_version false pages H */6 * * * 10 redact" "$(jq -r '[.serverMode, .optInOnly, .autoUpdate, .embedVersion, .codebaseSurvey, .autoInject, .pageTriggerCron, .pageRefreshEveryTurns, .defaultBankConfig.memory_defense.rules[0].action] | join(" ")' "$cfg")"
check "init writes the tool guide line" true "$(jq '.toolGuideExtra | startswith("Memory is a past record")' "$cfg")"
jq '.optInPaths = ["~/work"]' "$cfg" > "$cfg.t" && mv "$cfg.t" "$cfg"
check_true "init again keeps the edited list and skips the installer" hm init
check "edited list kept" '["~/work"]' "$(jq -c .optInPaths "$cfg")"
check "installer not rerun by init" 1 "$(wc -l < "$HOME/installer.log" | tr -d ' ')"
jq '.embedVersion = "9.9.9"' "$cfg" > "$cfg.t" && mv "$cfg.t" "$cfg"
check_true "init resets embedVersion to the pin" hm init
check "embedVersion follows the pin" "$embed_version" "$(jq -r .embedVersion "$cfg")"
jq '.pageTriggerCron = "0 6 * * *" | .autoInject = "reflect"' "$cfg" > "$cfg.t" && mv "$cfg.t" "$cfg"
check_true "init migrates the old repo cron" hm init
check "old repo cron moves to the current default, a chosen autoInject stays" "H */6 * * * reflect" "$(jq -r '[.pageTriggerCron, .autoInject] | join(" ")' "$cfg")"
jq '.pageTriggerCron = "H 3 * * *"' "$cfg" > "$cfg.t" && mv "$cfg.t" "$cfg"
check_true "init keeps a user cron" hm init
check "user cron kept" "H 3 * * *" "$(jq -r .pageTriggerCron "$cfg")"
check_true "upgrade reruns the installer" hm upgrade
check "installer rerun by upgrade" 2 "$(wc -l < "$HOME/installer.log" | tr -d ' ')"
check "upgrade keeps the edited list" '["~/work"]' "$(jq -c .optInPaths "$cfg")"
check "no notice when npm has the pinned version" "" "$(hm upgrade | grep 'newer release' || true)"
touch "$HOME/npm-older"
check "no notice when npm's latest is older than the pin" "" "$(hm upgrade | grep 'newer release' || true)"
rm "$HOME/npm-older"
touch "$HOME/npm-newer"
check "upgrade notices a newer release" "newer release 99.0.0 on npm; bump CODING_AGENTS_VERSION" "$(hm upgrade | grep 'newer release')"
# apiPort 1 keeps the self-check off a daemon that may be running on this machine
jq '.apiPort = 1' "$cfg" > "$cfg.t" && mv "$cfg.t" "$cfg"
check "init copies the lock" "$(cksum < "$repo/hindsight/uv.lock")" "$(cksum < "$HINDSIGHT_DAEMON_ENV/uv.lock")"
check "init syncs the environment frozen" "sync --frozen --directory $HINDSIGHT_DAEMON_ENV" "$(tail -1 "$HOME/uv.log")"
check "init points the hook at the environment" "$HINDSIGHT_DAEMON_ENV" "$(jq -r .embedPackagePath "$cfg")"
jq '.embedPackagePath = "/stale"' "$cfg" > "$cfg.t" && mv "$cfg.t" "$cfg"
check_true "init again" hm init
check "a hand-edited embedPackagePath is reset" "$HINDSIGHT_DAEMON_ENV" "$(jq -r .embedPackagePath "$cfg")"
check_true "an init that built the first environment left the daemon alone" bash -c '! grep -q "daemon stop" "$HOME/embed.log" 2> /dev/null'
echo older > "$HINDSIGHT_DAEMON_ENV/.synced"
check "init on a changed lock reports the change" "daemon environment updated" "$(hm init | grep 'daemon environment')"
check "init on a changed lock stops the daemon once" 1 "$(grep -c -- '-p coding-agent daemon stop' "$HOME/embed.log")"
: > "$HOME/embed.log"
check "upgrade, lock unchanged" ok "$(hm upgrade > /dev/null && echo ok)"
check "no daemon stop when the lock is unchanged" 0 "$(grep -c 'daemon stop' "$HOME/embed.log" || true)"
echo older > "$HINDSIGHT_DAEMON_ENV/.synced"
check "upgrade reports the change" "daemon environment updated" "$(hm upgrade | grep 'daemon environment')"
check "a changed lock stops the daemon once" 1 "$(grep -c -- '-p coding-agent daemon stop' "$HOME/embed.log")"
check_true "the stop is bounded" grep -qx -- "30 $HOME/bin/embed -p coding-agent daemon stop" "$HOME/timeout.log"
echo older > "$HINDSIGHT_DAEMON_ENV/.synced"
touch "$HOME/embed-fails"
stuck=$(hm upgrade 2>&1 > /dev/null)
rm "$HOME/embed-fails"
check_true "a daemon that did not stop is a warning with the command" grep -q "did not stop and still runs the old environment; stop it with: $HOME/bin/embed -p coding-agent daemon stop" <<< "$stuck"
: > "$HOME/embed.log"
echo older > "$HINDSIGHT_DAEMON_ENV/.synced"
hm upgrade > /dev/null
touch "$HOME/uv-fails"
warned=$(hm upgrade 2>&1 > /dev/null)
check_true "a failed sync warns with the recovery command" grep -q 'did not build; run: hindsight-memory upgrade' <<< "$warned"
check_true "a failed sync leaves no installed lock" [ ! -e "$HINDSIGHT_DAEMON_ENV/uv.lock" ]
check "a failed sync unsets embedPackagePath" null "$(jq -c .embedPackagePath "$cfg")"
rm "$HOME/uv-fails"
check "upgrade recovers" ok "$(hm upgrade > /dev/null && echo ok)"
check "recovering on the same lock leaves the daemon alone" 1 "$(grep -c -- '-p coding-agent daemon stop' "$HOME/embed.log")"
check "embedPackagePath is back" "$HINDSIGHT_DAEMON_ENV" "$(jq -r .embedPackagePath "$cfg")"
: > "$HOME/uv.log"
bash -c 'unset HINDSIGHT_MEMORY_EMBED; "$0" status' "$script" > /dev/null
check_true "status runs hindsight-embed from the environment" grep -qx -- "run --frozen --directory $HINDSIGHT_DAEMON_ENV hindsight-embed -p coding-agent daemon status" "$HOME/uv.log"
check_true "paths add strips a trailing slash and collapses HOME" hm paths add "$HOME/dev/x/"
check "stored list" '["~/work","~/dev/x"]' "$(jq -c .optInPaths "$cfg")"
check_true "paths add is idempotent" hm paths add "$HOME/dev/x"
check "no duplicate" 2 "$(jq '.optInPaths | length' "$cfg")"
check_true "paths add keeps a path outside HOME" hm paths add /opt/src
check_true "paths add does not collapse a sibling of HOME" hm paths add "${HOME}2/x"
check_true "paths add resolves a relative path against the current directory" bash -c 'cd "$1" && "$0" paths add rel/y && "$0" paths remove ~/rel/y' "$script" "$HOME"
check "outside and sibling stored literally" "/opt/src ${HOME}2/x" "$(jq -r '.optInPaths[2:] | join(" ")' "$cfg")"
# shellcheck disable=SC2088 # the literal ~ is the stored form under test
check "paths list prints one per line" "$(printf '~/work\n~/dev/x\n/opt/src\n%s2/x' "$HOME")" "$(hm paths list)"
check "bare paths lists too" "$(hm paths list)" "$(hm paths)"
check_true "paths remove drops the path" hm paths remove ~/work
check "removed" '["~/dev/x","/opt/src","'"${HOME}"'2/x"]' "$(jq -c .optInPaths "$cfg")"
check_true "paths remove of an unknown path exits 1" bash -c '! "$0" paths remove ~/nope 2> /dev/null' "$script"
check_true "off writes disabled" hm off
check "disabled true" true "$(jq .disabled "$cfg")"
check_true "on clears it" hm on
check "disabled false" false "$(jq .disabled "$cfg")"
check_true "survey on writes codebaseSurvey" hm survey on
check "survey true" true "$(jq .codebaseSurvey "$cfg")"
check_true "status prints the config summary" bash -c '"$0" status | grep -q "optInPaths"' "$script"
check_true "status says when the daemon is unreachable" bash -c '"$0" status | grep -q "daemon not reachable at http://127.0.0.1:1$"' "$script"
check_true "uninstall calls the vendor uninstall and stops the daemon" hm uninstall
check "uninstall args" "uninstall claude-code codex" "$(tail -1 "$HOME/installer.log")"
check "daemon stopped" "-p coding-agent daemon stop" "$(tail -1 "$HOME/embed.log")"
check_true "uninstall sets the config aside so sysup skips it" test ! -e "$cfg" -a -f "$cfg.uninstalled"
check "status after uninstall says so instead of failing" "uninstalled (config kept at $cfg.uninstalled; run: hindsight-memory init)" "$(hm status)"
check_true "init after uninstall restores the config and reruns the installer" hm init
check "restored list" '["~/dev/x","/opt/src","'"${HOME}"'2/x"]' "$(jq -c .optInPaths "$cfg")"
check "installer rerun after uninstall" "install claude-code codex --server daemon" "$(tail -1 "$HOME/installer.log")"
touch "$HOME/installer-fails"
before=$(cat "$cfg")
check_true "upgrade exits 1 when the installer fails and keeps the config" bash -c '! "$0" upgrade > /dev/null 2>&1' "$script"
check "config unchanged after the failed upgrade" "$before" "$(cat "$cfg")"
rm "$HOME/installer-fails"
echo '{not json' > "$cfg"
check_true "an invalid config fails instead of being replaced" bash -c '! "$0" on 2> /dev/null && [ "$(cat "$1")" = "{not json" ] && [ ! -e "$1.tmp" ]' "$script" "$cfg"
rm "$cfg"
check_true "paths add without a config exits 1 and creates nothing" bash -c '! "$0" paths add ~/dev/y 2> /dev/null && [ ! -e "$1" ]' "$script" "$cfg"
check_true "off without a config exits 1 and creates nothing" bash -c '! "$0" off 2> /dev/null && [ ! -e "$1" ]' "$script" "$cfg"
touch "$HOME/installer-fails"
check_true "init exits 1 when the installer fails and leaves no config" bash -c '! "$0" init > /dev/null 2>&1 && [ ! -e "$HINDSIGHT_CONFIG" ]' "$script"
check "a failed init unwires whatever the installer managed to wire" "uninstall claude-code codex" "$(tail -1 "$HOME/installer.log")"
check_true "upgrade exits 1 when the installer fails" bash -c '! "$0" upgrade > /dev/null 2>&1' "$script"

# The hooks read the pins from the environment Claude Code gives them: tilde/.zshenv
# for terminals, the settings env for the app. A pin missing from one file reverts
# that launch path to the provider's default model without any error.
check "zshenv and claude-settings.json agree on the Hindsight pins" \
  "$(grep -oE '^export HINDSIGHT_API_[A-Z_]*LLM_(PROVIDER|MODEL)=.*' "$repo/tilde/.zshenv" | sed 's/^export //' | sort)" \
  "$(jq -r '.env | to_entries[] | select(.key | test("^HINDSIGHT_API_[A-Z_]*LLM_(PROVIDER|MODEL)$")) | "\(.key)=\(.value)"' "$repo/agents/claude-settings.json" | sort)"
