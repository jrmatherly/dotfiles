#!/bin/bash
#
# Self-check for claude-config save against fixture dirs.
#
# - Run it (pnpm check does too); exits 1 when an assertion fails:
#
# `test-claude-config`
#
# ---
# Never touches the real ~/.claude or agents/: HOME, CLAUDE_CONFIG_DIR and
# CLAUDE_CONFIG_SAVE_DIR are temp dirs. Runs once per bash (macOS 3.2 and
# Homebrew's 5, where ~ in a substitution's replacement is expanded).
#
# License: MIT

set -u

if [ -z "${TEST_CLAUDE_CONFIG_BASH:-}" ]; then
  rc=0
  for b in /bin/bash /opt/homebrew/bin/bash; do
    [ -x "$b" ] || continue
    echo "== $b"
    TEST_CLAUDE_CONFIG_BASH=$b "$b" "$0" || rc=1
  done
  exit "$rc"
fi

script="$(cd "$(dirname "$0")/.." && pwd -P)/claude-config"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
# jq can be a mise shim, which refuses the global config under a fake HOME
# unless mise's trust records stay in the real state dir
export MISE_STATE_DIR="${MISE_STATE_DIR:-$HOME/.local/state/mise}"
# The config dir sits under HOME so the warnings have a path to shorten to ~
export HOME="$tmp/home" CLAUDE_CONFIG_DIR="$tmp/home/.claude" CLAUDE_CONFIG_SAVE_DIR="$tmp/save"
mkdir -p "$CLAUDE_CONFIG_DIR/plugins" "$CLAUDE_CONFIG_SAVE_DIR"
list="$CLAUDE_CONFIG_SAVE_DIR/claude-plugins.txt"
printf 'marketplace a b\nplugin x@a\nplugin y@a disabled\n' > "$list"
fails=0

check() {
  if eval "$2"; then echo "ok   $1"; else
    echo "FAIL $1"
    fails=$((fails + 1))
  fi
}
cc() { "$TEST_CLAUDE_CONFIG_BASH" "$script" "$@"; }

echo '{"plugins": {' > "$CLAUDE_CONFIG_DIR/plugins/installed_plugins.json"
cc save plugins > /dev/null 2> "$tmp/err"
check "corrupt registry keeps the list" "[ \"\$(grep -c '^plugin ' '$list')\" = 2 ]"
check "corrupt registry warns" "grep -q 'not a valid JSON object' '$tmp/err'"
check "no tmp file left" "[ ! -e '$list.tmp' ]"
check "warning paths use ~" "grep -q '~/' '$tmp/err'"

printf '{"plugins":{"x@a":[{"scope":"user"}],"y@a":[{"scope":"user"}]}}' > "$CLAUDE_CONFIG_DIR/plugins/installed_plugins.json"
printf '{"enabledPlugins":{"y@a":false},"env":{"CLAUDE_CODE_OAUTH_TOKEN":"x","CLAUDE_CODE_CERT_STORE":"bundled,system","DISABLE_TELEMETRY":"1","MAX_THINKING_TOKENS":"8000"}}' > "$CLAUDE_CONFIG_DIR/settings.json"
cc save settings > /dev/null 2>&1
check "valid registry saves its plugins" "grep -qx 'plugin y@a disabled' '$list' && [ \"\$(grep -c '^plugin ' '$list')\" = 2 ]"
check "token never saved" "! grep -q OAUTH_TOKEN '$CLAUDE_CONFIG_SAVE_DIR/claude-settings.json'"
check "token counts kept" "grep -q MAX_THINKING_TOKENS '$CLAUDE_CONFIG_SAVE_DIR/claude-settings.json'"
check "cert store kept" "grep -q CERT_STORE '$CLAUDE_CONFIG_SAVE_DIR/claude-settings.json'"

cp "$CLAUDE_CONFIG_SAVE_DIR/claude-settings.json" "$tmp/settings.before"
echo '{"env": {' > "$CLAUDE_CONFIG_DIR/settings.json"
cc save settings > /dev/null 2> "$tmp/err"
check "corrupt settings keeps claude-settings.json" "cmp -s '$tmp/settings.before' '$CLAUDE_CONFIG_SAVE_DIR/claude-settings.json'"
echo null > "$CLAUDE_CONFIG_DIR/settings.json"
cc save settings > /dev/null 2> "$tmp/err"
check "null settings keeps claude-settings.json" "cmp -s '$tmp/settings.before' '$CLAUDE_CONFIG_SAVE_DIR/claude-settings.json' && grep -q 'not a valid JSON object' '$tmp/err'"
echo '{"env": {' > "$CLAUDE_CONFIG_DIR/settings.json"
cc save settings > /dev/null 2> "$tmp/err"
check "corrupt settings warns" "grep -q 'not a valid JSON object, kept .*claude-settings.json' '$tmp/err'"

# restore skills --update reinstalls only a skill whose GitHub folder SHA or
# well-known digest moved (or that it can't check), from one gh call per repository
mkdir -p "$tmp/bin" "$HOME/.agents" "$CLAUDE_CONFIG_DIR/skills"
cat > "$tmp/bin/gh" << 'EOF'
#!/bin/bash
echo "$*" >> "$TEST_LOG.gh"
echo '{"sha":"rootsha","tree":[{"path":"skills/a","type":"tree","sha":"aaa"},{"path":"skills/b","type":"tree","sha":"new"}]}'
EOF
# Only x.example publishes an index; any other site is a network error
cat > "$tmp/bin/curl" << 'EOF'
#!/bin/bash
case "$*" in
  *https://x.example/.well-known/agent-skills/index.json*) echo '{"skills":[{"name":"c","digest":"sha256:cc"},{"name":"e","digest":"sha256:new"}]}' ;;
  *) exit 22 ;;
esac
EOF
printf '#!/bin/bash\necho "$*" >> "$TEST_LOG.npx"\n' > "$tmp/bin/npx"
printf '#!/bin/bash\n[ "$1" = exec ] || exit 1\nwhile [ "$1" != -- ]; do shift; done\nshift\nexec "$@"\n' > "$tmp/bin/mise"
chmod +x "$tmp/bin/"*
printf '%s' '{"skills":{"a":{"sourceType":"github","source":"o/r","skillPath":"skills/a/SKILL.md","skillFolderHash":"aaa"},"b":{"sourceType":"github","source":"o/r","skillPath":"skills/b/SKILL.md","skillFolderHash":"old"},"c":{"sourceType":"well-known","source":"x.example","sourceUrl":"https://x.example/.well-known/agent-skills/c/skill.md","wellKnownDigest":"sha256:cc"},"e":{"sourceType":"well-known","source":"x.example","sourceUrl":"https://x.example/.well-known/agent-skills/e/skill.md","wellKnownDigest":"sha256:old"},"f":{"sourceType":"well-known","source":"down.example","sourceUrl":"https://down.example/.well-known/agent-skills/f/skill.md","wellKnownDigest":"sha256:ff"},"d":{"sourceType":"github","source":"o/r","skillPath":"SKILL.md","skillFolderHash":"rootsha"}}}' > "$HOME/.agents/.skill-lock.json"
printf 'skill a o/r claude-code\nskill b o/r claude-code\nskill c https://x.example claude-code\nskill d o/r claude-code\nskill e https://x.example claude-code\nskill f https://down.example claude-code\n' > "$CLAUDE_CONFIG_SAVE_DIR/claude-skills.txt"
for n in a b c d e f; do mkdir -p "$CLAUDE_CONFIG_DIR/skills/$n"; done
export TEST_LOG="$tmp/log"
PATH="$tmp/bin:$PATH" cc restore skills --update > "$tmp/out" 2>&1
check "unchanged folder SHA skipped" "grep -qx 'skill same a' '$tmp/out' && ! grep -q -- '-s a ' '$TEST_LOG.npx'"
check "moved folder SHA reinstalled" "grep -qx 'skill changed b' '$tmp/out' && grep -q -- '-s b -a claude-code' '$TEST_LOG.npx'"
check "an unchanged well-known digest skipped" "grep -qx 'skill same c' '$tmp/out' && ! grep -q -- '-s c ' '$TEST_LOG.npx'"
check "a moved well-known digest reinstalled" "grep -qx 'skill changed e' '$tmp/out' && grep -q -- '-s e -a claude-code' '$TEST_LOG.npx'"
check "a source it can't check is reinstalled" "grep -qx 'skill unknown f' '$tmp/out' && grep -q -- '-s f -a claude-code' '$TEST_LOG.npx'"
check "a skill at the repository root compares the root tree" "grep -qx 'skill same d' '$tmp/out'"
check "one gh call per repository" "[ \"\$(wc -l < '$TEST_LOG.gh' | tr -d ' ')\" = 1 ]"
check "the tree cache is removed" "! ls -d \"\${TMPDIR:-/tmp}\"/tmp.* 2> /dev/null | xargs -I{} test -e '{}/o_r'"

[ "$fails" -eq 0 ] || {
  echo "$fails failed" >&2
  exit 1
}
