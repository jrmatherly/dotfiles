#!/bin/bash
#
# Validate shell syntax, ShellCheck supported scripts, and formatting.

set -euo pipefail

shell_scripts=(
  setup.sh
  setup/*.sh
  setup/tests/*.sh
  vscode/*.sh
  .claude/hooks/*.sh
  .claude/skills/*/*.sh
)

bash_syntax_files=(
  tilde/.bash_profile
)

zsh_syntax_files=(
  tilde/.zshenv
  tilde/.zshrc
  zsh/*.zsh
)

while IFS= read -r script; do
  shell_scripts+=("$script")
done < <(
  # Match shell scripts by shebang
  find bin -maxdepth 1 -type f \
    -exec grep -El '^#!(/bin/(ba)?sh|/usr/bin/env (ba)?sh)$' {} + \
    | grep -v '^bin/license$'
)

bash -n "${shell_scripts[@]}" "${bash_syntax_files[@]}"
zsh -n "${zsh_syntax_files[@]}"
shellcheck --severity=warning "${shell_scripts[@]}"
# The Claude Code catalog generator's status/cleanup rules (agents/catalog)
# (Python 3.11+ for tomllib: mise's, not macOS's 3.9 — like bin/claude-catalog)
if command -v mise > /dev/null; then
  mise exec python -- python3 agents/catalog/test_build_catalog.py > /dev/null
else
  python3 agents/catalog/test_build_catalog.py > /dev/null
fi
# Parse the Brewfile the way brewpick does (`manual` lines stripped: raw
# `brew bundle` rejects them) so a typo fails here, not on the next install
if command -v brew > /dev/null; then
  brewfile=$(mktemp)
  grep -v '^manual' setup/Brewfile > "$brewfile"
  HOMEBREW_NO_AUTO_UPDATE=1 brew bundle list --all --file="$brewfile" > /dev/null \
    || { rm -f "$brewfile"; echo "setup/Brewfile failed to parse" >&2; exit 1; }
  rm -f "$brewfile"
fi
prettier --log-level warn --ignore-unknown --check "**/*.{js,cjs,ts,md,json,sh}" "bin/*"
# setup/symlinks.sh: ~/.codex/config.toml is seeded as a copy, never linked
bash setup/tests/codex-config.sh > /dev/null
# VS Code settings are rendered from a minijinja template (bin/vscode-settings):
# test the renderer, and Prettier-check every preset's render inside
# vscode/User so its .prettierrc.yaml applies (the .j2 itself isn't parseable)
if command -v minijinja-cli > /dev/null; then
  bash vscode/test-vscode-settings.sh > /dev/null
  for preset in $(minijinja-cli -t '{% for k in presets %}{{ k }} {% endfor %}' '' vscode/presets.toml); do
    render="vscode/User/.render-check-$preset.json"
    minijinja-cli --strict -D "preset=$preset" -D "home=$HOME" -o "$render" vscode/User/settings.json.j2 vscode/presets.toml
    prettier --log-level warn --ignore-path .prettierignore --check "$render" || { rm -f "$render"; exit 1; }
    rm -f "$render"
  done
else
  echo "check: minijinja-cli not found, skipping the VS Code settings render check" >&2
fi
