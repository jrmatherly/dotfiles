#!/bin/bash
#
# Validate shell syntax, ShellCheck supported scripts, and formatting.

set -euo pipefail
# The self-checks grep for UTF-8 glyphs with bracket expressions, which match
# single bytes under the C locale that Claude Code's Bash tool runs in
export LC_ALL=en_US.UTF-8

shell_scripts=(
  setup.sh
  setup/*.sh
  setup/tests/*.sh
  vscode/*.sh
  bin/lib/test-*
  .claude/hooks/*.sh
  .claude/skills/*/*.sh
  tilde/.claude/*.sh
  firefox/lib/get-firefox-dev-path
)

bash_syntax_files=(
  tilde/.bash_profile
)

zsh_syntax_files=(
  tilde/.zshenv
  tilde/.zprofile
  tilde/.zshrc
  zsh/*.zsh
)

while IFS= read -r script; do
  shell_scripts+=("$script")
done < <(
  # Match shell scripts by shebang
  find bin -maxdepth 1 -type f \
    -exec grep -El '^#!(/bin/(ba)?sh|/usr/bin/env (ba)?sh)$' {} + \
    | grep -v '^bin/license$'
)

bash -n "${shell_scripts[@]}" "${bash_syntax_files[@]}"
zsh -n "${zsh_syntax_files[@]}"
shellcheck --severity=warning "${shell_scripts[@]}"
# dotfiles-settings core tests (settings/): stdlib only, same Python as the catalog tests.
# A listed file that is missing fails the gate.
settings_tests=(settings/tests/test_registry.py settings/tests/test_env.py settings/tests/test_cli.py settings/tests/test_macos_default.py settings/tests/test_package.py settings/tests/test_dotfile.py settings/tests/test_tool.py)
# The Claude Code catalog generator's status/cleanup rules (agents/catalog)
# (Python 3.11+ for tomllib: mise's, not macOS's 3.9 — like bin/claude-catalog)
# CI has mise but no mise-installed Python, and `mise exec python` would download one
if command -v mise > /dev/null && mise where python > /dev/null 2>&1; then
  mise exec python -- python3 agents/catalog/test_build_catalog.py > /dev/null
  mise exec python -- python3 agents/catalog/test_stack.py > /dev/null
  for t in "${settings_tests[@]}"; do mise exec python -- python3 "$t" > /dev/null; done
  # conf.d/20-macos.toml parses clean under mise and no declared type contradicts the live one (drift only warns)
  mise exec python -- python3 setup/tests/macos-defaults.py > /dev/null
else
  python3 agents/catalog/test_build_catalog.py > /dev/null
  python3 agents/catalog/test_stack.py > /dev/null
  for t in "${settings_tests[@]}"; do python3 "$t" > /dev/null; done
  python3 setup/tests/macos-defaults.py > /dev/null
fi
# The dotfiles-settings UI tests need Textual, so they run in the package's locked uv env
if command -v uv > /dev/null; then
  uv run --quiet --locked --project settings python settings/tests/test_tui.py > /dev/null
  uv run --quiet --locked --project settings python settings/tests/test_tui_agents.py > /dev/null
  uv run --quiet --locked --project settings python settings/tests/test_serve.py > /dev/null
else
  echo "check: uv not found, skipping the dotfiles-settings UI tests" >&2
fi
# Lint the GitHub Actions workflows (expressions, runner labels, embedded shell)
if command -v actionlint > /dev/null; then
  actionlint .github/workflows/*.yml
fi
prettier --log-level warn --ignore-unknown --check "**/*.{js,cjs,ts,md,json,sh}" "bin/*" ".github/**/*.yml"
# firefox/lib/get-firefox-dev-path: the profiles.ini fallback, relative and absolute Path
bash setup/tests/firefox-dev-path.sh > /dev/null
# conf.d/40-dotfiles.toml: every tilde/ file has an entry, and with mise, apply, a second apply, the Codex merge and a conflict in a scratch HOME
bash bin/lib/test-dotfiles > /dev/null
# setup/dotfiles-extras.sh in a temp HOME: git identity, cot link, Firefox hard links (sudo and bat stubbed)
bash setup/tests/dotfiles-extras.sh > /dev/null
# setup/macos-extras.sh against stubbed sudo, pmset, defaults, socketfilterfw and killall (nothing is changed)
bash setup/tests/macos-extras.sh > /dev/null
# bin/hindsight-memory against a fixture HOME with the installer, hindsight-embed and npm stubbed
bash bin/lib/test-hindsight-memory > /dev/null
# bin/claude-config save against fixture dirs, under each bash (never the real ~/.claude or agents/)
bash bin/lib/test-claude-config > /dev/null
# bin/sysup's report against stubbed tools (nothing is upgraded)
bash bin/lib/test-sysup > /dev/null
# setup.sh in a fixture clone against stubbed mise, sudo, gh and curl, then a dry-run of the tracked bootstrap config in a scratch HOME
bash bin/lib/test-bootstrap > /dev/null
# zsh/ and tilde/.zshrc in interactive agent and user shells, through a temp ZDOTDIR
bash bin/lib/test-shell > /dev/null
# conf.d/30-packages.toml: key shape, tap list, no pins; the flux2 and talosctl completion hooks; the vscode plugin against a fake code
bash bin/lib/test-packages > /dev/null
# mise's override layer: the version floor, the gitignored local files and zsh/override-env.zsh under a temp HOME and MISE_CONFIG_DIR
bash bin/lib/test-override-env > /dev/null
# bin/serve, bin/git-find and bin/git-tidy under a scratch HOME and git repo
bash bin/lib/test-bin > /dev/null
# bin/rea-mcp against a fixture Ghidra keg under a temp HOMEBREW_PREFIX and a fake mise shim (REA never starts)
bash bin/lib/test-rea-mcp > /dev/null
# the Claude Code hooks against sample payloads
bash .claude/hooks/test-lint-edited.sh > /dev/null
bash .claude/hooks/test-lint-bash-edits.sh > /dev/null
bash .claude/hooks/test-commit-gate.sh > /dev/null
bash .claude/hooks/test-auditor-readonly.sh > /dev/null
# Tree invariants CLAUDE.md promises (telemetry pairing, zsh ignored by prettier, bin/ headers, no pinned mise path)
bash bin/lib/test-conventions > /dev/null
# VS Code settings are rendered from a minijinja template (bin/vscode-settings):
# test the renderer, and Prettier-check every preset's render inside
# vscode/User so its .prettierrc.yaml applies (the .j2 itself isn't parseable)
if command -v minijinja-cli > /dev/null; then
  bash vscode/test-vscode-settings.sh > /dev/null
  for preset in $(minijinja-cli -t '{% for k in presets %}{{ k }} {% endfor %}' '' vscode/presets.toml); do
    render="vscode/User/.render-check-$preset.json"
    minijinja-cli --strict -D "preset=$preset" -D "home=$HOME" -D "dotfiles=$PWD" -o "$render" vscode/User/settings.json.j2 vscode/presets.toml
    prettier --log-level warn --ignore-path .prettierignore --check "$render" || { rm -f "$render"; exit 1; }
    rm -f "$render"
  done
else
  echo "check: minijinja-cli not found, skipping the VS Code settings render check" >&2
fi
