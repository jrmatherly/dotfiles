#!/bin/bash
#
# Validate shell syntax, ShellCheck supported scripts, and formatting.

set -euo pipefail
# The self-checks grep for UTF-8 glyphs with bracket expressions, which match
# single bytes under the C locale that Claude Code's Bash tool runs in
export LC_ALL=en_US.UTF-8

shell_scripts=(
  setup.sh
  setup/*.sh
  setup/tests/*.sh
  vscode/*.sh
  bin/lib/test-*
  .claude/hooks/*.sh
  .claude/skills/*/*.sh
  tilde/.claude/*.sh
  firefox/lib/get-firefox-dev-path
  app/scripts/*.sh
)

bash_syntax_files=(
  tilde/.bash_profile
)

zsh_syntax_files=(
  tilde/.zshenv
  tilde/.zprofile
  tilde/.zshrc
  zsh/*.zsh
)

while IFS= read -r script; do
  shell_scripts+=("$script")
done < <(
  # Match shell scripts by shebang
  find bin bin/lib -maxdepth 1 -type f \
    -exec grep -El '^#!(/bin/(ba)?sh|/usr/bin/env (ba)?sh)$' {} + \
    | grep -v '^bin/license$'
)

bash -n "${shell_scripts[@]}" "${bash_syntax_files[@]}"
zsh -n "${zsh_syntax_files[@]}"
# The release tag is app-v<this>, and the app's own update check reads it as three numbers
[[ $(cat app/VERSION) =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
  echo "check: app/VERSION is not three numbers: $(cat app/VERSION)" >&2
  exit 1
}
# Every step from here to the VS Code block is independent of the others, so
# each runs as a job, one per core at most, and the run takes about as long as
# its slowest step instead of the sum. A job's output is held and printed
# after it ends, so two jobs never interleave.
logs=$(mktemp -d)
trap 'rm -rf "${logs:?}"' EXIT
max=$(sysctl -n hw.ncpu 2> /dev/null || echo 4)
pids=()
steps=()
job() {
  while [ "$(jobs -rp | wc -l)" -ge "$max" ]; do sleep 0.1; done
  "$@" > "$logs/${#pids[@]}" 2>&1 &
  pids+=($!)
  steps+=("$*")
}
# A self-check's stdout is its progress; only what it writes to stderr is kept
quiet() { "$@" > /dev/null; }

job shellcheck --severity=warning "${shell_scripts[@]}"
# dotfiles-settings core tests (settings/): stdlib only, same Python as the catalog tests.
# A listed file that is missing fails the gate.
settings_tests=(settings/tests/test_registry.py settings/tests/test_env.py settings/tests/test_cli.py settings/tests/test_macos_default.py settings/tests/test_package.py settings/tests/test_dotfile.py settings/tests/test_tool.py settings/tests/test_module.py settings/tests/test_sync.py settings/tests/test_profile.py)
# The Claude Code catalog generator's status/cleanup rules (agents/catalog)
# (Python 3.11+ for tomllib: mise's, not macOS's 3.9 — like bin/claude-catalog)
# CI has mise but no mise-installed Python, and `mise exec python` would download one
python=(python3)
if command -v mise > /dev/null && mise where python > /dev/null 2>&1; then
  python=(mise exec python -- python3)
fi
job quiet "${python[@]}" agents/catalog/test_build_catalog.py
job quiet "${python[@]}" agents/catalog/test_stack.py
for t in "${settings_tests[@]}"; do job quiet "${python[@]}" "$t"; done
# conf.d/20-macos.toml parses clean under mise and no declared type contradicts the live one (drift only warns)
job quiet "${python[@]}" setup/tests/macos-defaults.py
# The dotfiles-settings UI tests need Textual, so they run in the package's locked uv env
if command -v uv > /dev/null; then
  job quiet uv run --quiet --locked --project settings python settings/tests/test_tui.py
  job quiet uv run --quiet --locked --project settings python settings/tests/test_tui_agents.py
  job quiet uv run --quiet --locked --project settings python settings/tests/test_serve.py
else
  echo "check: uv not found, skipping the dotfiles-settings UI tests" >&2
fi
# The menu bar app (app/). Its SwiftUI macros' compiler plugin ships with
# Xcode, not the Command Line Tools, so build through Xcode when xcode-select
# points at the Tools. swift test reports on stderr even when it passes, so its
# output is kept only when it fails
xcode=/Applications/Xcode.app/Contents/Developer
developer=${DEVELOPER_DIR:-$(xcode-select -p 2> /dev/null || true)}
if [[ -z $developer || $developer == */CommandLineTools ]] && [ -d "$xcode" ]; then
  export DEVELOPER_DIR=$xcode
  developer=$xcode
fi
app_tests() {
  local out
  out=$(swift test --package-path app 2>&1) || {
    grep -vE 'ld: warning|^\s*$' <<< "$out" | tail -n 60
    return 1
  }
}
if command -v swift > /dev/null && [[ -n $developer && $developer != */CommandLineTools ]]; then
  job app_tests
else
  echo "check: Xcode not found, skipping the app tests" >&2
fi
# app/Info.plist.in and an unsigned app/scripts/build-app.sh run; it skips itself without Xcode
job quiet bash bin/lib/test-app-build
# Lint the GitHub Actions workflows (expressions, runner labels, embedded shell)
if command -v actionlint > /dev/null; then
  job actionlint .github/workflows/*.yml
fi
job prettier --log-level warn --ignore-unknown --check "**/*.{js,cjs,ts,md,json,sh}" "bin/*" ".github/**/*.yml"
# firefox/lib/get-firefox-dev-path: the profiles.ini fallback, relative and absolute Path
job quiet bash setup/tests/firefox-dev-path.sh
# conf.d/40-dotfiles.toml: every tilde/ file has an entry, and with mise, apply, a second apply, the Codex merge and a conflict in a scratch HOME
job quiet bash bin/lib/test-dotfiles
# setup/dotfiles-extras.sh in a temp HOME: git identity, cot link, Firefox hard links (sudo and bat stubbed)
job quiet bash setup/tests/dotfiles-extras.sh
# setup/macos-extras.sh against stubbed sudo, pmset, defaults, socketfilterfw and killall (nothing is changed)
job quiet bash setup/tests/macos-extras.sh
# bin/hindsight-memory against a fixture HOME with the installer, hindsight-embed, npm and uv stubbed
job quiet bash bin/lib/test-hindsight-memory
# bin/claude-config save against fixture dirs, under each bash (never the real ~/.claude or agents/)
job quiet bash bin/lib/test-claude-config
# bin/sysup's report against stubbed tools (nothing is upgraded)
job quiet bash bin/lib/test-sysup
# setup.sh in a fixture clone against stubbed mise, sudo, gh and curl, then a dry-run of the tracked bootstrap config in a scratch HOME
job quiet bash bin/lib/test-bootstrap
# zsh/ and tilde/.zshrc in interactive agent and user shells, through a temp ZDOTDIR
job quiet bash bin/lib/test-shell
# conf.d/30-packages.toml, config.toml and the conf.d/60-rotm-*.toml modules: key shape, taps, no pins, nothing lost in the split; the flux2 and talosctl completion hooks; the vscode plugin against a fake code
job quiet bash bin/lib/test-packages
# mise's override layer: the version floor, the gitignored local files and zsh/override-env.zsh under a temp HOME and MISE_CONFIG_DIR
job quiet bash bin/lib/test-override-env
# bin/serve, bin/git-find and bin/git-tidy under a scratch HOME and git repo
job quiet bash bin/lib/test-bin
# bin/lib/rotm-mode and bin/rotm against fixture repositories with mise, setup.sh and dotfiles-settings stubbed
job quiet bash bin/lib/test-rotm
# bin/lib/rotm-modules: the off list and mise's ignored_config_paths line under a temp MISE_CONFIG_DIR, and what a scratch mise makes of them
job quiet bash bin/lib/test-modules
# bin/lib/rotm-user-layer: the user's folder and its links, the track entry and the restore, under a temp HOME with mise stubbed
job quiet bash bin/lib/test-user-layer
# rotm settings sync between scratch installed copies with the real mise and a local bare origin (gh stubbed, no uv)
job quiet bash bin/lib/test-sync
job quiet bash bin/lib/test-profiles
# bin/rea-mcp against a fixture Ghidra keg under a temp HOMEBREW_PREFIX and a fake mise shim (REA never starts)
job quiet bash bin/lib/test-rea-mcp
# the Claude Code hooks against sample payloads
job quiet bash .claude/hooks/test-lint-edited.sh
job quiet bash .claude/hooks/test-lint-bash-edits.sh
job quiet bash .claude/hooks/test-commit-gate.sh
job quiet bash .claude/hooks/test-auditor-readonly.sh
# Tree invariants CLAUDE.md promises (telemetry pairing, zsh ignored by prettier, bin/ headers, no pinned mise path)
job quiet bash bin/lib/test-conventions

failed=0
for i in "${!pids[@]}"; do
  if ! wait "${pids[$i]}"; then
    failed=1
    echo "check: failed: ${steps[$i]#quiet }" >&2
  fi
  cat "$logs/$i" >&2
done
[ "$failed" = 0 ] || exit 1
# Left serial: it writes its render files into the tree, and it takes two seconds
# VS Code settings are rendered from a minijinja template (bin/vscode-settings):
# test the renderer, and Prettier-check every preset's render inside
# vscode/User so its .prettierrc.yaml applies (the .j2 itself isn't parseable)
if command -v minijinja-cli > /dev/null; then
  bash vscode/test-vscode-settings.sh > /dev/null
  for preset in $(minijinja-cli -t '{% for k in presets %}{{ k }} {% endfor %}' '' vscode/presets.toml); do
    render="vscode/User/.render-check-$preset.json"
    minijinja-cli --strict -D "preset=$preset" -D "home=$HOME" -D "dotfiles=$PWD" -o "$render" vscode/User/settings.json.j2 vscode/presets.toml
    prettier --log-level warn --ignore-path .prettierignore --check "$render" || { rm -f "$render"; exit 1; }
    rm -f "$render"
  done
else
  echo "check: minijinja-cli not found, skipping the VS Code settings render check" >&2
fi
