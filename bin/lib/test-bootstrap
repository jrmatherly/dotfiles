#!/bin/bash
#
# Self-check for setup.sh against stubbed tools, and for the bootstrap config.
#
# - Run it (pnpm check does too); exits 1 naming the first failed assertion:
#
# `test-bootstrap`
#
# ---
# Never sets anything up. Part one runs a copy of setup.sh in a fixture clone
# with a temp HOME and mise, sudo, xcode-select, curl, gh and code as stubs on
# PATH, then a copy of setup/misc.sh the same way with its own stubs. Part two asks the real mise for a dry run of the tracked
# conf.d/50-bootstrap.toml from a scratch HOME, and is skipped without mise.
#
# License: MIT

set -euo pipefail

repo="$(cd "$(dirname "$0")/../.." && pwd -P)"
tmp=$(cd "$(mktemp -d)" && pwd -P)
trap 'rm -rf "$tmp"' EXIT
real_path=$PATH

fail() {
  echo "FAIL: $1" >&2
  exit 1
}

# setup.sh puts the Homebrew prefix on PATH, where this Mac has a real mise, gh
# and code: unless it reads HOMEBREW_PREFIX, the stubs below would not be used
grep -qF "\${HOMEBREW_PREFIX:-/opt/homebrew}" "$repo/setup.sh" \
  || fail "setup.sh does not take its prefix from HOMEBREW_PREFIX; not running it"

fix="$tmp/clone"
export STATE="$tmp/state" HOMEBREW_PREFIX="$tmp/nobrew"
# A caller's own values would reach the mise stub and fail the assertions on its log
unset MISE_GITHUB_TOKEN MISE_DISABLE_TOOLS DOTFILES DOTFILES_DIR DOTFILES_SKIP_CODEGRAPH DOTFILES_SETUP_LOG STUB_MISE_VERSION DOTFILES_YES MISE_DATA_DIR
mkdir -p "$fix/setup" "$fix/bin/lib" "$fix/tilde/.config/gh" "$fix/tilde/.config/mise" "$tmp/bin" "$tmp/other"
cp "$repo/setup.sh" "$fix/setup.sh"
cp "$repo/setup/mise-floor.sh" "$fix/setup/mise-floor.sh"
cp "$repo/bin/lib/rotm-mode" "$fix/bin/lib/rotm-mode"
cp "$repo/bin/lib/rotm-modules" "$fix/bin/lib/rotm-modules"
cp "$repo/bin/lib/rotm-user-layer" "$fix/bin/lib/rotm-user-layer"
# Folders an installed copy keeps real: one linked into the copy, one already real, one linked elsewhere
printf '[dotfiles]\n"~/.config/gh" = { permissions = "0700" }\n"~/.config/keep" = { permissions = "0700" }\n"~/.config/elsewhere" = { permissions = "0700" }\n' > "$fix/tilde/.config/mise/config.rotm-installed.toml"
# The real extras script must not run here, and setup.sh finds it beside itself
printf '#!/bin/bash\necho ran >> "$STATE/extras.log"\n' > "$fix/setup/dotfiles-extras.sh"
printf '#!/bin/bash\nexit 0\n' > "$fix/setup/dash.sh"
printf '#!/bin/bash\nexit 0\n' > "$fix/bin/nyan"
# Loading saved settings: restore and dotfiles-settings are stubs that log to mise.log; the other rotm-user-layer calls are real
mv "$fix/bin/lib/rotm-user-layer" "$fix/bin/lib/rotm-user-layer.real"
cat > "$fix/bin/lib/rotm-user-layer" << 'EOF'
#!/bin/bash
[ "${1:-}" = restore ] || exec "$(dirname "$0")/rotm-user-layer.real" "$@"
echo "pwd=$(pwd -P) helper=rotm-user-layer args=$*" >> "$STATE/mise.log"
folder="$HOME/.config/rotm"
if [ -e "$folder/modules-off.local" ]; then echo present; else echo absent; fi > "$STATE/modules-at-restore"
[ ! -e "$STATE/restore-fails" ] || {
  echo "rotm-user-layer: the restored settings conflict with this Mac's; nothing was overwritten" >&2
  exit 1
}
for f in modules-off.local config.override.toml; do
  [ ! -e "$STATE/saved-$f" ] || cp "$STATE/saved-$f" "$folder/$f"
done
EOF
printf '#!/bin/bash\necho "pwd=$(pwd -P) helper=dotfiles-settings args=$* just_installed=${ROTM_JUST_INSTALLED:-}" >> "$STATE/mise.log"\n[ ! -e "$STATE/apply-fails" ]\n' > "$fix/bin/dotfiles-settings"
chmod +x "$fix/setup.sh" "$fix"/setup/*.sh "$fix/bin/nyan" "$fix/bin/lib/rotm-user-layer" "$fix/bin/dotfiles-settings"

stub() {
  printf '#!/bin/bash\n%s\n' "$2" > "$tmp/bin/$1"
  chmod +x "$tmp/bin/$1"
}
IFS= read -r -d '' mise_stub << 'EOF' || true
case $1 in
  --version) echo "${STUB_MISE_VERSION:-2026.11.8} macos-arm64 (2026-11-08)" ;;
  *) echo "mise $*" >> "$STATE/order.log"
    echo "pwd=$(pwd -P) args=$* disable=${MISE_DISABLE_TOOLS:-} dotfiles=${DOTFILES:-} skip=${DOTFILES_SKIP_CODEGRAPH:-} token=${MISE_GITHUB_TOKEN:-} telemetry=${CODEGRAPH_TELEMETRY:-} yes=${DOTFILES_YES:-}" >> "$STATE/mise.log"
    case "$*" in
      "bootstrap packages upgrade "*) [ ! -e "$STATE/upgrade-fails" ] ;;
      "bootstrap packages apply --yes --manager brew")
        cp "$HOME/.config/mise/miserc.local.toml" "$STATE/rc-at-packages" 2> /dev/null || true
        [ ! -e "$STATE/no-packages" ] || { echo "mise ERROR no packages requested for manager 'brew'"; exit 1; } ;;
      "dot origin")
        if [ -e "$STATE/origin" ]; then echo "https://github.com/octo/rotm-settings.git"
        else echo "no setup repository is connected; run mise dot origin set <url>"; fi ;;
      "env --json")
        if grep -qsF 'DOTFILES_SKIP_CODEGRAPH = "true"' "$HOME/.config/mise/config.override.toml"; then
          echo '{"DOTFILES_SKIP_CODEGRAPH":"true"}'
        else echo '{}'; fi ;;
      *"--manager brew-cask"*) [ ! -e "$STATE/casks-fail" ] ;;
      "bootstrap packages status --json")
        printf '{"brew-cask":{"available":true,"packages":['
        for p in $(cat "$STATE/missing-casks" 2> /dev/null); do printf '{"package":"%s","state":"missing"},' "$p"; done
        for p in $(cat "$STATE/absent-casks" 2> /dev/null); do printf '{"package":"%s","state":"unexpectedly_installed"},' "$p"; done
        printf '{"package":"ghostty","state":"installed"}]}}\n' ;;
      "bootstrap packages apply --yes brew-cask:"*)
        ! grep -qxF "${5#brew-cask:}" "$STATE/bad-casks" 2> /dev/null || { echo "mise ERROR download returned 404"; exit 1; } ;;
      "dotfiles apply"*) [ ! -e "$STATE/dotfiles-fail" ] ;;
      install*)
        [ ! -e "$STATE/tools-fail" ] || {
          echo "mise ✗ npm:@vue/language-server@3.1.0  2.1s · failed: failed to resolve dependencies"
          echo "mise ✓ npm:typescript@5.9.3  1.0s"
          exit 1
        } ;;
      "ls --missing --json") if [ -e "$STATE/tools-fail" ]; then echo '{"npm:@vue/language-server":[]}'; else echo '{}'; fi ;;
      upgrade*) ;;
      "bootstrap --only task"*) [ ! -e "$STATE/task-fails" ] ;;
      "bootstrap packages "* | plugins*) ;;
      bootstrap*) [ ! -e "$STATE/bootstrap-fails" ] ;;
    esac ;;
esac
EOF
stub sudo 'echo "$*" >> "$STATE/sudo.log"; echo "sudo $*" >> "$STATE/order.log"'
stub xcode-select '[ ! -e "$STATE/no-clt" ]'
stub curl 'echo "$*" >> "$STATE/curl.log"; echo "mkdir -p \"\$HOME/.local/bin\" && cp \"$STATE/mise-stub\" \"\$HOME/.local/bin/mise\""'

check_true() {
  local name=$1
  shift
  "$@" || {
    echo "FAIL: $name" >&2
    echo "$out" >&2
    cat "$STATE/mise.log" >&2
    exit 1
  }
  echo "ok: $name"
}
has() { grep -qE -- "$1" <<< "$out"; }
lacks() { ! has "$1"; }
log_has() { grep -qF -- "$1" "$STATE/mise.log"; }
log_lacks() { ! log_has "$1"; }
log_empty() { [ ! -s "$STATE/mise.log" ]; }
# The one `mise bootstrap` run, as opposed to the `bootstrap packages` calls before it
boot_has() { grep -E 'args=bootstrap (--|disable=)' "$STATE/mise.log" | grep -qF -- "$1"; }
extras_ran() { [ "$(wc -l < "$STATE/extras.log" | tr -d ' ')" = "$1" ]; }
# in_order <text>...: each text's first log line comes after the previous one's
in_order() {
  local last=0 n text
  for text in "$@"; do
    n=$(grep -nF -- "$text" "$STATE/mise.log" | head -1 | cut -d: -f1)
    [ -n "$n" ] && [ "$n" -gt "$last" ] || return 1
    last=$n
  done
}

# prepare runs in the fresh HOME and STATE before setup.sh does
prepare() { :; }
# run [setup.sh args...]: sets out and rc. The stubs are rebuilt, so a case's own stay its own.
# copy is the folder whose setup.sh runs, for a prepare that links into it
copy=$fix
run() {
  rm -rf "${tmp:?}/home" "$STATE" "$tmp/bin/gh" "$tmp/bin/code"
  # ~/.config/mise links into the fixture, so the module state would outlive the HOME it was written through
  rm -f "$fix/tilde/.config/mise/miserc.local.toml" "$fix/tilde/.config/mise/modules-off.local"
  export HOME="$tmp/home"
  mkdir -p "$HOME" "$STATE"
  touch "$STATE/mise.log" "$STATE/extras.log" "$STATE/sudo.log" "$STATE/curl.log" "$STATE/order.log"
  stub mise "$mise_stub"
  prepare
  [ "$copy" = "$fix" ] || { mkdir -p "$(dirname "$copy")" && cp -R "$fix" "$copy"; }
  rc=0
  if [ -z "${answers:-}" ]; then
    out=$(PATH="$tmp/bin:/usr/bin:/bin" "$copy/setup.sh" "$@" 2>&1 < /dev/null) || rc=$?
    return 0
  fi
  # answers=… run: setup.sh on a terminal (script's pty) that types them
  # The input stays open while setup runs, so a prompt reads an answer and not an end of input; ten seconds at most.
  # A pipe, not a FIFO, which macOS script refuses
  PATH="$tmp/bin:/usr/bin:/bin" DOTFILES_SETUP_LOG=none script -q /dev/null "$copy/setup.sh" "$@" > "$STATE/out" 2>&1 < <(
    printf '%b' "$answers"
    ticks=0
    while [ ! -e "$STATE/done" ] && [ $((ticks += 1)) -le 100 ]; do sleep 0.1; done
  ) || rc=$?
  touch "$STATE/done"
  out=$(tr -d '\r' < "$STATE/out")
}
# run_installed [setup.sh args...]: the same from a copy of the fixture where mise keeps its checkout
run_installed() {
  copy="$tmp/home/.local/share/mise/bootstrap-repo"
  run "$@"
  copy=$fix
}
apply="args=bootstrap packages apply --yes --manager"
task="args=bootstrap --only task disable="
# sudo_dropped_before <text>: a `sudo -k` comes before the first call naming text, and after the bootstrap
sudo_dropped_before() {
  local k b n
  b=$(grep -nF 'mise bootstrap --skip' "$STATE/order.log" | head -1 | cut -d: -f1)
  k=$(grep -nxF 'sudo -k' "$STATE/order.log" | head -1 | cut -d: -f1)
  n=$(grep -nF -- "$1" "$STATE/order.log" | head -1 | cut -d: -f1)
  [ -n "$b" ] && [ -n "$k" ] && [ -n "$n" ] && [ "$b" -lt "$k" ] && [ "$k" -lt "$n" ]
}
upgrade="args=bootstrap packages upgrade --yes --manager"

run
check_true "a: exits 0" [ "$rc" -eq 0 ]
check_true "a: ~/.config/mise links to the clone's" [ -L "$HOME/.config/mise" -a "$HOME/.config/mise" -ef "$fix/tilde/.config/mise" ]
check_true "a: ~/dotfiles links to the clone" [ -L "$HOME/dotfiles" -a "$HOME/dotfiles" -ef "$fix" ]
check_true "a: dotfiles, plugin link, formulae, casks, then bootstrap" in_order "args=dotfiles apply --yes disable=" \
  "args=plugins link --force vscode $fix/mise-plugins/vscode disable=" "$apply brew disable=" "$apply brew-cask disable=" \
  "pwd=$HOME args=bootstrap --skip macos-defaults,packages,tools,task disable= dotfiles=$fix skip= token= telemetry=0" \
  "args=install --yes disable=" "$task"
check_true "a: sudo is dropped after the bootstrap, before the tools" sudo_dropped_before "mise install"
check_true "a: no tool is upgraded" log_lacks "args=upgrade"
check_true "a: without -y the task may ask" log_lacks "yes=true"
check_true "a: says All done with no problem list" has 'All done' && check_true "a: … and no problem list" lacks 'Setup finished'
check_true "a: every mise call runs from HOME" [ -z "$(grep -v "^pwd=$HOME " "$STATE/mise.log")" ]
check_true "a: no package is upgraded" log_lacks "packages upgrade"
check_true "a: no extensions without code" log_lacks "--manager vscode"
check_true "a: says extensions are skipped" has 'extensions are skipped'
check_true "a: warns about the anonymous GitHub limit" has 'No GitHub token'
check_true "a: without a terminal gh is not installed ahead to ask for a login" log_lacks "apply --yes brew:gh"
check_true "a: the GitHub warning comes before the packages" [ "$(grep -n 'No GitHub token' <<< "$out" | head -1 | cut -d: -f1)" -lt "$(grep -n 'Installing formulae' <<< "$out" | head -1 | cut -d: -f1)" ]
check_true "the bootstrap task no longer asks for the GitHub login" eval '! grep -q "read -rp.*gh auth login" "$repo/setup/misc.sh"'
check_true "setup.sh offers the GitHub login before the first package list" [ "$(grep -n '^github_login$' "$repo/setup.sh" | cut -d: -f1)" -lt "$(grep -n '^  packages_for brew formulae' "$repo/setup.sh" | cut -d: -f1)" ]
check_true "a: a free-space line per manager" [ "$(grep -cE '^[0-9.]+[KMGT]i? free on /$' <<< "$out")" = 2 ]
check_true "a: the extras script runs once" extras_ran 1
check_true "a: no sudo prompt without a terminal" [ -z "$(grep -e '-v' "$STATE/sudo.log")" ]

run -y --skip-codegraph -- --skip packages
check_true "b: --yes, the merged skip list and CodeGraph disabled" boot_has "args=bootstrap --yes --skip macos-defaults,packages,tools,task disable=npm:@colbymchenry/codegraph "
check_true "b: the task is told to skip CodeGraph" boot_has " skip=true "
check_true "b: -y reaches the task, for its prompts" log_has "args=bootstrap --yes --only task disable=npm:@colbymchenry/codegraph dotfiles=$fix skip=true token= telemetry=0 yes=true"
check_true "b: --skip packages skips setup's own package step" log_lacks "packages apply"
check_true "b: … and the plugin link" log_lacks "plugins link"

prepare() { stub code 'exit 0'; }
run -- --skip tools --skip=files --upgrade
check_true "b2: both --skip forms merge, --upgrade stays" boot_has "args=bootstrap --skip macos-defaults,tools,files,packages,task --upgrade disable="
check_true "b2: --skip tools installs and upgrades no tool" log_lacks "args=install" && check_true "b2: … no upgrade" log_lacks "args=upgrade"
check_true "b2: the task still runs" log_has "args=bootstrap --only task --upgrade disable="
check_true "b2: each manager is applied, then upgraded, extensions after bootstrap" in_order \
  "$apply brew disable=" "$upgrade brew disable=" "$apply brew-cask disable=" "$upgrade brew-cask disable=" \
  "args=bootstrap --skip" "$apply vscode disable=" "$upgrade vscode disable="
prepare() { :; }

run -- --only tools
check_true "b3: --only exits 1" [ "$rc" -eq 1 ]
check_true "b3: names the direct command" has 'mise bootstrap --only'
check_true "b3: mise is not run" log_empty

run -- --dry-run --upgrade
check_true "b4: --dry-run reaches each apply and upgrade" in_order \
  "$apply brew --dry-run disable=" "$upgrade brew --dry-run disable=" "$apply brew-cask --dry-run disable=" "$upgrade brew-cask --dry-run disable="
check_true "b4: … and the bootstrap" boot_has "--skip macos-defaults,packages,tools,task --dry-run --upgrade disable="
check_true "b4: … and the tools install and upgrade, then the task" in_order "args=install --yes --dry-run disable=" \
  "args=upgrade --yes --dry-run disable=" "args=bootstrap --only task --dry-run --upgrade disable="
check_true "b4: a dry run links no plugin" log_lacks "plugins link"
check_true "b4: the dotfiles apply is a dry run, before the packages" in_order "args=dotfiles apply --yes --dry-run disable=" "$apply brew --dry-run disable="
check_true "b4: … and skips the extras script" extras_ran 0

run -- --skip dotfiles
check_true "b5: exits 0" [ "$rc" -eq 0 ]
check_true "b5: dotfiles joins the skip list" boot_has "--skip macos-defaults,dotfiles,packages,tools,task disable="
check_true "b5: no extras without the dotfiles part" extras_ran 0
check_true "b5: no dotfiles apply" log_lacks "dotfiles apply"

run -- --skip packages --upgrade
check_true "b6: exits 0" [ "$rc" -eq 0 ]
check_true "b6: no package apply" log_lacks "packages apply"
check_true "b6: no package upgrade" log_lacks "packages upgrade"
check_true "b6: no plugin link" log_lacks "plugins link"
check_true "b6: tools are still upgraded" in_order "args=install --yes disable=" "args=upgrade --yes disable="

prepare() { mkdir -p "$HOME/.config/mise" && touch "$HOME/.config/mise/config.toml"; }
run
check_true "c: an own ~/.config/mise exits 1" [ "$rc" -eq 1 ]
check_true "c: names the link and the mv" has '/\.config/mise is not a link to .*mv '
check_true "c: mise is not run" log_empty
check_true "c: the directory is left alone" [ -f "$HOME/.config/mise/config.toml" -a ! -L "$HOME/.config/mise" ]

for kind in directory file link; do
  prepare() {
    case $kind in
      directory) mkdir "$HOME/dotfiles" ;;
      file) echo x > "$HOME/dotfiles" ;;
      link) ln -s "$tmp/other" "$HOME/dotfiles" ;;
    esac
  }
  run
  check_true "c2: a foreign ~/dotfiles ($kind) exits 1" [ "$rc" -eq 1 ]
  check_true "c2: names the problem ($kind)" has '/dotfiles is not a link to'
  check_true "c2: mise is not run ($kind)" log_empty
done

prepare() { mv "$tmp/bin/mise" "$STATE/mise-stub"; }
run
check_true "d: without mise exits 0" [ "$rc" -eq 0 ]
check_true "d: installs mise from mise.run" grep -q 'https://mise.run' "$STATE/curl.log"
check_true "d: the installed mise runs the bootstrap" boot_has "--skip macos-defaults,packages,tools,task"
prepare() { :; }

STUB_MISE_VERSION=2026.10.1 run
check_true "e: an old mise exits 1" [ "$rc" -eq 1 ]
check_true "e: names the floor and the found version" has 'mise 2026\.11\.8 or newer is required, found 2026\.10\.1'
check_true "e: mise is not run" log_empty

prepare() { touch "$STATE/bootstrap-fails"; }
run
check_true "f: a failed bootstrap fails setup" [ "$rc" -ne 0 ]
check_true "f: says to rerun" has 'rerun \./setup\.sh'
check_true "f: no extras after a failed bootstrap" extras_ran 0
check_true "f: no tools after a failed bootstrap" log_lacks "args=install"
check_true "f: does not say All done" lacks 'All done'

prepare() {
  touch "$STATE/bootstrap-fails"
  stub code 'exit 0'
}
run
check_true "f1: a failed bootstrap installs no extensions" log_lacks "--manager vscode"
check_true "f1: … and says to rerun" has 'rerun \./setup\.sh'

prepare() {
  touch "$STATE/casks-fail"
  stub code 'exit 0'
}
run
check_true "f2: a failed cask exits 2" [ "$rc" -eq 2 ]
check_true "f2: warns that casks failed" has 'Some casks failed to install'
check_true "f2: the bootstrap and then the extensions still run" in_order "$apply brew-cask disable=" "args=bootstrap --skip" "$apply vscode disable="
check_true "f2: the extras script runs" extras_ran 1

prepare() {
  printf '[alias]\n\tst = status\n' > "$fix/tilde/.gitconfig"
  cp "$fix/tilde/.gitconfig" "$STATE/gitconfig"
  printf '[credential]\n\thelper = \n\thelper = /gcm\n[credential "https://dev.azure.com"]\n\tuseHttpPath = true\n' >> "$fix/tilde/.gitconfig"
  printf '[credential]\n\thelper = \n' > "$HOME/.gitconfig.local"
}
run
check_true "cred: exits 0" [ "$rc" -eq 0 ]
check_true "cred: the tracked gitconfig is back to what it was" cmp -s "$fix/tilde/.gitconfig" "$STATE/gitconfig"
check_true "cred: the credential values are in ~/.gitconfig.local, none twice" [ "$(git config --file "$HOME/.gitconfig.local" --get-regexp '^credential\.' | tr '\n' '|')" \
  = "credential.helper |credential.helper /gcm|credential.https://dev.azure.com.usehttppath true|" ]
prepare() { printf '[credential]\n\thelper = /gcm\n' > "$fix/tilde/.gitconfig"; }
run -- --dry-run
check_true "cred: a dry run leaves the tracked gitconfig alone" grep -q credential "$fix/tilde/.gitconfig"
rm "$fix/tilde/.gitconfig"

prepare() {
  touch "$STATE/casks-fail"
  printf '%s\n' royal-tsx syntax-highlight utm > "$STATE/missing-casks"
  echo royal-tsx > "$STATE/bad-casks"
}
run
check_true "f2b: exits 2" [ "$rc" -eq 2 ]
check_true "f2b: each cask left missing gets its own apply" in_order "$apply brew-cask disable=" "args=bootstrap packages status --json" \
  "args=bootstrap packages apply --yes brew-cask:royal-tsx disable=" "args=bootstrap packages apply --yes brew-cask:syntax-highlight disable=" \
  "args=bootstrap packages apply --yes brew-cask:utm disable=" "args=bootstrap --skip"
check_true "f2b: an installed cask is not retried" log_lacks "brew-cask:ghostty"
check_true "f2b: names the cask that failed again" has 'brew-cask:royal-tsx failed to install'
check_true "f2b: … and only that one" lacks 'brew-cask:(syntax-highlight|utm) failed'

prepare() { touch "$STATE/upgrade-fails"; }
run -- --upgrade
check_true "f3: a failed upgrade exits 2" [ "$rc" -eq 2 ]
check_true "f3: warns that the upgrade failed" has 'failed to upgrade'
check_true "f3: casks are applied after the failed formula upgrade" in_order "$upgrade brew disable=" "$apply brew-cask disable="
check_true "f3: the bootstrap still gets --upgrade" boot_has "--skip macos-defaults,packages,tools,task --upgrade disable="
check_true "f3: lists the upgrade" has '✗ upgrade +formulae'
check_true "f3: … and says to retry with --upgrade" has 'To retry: \./setup\.sh -- --upgrade$'

check_true "f3: the extras script runs" extras_ran 1

prepare() {
  touch "$STATE/tools-fail"
  echo warp > "$STATE/missing-casks"
  echo warp > "$STATE/bad-casks"
  touch "$STATE/casks-fail"
  stub code 'exit 0'
}
run
check_true "t: a failed tool exits 2" [ "$rc" -eq 2 ]
check_true "t: the task, then the extensions still run" in_order "args=install --yes disable=" "$task" "$apply vscode disable="
check_true "t: the extras script runs" extras_ran 1
check_true "t: counts the problems" has '^⚠️  Setup finished with 2 problems$'
check_true "t: lists the cask with mise's reason" has '^  ✗ cask   warp                       download returned 404$'
check_true "t: lists the tool with mise's reason" has '^  ✗ tool   npm:@vue/language-server   failed to resolve dependencies$'
check_true "t: a tool that installed is not listed" lacks '✗ tool +npm:typescript'
check_true "t: ends with the tool hint" [ "$(tail -1 <<< "$out")" = "  To see why a tool failed: mise install <tool>" ]
check_true "t: no All done" lacks 'All done'

prepare() { touch "$STATE/task-fails"; }
run
check_true "t2: a failed task fails setup" [ "$rc" -eq 1 ]
check_true "t2: says to rerun" has 'rerun \./setup\.sh'
check_true "t2: no extras after a failed task" extras_ran 0

prepare() { touch "$STATE/dotfiles-fail"; }
run
check_true "f5: a failed dotfiles apply exits 1" [ "$rc" -eq 1 ]
check_true "f5: says to rerun" has 'rerun \./setup\.sh'
check_true "f5: stops before any package" log_lacks "packages apply"
check_true "f5: … and the bootstrap" log_lacks "args=bootstrap --skip"

prepare() { touch "$STATE/no-packages"; }
run
check_true "f4: no package list exits 1" [ "$rc" -eq 1 ]
check_true "f4: says mise read no package list" has 'mise read no package list'
check_true "f4: not reported as a failed install" lacks 'Some formulae failed'
check_true "f4: stops before casks and the bootstrap" log_lacks "--manager brew-cask"
check_true "f4: … and the bootstrap" log_lacks "args=bootstrap --skip"
prepare() { :; }

run --skip-brew
check_true "g: --skip-brew exits 1" [ "$rc" -eq 1 ]
check_true "g: names the replacement" has '-- --skip packages'
run --help
check_true "g: --help exits 0 with the usage" [ "$rc" -eq 0 -a -n "$out" ]
check_true "g: --help no longer lists it" lacks 'skip-brew'

prepare() { touch "$STATE/no-clt"; }
run
check_true "h: without the Command Line Tools exits 1" [ "$rc" -eq 1 ]
check_true "h: names the install command" has 'xcode-select --install'
check_true "h: mise is not run" log_empty

# mise asks gh for a token itself ([settings.github] in config.toml), so
# setup.sh hands none to every build and hook
