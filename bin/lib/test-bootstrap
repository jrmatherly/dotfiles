check_true "saved: a terminal that answers yes exits 0" [ "$rc" -eq 0 ]
check_true "saved: asks first" asked
check_true "saved: restores the repository once" restores 1
check_true "saved: … before the first package list" in_order "$restore" "$apply brew disable="
check_true "saved: a module switched off on the other Mac is off before the packages" grep -qF '"conf.d/60-rotm-apps.toml"' "$STATE/rc-at-packages"
check_true "saved: the tool settings apply after the packages and the task" in_order "$apply brew disable=" "$task" "$settings_apply"
check_true "saved: … once" applies 1
check_true "saved: … told that setup has just installed" log_has "$settings_apply just_installed=1"

