# Saved settings (rotm settings sync): gh is signed in as octo, who has a settings repository.
# A file in STATE breaks one part: signed-out, no-repo, empty, public, not-settings
saved='echo "gh $*" >> "$STATE/gh.log"
case "$*" in
  "auth token") [ ! -e "$STATE/signed-out" ] && echo tok ;;
  "api user --jq .login") echo octo ;;
  "repo view octo/rotm-settings --json isEmpty --jq .isEmpty")
    [ ! -e "$STATE/no-repo" ] || exit 1
    if [ -e "$STATE/empty" ]; then echo true; else echo false; fi ;;
  "repo view octo/rotm-settings --json visibility --jq .visibility")
    if [ -e "$STATE/public" ]; then echo PUBLIC; else echo PRIVATE; fi ;;
  "api repos/octo/rotm-settings/contents/.mise-history/format.toml") [ ! -e "$STATE/not-settings" ] ;;
  *) exit 1 ;;
esac'
restore="helper=rotm-user-layer args=restore https://github.com/octo/rotm-settings.git"
settings_apply="helper=dotfiles-settings args=sync apply"
restores() { [ "$(grep -cF -- "$restore" "$STATE/mise.log")" = "$1" ]; }
applies() { [ "$(grep -cF -- "$settings_apply" "$STATE/mise.log")" = "$1" ]; }
asked() { has 'Load your saved settings from octo/rotm-settings'; }
hinted() { has 'rotm settings sync on`? (after setup )?to load them'; }

