conf="$repo/tilde/.config/mise/conf.d"
PATH=$(tr ':' '\n' <<< "$real_path" | grep -v '/mise/shims$' | paste -sd: -)
if command -v mise > /dev/null; then
  export HOME="$tmp/scratch" MISE_CONFIG_DIR="$repo/tilde/.config/mise" DOTFILES="$repo"
  mkdir -p "$HOME"
  # The [dotfiles] sources are written ~/dotfiles/…, and a missing source fails the dry run
  ln -s "$repo" "$HOME/dotfiles"
  # From HOME: started in the clone, mise would add the repo's .nvmrc to the tools part
  cd "$HOME"
  # Matched without the `mise` prefix: on a CI runner mise colors that word
  out=$(mise bootstrap --dry-run --only files,user,task 2>&1) || fail "config does not load: $out"
  grep -q 'bootstrap: system files' <<< "$out" || fail "no files part: $out"
  grep -q 'bootstrap: login shell' <<< "$out" || fail "no user part: $out"
  grep -qF 'bootstrap: running `bootstrap` task' <<< "$out" || fail "no bootstrap task: $out"
  grep -qF '/setup/misc.sh' <<< "$out" || fail "task does not run setup/misc.sh: $out"
  ! grep -q 'unknown field' <<< "$out" || fail "mise warns about an unknown key: $out"
  mise bootstrap files status | grep '/etc/pam.d/sudo_local' | grep -q 'owner root group wheel' || fail "sudo_local not declared with its owner"
  mise bootstrap user status | grep -q '^/opt/homebrew/bin/zsh' || fail "login shell not declared"
  out=$(mise bootstrap --dry-run --skip macos-defaults,packages,tools,task 2>&1) || fail "the skip list setup.sh passes does not parse: $out"
  ! grep -qE 'pre-defaults|post-defaults|pre-packages|system defaults|system packages|pre-tools|bootstrap: tools|`bootstrap` task' <<< "$out" || fail "a skipped part or its hook still runs"
  out=$(mise bootstrap --dry-run --only task 2>&1) || fail "--only task does not parse: $out"
  grep -qF 'bootstrap: running `bootstrap` task' <<< "$out" || fail "--only task does not run the task"
  echo "ok: the tracked bootstrap config dry-runs"
else
  echo "test-bootstrap: mise not found, skipping the dry run of the bootstrap config" >&2
fi

cd "$repo"
# A second definition in a later fragment replaces the first without a word
[ "$(cat "$conf"/*.toml | grep -cxF '[tasks.bootstrap]')" = 1 ] || fail "conf.d must define [tasks.bootstrap] exactly once"
grep -qxF 'pre-tools = "sudo -k"' "$conf/50-bootstrap.toml" || fail "50-bootstrap.toml: no pre-tools hook that drops sudo"
grep -q '^pre-packages = ' "$conf/50-bootstrap.toml" || fail "50-bootstrap.toml: no pre-packages hook"
# mise runs post-dotfiles on every `mise dotfiles apply`, and the extras script may ask for sudo
! grep -q '^post-dotfiles' "$conf/50-bootstrap.toml" || fail "50-bootstrap.toml: setup/dotfiles-extras.sh must not be a hook"
[ -z "$(grep -nE '(^|[^a-z_])sudo ' setup/misc.sh | grep -v 'sudo -k')" ] || fail "setup/misc.sh calls sudo"
# test-conventions already fails on any brew call
for gone in link_config_dir 'mise install' DOTFILES_SUDO_KEPT; do
  ! grep -qF "$gone" setup/misc.sh || fail "setup/misc.sh still has: $gone"
done
grep -qE '^export [A-Z_]*TELEMETRY' setup.sh || fail "setup.sh exports no telemetry opt-out"
! grep -qE '^export [A-Z_]*TELEMETRY' setup/misc.sh || fail "setup/misc.sh exports telemetry opt-outs (they belong in setup.sh)"
echo "ok: static checks"
