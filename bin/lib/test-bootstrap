# setup/misc.sh under stubs. It puts the Homebrew prefix on PATH and names two kegs, so it must read HOMEBREW_PREFIX
! grep -q '/opt/homebrew' <(grep -v 'HOMEBREW_PREFIX:-/opt/homebrew' "$repo/setup/misc.sh" | grep -v '^ *#') \
  || fail "setup/misc.sh names /opt/homebrew without HOMEBREW_PREFIX; not running it"
mfix="$tmp/mfix"
mkdir -p "$mfix/setup" "$mfix/bin/lib"
cp "$repo/setup/misc.sh" "$mfix/setup/misc.sh"
cp "$repo/bin/lib/rotm-modules" "$mfix/bin/lib/rotm-modules"
logging='echo "$(basename "$0") $*" >> "$STATE/misc.log"'
for helper in install-iosevka-code claude-config claude-catalog hindsight-memory install-snippetslab-skill; do
  printf '#!/bin/bash\n%s\n' "$logging" > "$mfix/bin/$helper"
done
printf '#!/bin/bash\n%s\n' "$logging" > "$mfix/setup/menubar-open.sh"
chmod +x "$mfix"/bin/* "$mfix/setup/menubar-open.sh"
# Its own stub dir: a logging curl or jq on $tmp/bin would break the setup.sh cases
mstub() {
  printf '#!/bin/bash\n%s\n%s\n' "$logging" "${2:-}" > "$1"
  chmod +x "$1"
}
# fresh [no-claude]: a new HOME and log, and the stubs misc.sh finds on PATH
fresh() {
  rm -rf "${tmp:?}/home" "$STATE" "$tmp/mbin"
  mkdir -p "$HOME/.config/mise" "$HOME/.local/bin" "$STATE" "$tmp/mbin"
  : > "$STATE/misc.log"
  for tool in sudo curl uv uvx npx jq rtk; do mstub "$tmp/mbin/$tool"; done
  # No npm:typescript, so the link step warns when the apps module is on
  mstub "$tmp/mbin/mise" '[ "$1" != where ]'
  [ "${1:-}" = no-claude ] && return
  # misc.sh registers a server only when `mcp get` fails
  mstub "$tmp/mbin/claude" '[ "$1 $2" != "mcp get" ]'
  cp "$tmp/mbin/claude" "$HOME/.local/bin/claude"
}
misc() {
  rc=0
  out=$(cd "$HOME" && PATH="$tmp/mbin:/usr/bin:/bin" DOTFILES_YES=1 "$mfix/setup/misc.sh" 2>&1 < /dev/null) || rc=$?
}
ran() { grep -qF -- "$1" "$STATE/misc.log"; }

