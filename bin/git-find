#!/bin/bash
#
# Search git history for all commits that modified a specific file across all branches.
# > Shows the full history including deleted files by searching through all commits.
#
# - Search for a file anywhere in the repository:
#
# `git-find {{file}}`
#
# - Search for a file in a specific subdirectory:
#
# `git-find {{dir/file}}`
#
# ---
# License: MIT

set -euo pipefail

[ $# -eq 1 ] || {
  echo "usage: git-find <file>" >&2
  exit 64
}

# The glob magic lets **/ match zero directories, so top-level files match too
git log --all --full-history --name-only -- ":(glob)**/$1"
