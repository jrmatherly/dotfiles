#!/bin/bash
#
# Install, update and configure returnofthemac.
#
# - Run setup again, with any of `setup.sh`'s options:
#
# `rotm install {{-y}}`
#
# - Fetch the latest release into an installed copy, then run setup:
#
# `rotm update {{-y}}`
#
# - Say whether an update is waiting, installing nothing:
#
# `rotm update --check {{--json}}`
#
# - See and change the settings, as `dotfiles-settings` does:
#
# `rotm settings {{list}}`
#
# - Save your settings to a private GitHub repository, or load them onto a new Mac:
#
# `rotm settings sync {{on}}`
#
# - Keep named variants of your settings, and switch between them:
#
# `rotm settings profile new {{work}}`
# `rotm settings profile use {{work}}`
#
# - Print this help:
#
# `rotm help`
#
# ---
# `update` works only on an installed copy (mise's checkout, see
# bin/lib/rotm-mode): a development clone is pulled by hand, and `--check`
# reports it as one. It stops before
# setup when mise cannot fast-forward the copy, and lists the tracked files
# that differ in it.
#
# License: MIT

set -euo pipefail

DOTFILES="${DOTFILES:-$(cd "$(dirname "$0")/.." && pwd -P)}"

usage() {
  awk 'NR > 1 && /^#/ { sub(/^# ?/, ""); if ($0 == "---") exit; print; next } NR > 1 { exit }' "$0"
}

update() {
  local branch quoted url arg rc mode behind err yes="" check="" json=""
  for arg in "$@"; do
    case "$arg" in
      --) break ;;
      -y | --yes) yes=--yes ;;
      --check) check=1 ;;
      --json) json=1 ;;
    esac
  done
  if [ -n "$json" ] && [ -z "$check" ]; then
    echo "rotm: --json goes with --check" >&2
    exit 2
  fi
  mode=$("$(dirname "$0")/lib/rotm-mode" "$DOTFILES")
  branch=$(git -C "$DOTFILES" symbolic-ref -q --short HEAD 2> /dev/null) || branch=""
  # git allows a double quote in a branch name, and no backslash
  quoted=${branch//\"/\\\"}
  if [ "$mode" = clone ]; then
    if [ -z "$check" ]; then
      echo "rotm: this is a development clone. Pull it yourself, then run ./setup.sh" >&2
      exit 1
    elif [ -n "$json" ]; then
      [ -n "$branch" ] && branch="\"$quoted\"" || branch=null
      echo "{\"mode\":\"clone\",\"branch\":$branch,\"behind\":null}"
    else
      echo "This is a development clone. Pull it yourself."
    fi
    exit 0
  fi
  if [ -z "$branch" ]; then
    echo "rotm: the installed copy is not on a branch (git -C $DOTFILES status shows where it is)" >&2
    exit 1
  fi
  if [ -n "$check" ]; then
    # FETCH_HEAD needs no refspec: how mise sets up the copy's remote is not known
    if ! err=$(git -C "$DOTFILES" fetch --quiet origin "$branch" 2>&1); then
      echo "rotm: could not fetch $branch from origin: ${err%%$'\n'*}" >&2
      exit 1
    fi
    behind=$(git -C "$DOTFILES" rev-list --count HEAD..FETCH_HEAD)
    if [ -n "$json" ]; then
      echo "{\"mode\":\"installed\",\"branch\":\"$quoted\",\"behind\":$behind}"
    elif [ "$behind" = 0 ]; then
      echo "Up to date."
    elif [ "$behind" = 1 ]; then
      echo "1 update is waiting. Run rotm update."
    else
      echo "$behind updates are waiting. Run rotm update."
    fi
    exit 0
  fi
  # mise refuses a URL that differs from the checkout's origin, so it is read
  url=$(git -C "$DOTFILES" remote get-url origin)
  cd "$HOME"
  # --only final-hook: fetch and link, apply nothing (probes 11 and 13). setup.sh does the installing.
  mise bootstrap --from "$url?ref=$branch" --config-dir tilde/.config/mise --update --only final-hook ${yes:+"$yes"} || {
    rc=$?
    {
      echo "rotm: mise refused or failed to update the installed copy. Tracked files that differ in it:"
      git -C "$DOTFILES" status --short --untracked-files=no
      echo "Nothing was installed."
    } >&2
    exit "$rc"
  }
  # The update may have replaced this file: bash keeps reading the one it opened
  exec "$DOTFILES/setup.sh" "$@"
}

case "${1:-help}" in
  install)
    shift
    exec "$DOTFILES/setup.sh" "$@"
    ;;
  update)
    shift
    update "$@"
    ;;
  settings)
    shift
    exec "$DOTFILES/bin/dotfiles-settings" "$@"
    ;;
  help | -h | --help) usage ;;
  *)
    echo "rotm: unknown command: $1" >&2
    exit 2
    ;;
esac
