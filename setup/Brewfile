# Taps
#
# Homebrew requires explicit trust before loading anything from a third-party
# tap (https://docs.brew.sh/Tap-Trust). Rather than trusting whole taps — which
# covers everything they publish in future too — each package below that comes
# from a tap is fully qualified and marked `trusted: true` individually.

# Dotfiles framework
tap "modem-dev/tap" # hunk (git pager)

# Cloud / infra
tap "azure/azd"
# Homebrew also *loads* (never installs) a versioned formula's unversioned
# sibling while linking it, so `azure-functions-core-tools` (v2.7) must be
# trusted too for `azure-functions-core-tools@4` to install.
tap "azure/functions", trusted: { formulae: ["azure-functions-core-tools"] } # azure-functions-core-tools@4
tap "azure/kubelogin"
tap "getsentry/tools" # sentry (cli.sentry.dev)
tap "kubestellar/tap" # kubestellar-deploy / kubestellar-ops
tap "microsoft/aspire"
tap "microsoft/foundry"
tap "siderolabs/tap"
tap "skyhook-io/tap" # radar (Kubernetes visibility)

# Fonts
tap "bramstein/webfonttools"

# Dotfiles framework requirements
#
# These tools are wired directly into the zsh/git config in this repo
# (see zsh/init.zsh, zsh/fzf.zsh, zsh/aliases.zsh, zsh/path.zsh, tilde/.gitconfig).
# Removing them will break prompt rendering, fzf previews, git signing, etc.
brew "ack" # Better grep for source code (tilde/.ackrc)
brew "bat" # Output highlighting (better `cat`), used in fzf previews
brew "btop" # Performance monitor (better `top`), config tracked in tilde/.config/btop
brew "eza" # Listing files with info (better `ls`), used in fzf previews
brew "fastfetch" # System info, config tracked in tilde/.config/fastfetch
brew "fd" # Find entries in your filesystem (better `find`), used by fzf
brew "fzf" # Fuzzy file finder, core to zsh/fzf.zsh
brew "gh" # GitHub CLI, config tracked in tilde/.config/gh
brew "git" # Version control
brew "gnupg" # Optional: only needed if you sign commits with GPG instead of SSH
brew "modem-dev/tap/hunk", trusted: true # Git pager used by tilde/.gitconfig, lazygit and gh
brew "lazygit" # Full Git management app (zsh `lg` alias)
brew "mise" # Polyglot runtime version manager — required: setup/misc.sh installs runtimes with it, tilde/.zprofile and zsh/init.zsh activate it
brew "pinentry-mac" # Securely enter your GPG passphrase (only needed with GPG signing)
brew "ripgrep" # Searching within files (better `grep`), tilde/.ripgreprc
brew "starship" # Prompt manager, tilde/.starship.toml
brew "tlrc" # Community-maintained docs (better `man`), tilde/.tlrc.toml
brew "trash-cli", link: true # Record and restore removed files (better `rm`)
brew "zoxide" # Convenient and magical navigation (better `cd`)
brew "zsh" # A shell of choice
brew "zsh-autosuggestions" # Fish-like autosuggestions for Zsh
brew "zsh-fast-syntax-highlighting" # Feature-rich syntax highlighting for Zsh
brew "jesseduffield/lazydocker/lazydocker", trusted: true # Full Docker management app (zsh `ld` alias)
cask "cmux" # Terminal for AI agents, config tracked in tilde/.config/cmux
cask "codex" # OpenAI Codex CLI, config tracked in tilde/.codex
cask "coteditor" # `cot` CLI required: tilde/.gitconfig core.editor, zsh/env.zsh $EDITOR
cask "ghostty" # Config tracked in tilde/.config/ghostty
cask "visual-studio-code" # Main code editor; vscode/User settings symlinked to it

# Cloud / Azure / AWS
brew "aws-cdk" # AWS Cloud Development Kit
brew "awscli" # Official Amazon AWS command-line interface
brew "azure-cli" # Azure CLI (`az`) — also a dependency of the devpack cask
brew "azure/azd/azd", trusted: true # Azure Developer CLI
brew "azure/kubelogin/kubelogin", trusted: true # Azure AD login for kubectl
brew "azure/functions/azure-functions-core-tools@4", trusted: true # Azure Functions Core Tools
brew "azurite" # Local Azure Storage emulator
cask "microsoft/aspire/aspire", trusted: true # .NET Aspire tooling
# Microsoft's official SDK build at /usr/local/share/dotnet — what workloads,
# Aspire and VS tooling expect. Do NOT also install the `dotnet` formula: both
# claim /opt/homebrew/bin/dotnet (Homebrew/homebrew-core#275368).
cask "dotnet-sdk" # .NET SDK
cask "microsoft/foundry/devpack", trusted: true # Microsoft dev pack

