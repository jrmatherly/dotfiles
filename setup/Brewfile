# Sentry's new CLI (`sentry`, log in with `sentry auth`), not the legacy
# `sentry-cli` that build tooling pulls in per project. Telemetry is off via
# DO_NOT_TRACK in zsh/env.zsh.
brew "getsentry/tools/sentry", trusted: true # Sentry CLI: issues, events, root cause
brew "uv" # Fast Python package/project manager

