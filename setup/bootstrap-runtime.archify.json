  "cards": [
    {
      "dot": "emerald",
      "title": "Primary path",
      "items": [
        "./setup.sh runs brew.sh → zsh.sh → misc.sh → symlinks.sh in order",
        "--skip-brew skips step 1; --dash adds dash.sh",
        "Idempotent: re-running is how changes are applied",
        "From a terminal, each run is recorded to private/setup-logs/ for /validate-setup"
      ]
    },
    {
      "dot": "rose",
      "title": "Trust boundaries",
      "items": [
        "setup.sh and zsh.sh write root-owned files (pam sudo_local, /etc/shells)",
        "Everything else runs as you; symlink_file never overwrites silently",
        "Third-party code arrives via curl | bash (Homebrew, Claude Code) and package registries",
        "misc.sh trusts the Aspire HTTPS dev cert in your login keychain (macOS may ask)"
      ]
    },
    {
      "dot": "amber",
      "title": "Supply-chain guards",
      "items": [
        "npm min-release-age 7 and allow-git none",
        "Iosevka font: ETag check, SHA-256 notice",
        "Telemetry opt-outs in setup.sh and zsh/env.zsh"
      ]
    },
    {
      "dot": "cyan",
      "title": "Maintenance loop: upup",
      "items": [
        "softwareupdate (password via 1Password op read, optional)",
        "brew upgrade --greedy, mise upgrade, uv tool upgrade",
        "claude-config save, then claude-catalog rebuild"
      ]
    },
    {
      "dot": "slate",
      "title": "Never tracked",
      "items": [
        "~/.zsh.local, ~/.gitconfig.local, ~/.ssh/config.local",
        "~/.claude/CLAUDE.md (codegraph rewrites it)",
        "Per-machine .codegraph/ index"
      ]
    }
  ]
